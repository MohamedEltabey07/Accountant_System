@model List<BLL.DTOs.Customer.OutGoingData.CustomerDto>
@{
    ViewData["Title"] = "العملاء";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4><i class="bi bi-people-fill me-2"></i> العملاء</h4>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-lg me-1"></i> عميل جديد
    </a>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        @if (Model.Count == 0)
        {
            <div class="text-center text-muted py-4">
                <i class="bi bi-inbox fs-2 d-block mb-2"></i>
                لا يوجد عملاء بعد. أضف أول عميل للبدء.
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle text-center">
                    <thead class="table-light">
                        <tr>
                            <th>#</th>
                            <th>الاسم</th>
                            <th>رقم الهاتف</th>
                            <th>العنوان</th>
                            <th>الرصيد الحالي</th>
                            <th>إجراءات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var customer in Model)
                        {
                            <tr>
                                <td>@customer.Id</td>
                                <td class="fw-bold">@customer.Name</td>
                                <td>@(string.IsNullOrEmpty(customer.PhoneNumber) ? "-" : customer.PhoneNumber)</td>
                                <td>@(string.IsNullOrEmpty(customer.Address) ? "-" : customer.Address)</td>
                                <td class="@(customer.CurrentBalance > 0 ? "text-danger fw-bold" : "text-success")">
                                    @customer.CurrentBalance.ToString("N2")
                                </td>
                                <td>
                                    <div class="btn-group btn-group-sm">
                                        <a asp-action="Details" asp-route-id="@customer.Id" class="btn btn-outline-info" title="تفاصيل">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@customer.Id" class="btn btn-outline-warning" title="تعديل">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <form asp-action="ToggleStatus" asp-route-id="@customer.Id" method="post" class="d-inline">
                                            <button type="submit" class="btn btn-outline-secondary" title="تمييز/إلغاء التنشيط">
                                                <i class="bi bi-arrow-repeat"></i>
                                            </button>
                                        </form>
                                        <form asp-action="Delete" asp-route-id="@customer.Id" method="post" class="d-inline"
                                              onsubmit="return confirm('هل تريد إلغاء تنشيط هذا العميل؟');">
                                            <button type="submit" class="btn btn-outline-danger" title="إلغاء التنشيط">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
