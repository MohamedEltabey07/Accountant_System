@model List<BLL.DTOs.Customer.OutGoingData.CustomerDto>
@{
    ViewData["Title"] = "سجل العملاء";
    var currentStatus = ViewBag.Status as string ?? "active";
}

<!-- Page Header -->
<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
    <div>
        <h3 class="fw-bold mb-1">
            <i class="bi bi-people-fill text-primary me-2"></i> سجل العملاء والمديونيات
        </h3>
        <p class="text-muted mb-0">متابعة أرصدة العملاء، مبيعات الجملة الآجلة، وتاريخ السداد</p>
    </div>
    <div class="d-flex gap-2">
        <button type="button" class="btn btn-outline-success shadow-sm" onclick="exportTableToCSV('customerTable', 'سجل_العملاء')">
            <i class="bi bi-file-earmark-excel me-1"></i> تصدير Excel
        </button>
        <a asp-action="Create" class="btn btn-primary shadow-sm fw-bold">
            <i class="bi bi-person-plus-fill me-1"></i> عميل جديد
        </a>
    </div>
</div>

<!-- Search & Live Counter Toolbar -->
<div class="card shadow-sm border-0 mb-3">
    <div class="card-body p-3">
        <div class="row align-items-center g-2">
            <div class="col-md-5">
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                    <input type="text" class="form-control border-start-0" placeholder="بحث فوري بالاسم، رقم الهاتف، أو الكود..." data-table-search="customerTable" data-counter-target="customerCounter" />
                </div>
            </div>
            <div class="col-md-7 d-flex flex-wrap align-items-md-start gap-3">
                <!-- Active Status Filter (backend-filtered via ?status=) -->
                <div class="btn-group btn-group-sm" role="group" aria-label="فلتر حالة العميل">
                    <a asp-action="Index" asp-route-status="active" class="btn @(currentStatus == "active" ? "btn-primary" : "btn-outline-primary")">نشط</a>
                    <a asp-action="Index" asp-route-status="inactive" class="btn @(currentStatus == "inactive" ? "btn-secondary" : "btn-outline-secondary")">غير نشط</a>
                    <a asp-action="Index" asp-route-status="all" class="btn @(currentStatus == "all" ? "btn-dark" : "btn-outline-dark")">الكل</a>
                </div>
                <span class="badge bg-light text-dark border p-2 font-tabular" id="customerCounter">
                    عرض @Model.Count من إجمالي @Model.Count عميل
                </span>
            </div>
        </div>
    </div>
</div>

<!-- Customers Table Card -->
<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        @if (Model.Count == 0)
        {
            <div class="text-center text-muted py-5">
                <i class="bi bi-person-x fs-1 d-block mb-3 text-secondary"></i>
                <h5 class="fw-bold text-dark">لا يوجد عملاء مسجلين بعد</h5>
                <p class="text-muted small">ابدأ بتسجيل أول عميل لربط المبيعات وسندات القبض بحسابه.</p>
                <a asp-action="Create" class="btn btn-primary btn-sm mt-2">
                    <i class="bi bi-plus-lg me-1"></i> إضافة عميل جديد
                </a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-modern align-middle text-center mb-0" id="customerTable">
                    <thead>
                        <tr>
                            <th style="width: 50px;">#</th>
                            <th class="text-start">اسم العميل</th>
                            <th>رقم الهاتف</th>
                            <th>العنوان</th>
                            <th>الرصيد المالي الحالي</th>
                            <th>الحالة</th>
                            <th class="no-export">الإجراءات والعمليات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var customer in Model)
                        {
                            <tr>
                                <td class="text-muted fw-bold font-tabular">@customer.Id</td>
                                <td class="text-start">
                                    <div class="fw-bold text-dark fs-6">@customer.Name</div>
                                    <small class="text-muted">كود: #CST-@customer.Id.ToString("D4")</small>
                                </td>
                                <td class="font-tabular">
                                    @(string.IsNullOrEmpty(customer.PhoneNumber) ? "-" : customer.PhoneNumber)
                                </td>
                                <td>
                                    @(string.IsNullOrEmpty(customer.Address) ? "-" : customer.Address)
                                </td>
                                <td class="font-tabular">
                                    @if (customer.CurrentBalance > 0)
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1 fs-6">
                                            @customer.CurrentBalance.ToString("N2") ج.م — مستحق على العميل (لنا عليه)
                                        </span>
                                    }
                                    else if (customer.CurrentBalance < 0)
                                    {
                                        <span class="badge bg-info-subtle text-info border border-info-subtle px-2 py-1 fs-6">
                                            @Math.Abs(customer.CurrentBalance).ToString("N2") ج.م — رصيد للعميل (له عندنا)
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">
                                            0.00 ج.م (الحساب خالص)
                                        </span>
                                    }
                                </td>
                                <td>
                                    @if (customer.IsActive)
                                    {
                                        <span class="badge bg-success">نشط</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">غير نشط</span>
                                    }
                                </td>
                                <td class="no-export">
                                    <div class="btn-group btn-group-sm">
                                        <!-- Statement Shortcut -->
                                        <a asp-action="Statement" asp-route-id="@customer.Id" class="btn btn-outline-primary" title="كشف الحساب الرسمي">
                                            <i class="bi bi-file-earmark-text"></i> كشف الحساب
                                        </a>

                                        @if (customer.CurrentBalance > 0)
                                        {
                                            <!-- Quick Payment Shortcut -->
                                            <a asp-controller="Payment" asp-action="CustomerPayment" asp-route-customerId="@customer.Id" class="btn btn-outline-success" title="تسجيل سند قبض">
                                                <i class="bi bi-cash-stack"></i>
                                            </a>
                                        }

                                        <!-- Edit -->
                                        <a asp-action="Edit" asp-route-id="@customer.Id" class="btn btn-outline-warning" title="تعديل">
                                            <i class="bi bi-pencil"></i>
                                        </a>

                                        <!-- Details -->
                                        <a asp-action="Details" asp-route-id="@customer.Id" class="btn btn-outline-info" title="تفاصيل الملف">
                                            <i class="bi bi-eye"></i>
                                        </a>

                                        <!-- Toggle Status -->
                                        <form asp-action="ToggleStatus" asp-route-id="@customer.Id" method="post" class="d-inline">
                                            <button type="submit" class="btn btn-outline-secondary" title="تغيير الحالة النشطة">
                                                <i class="bi bi-arrow-repeat"></i>
                                            </button>
                                        </form>

                                        <!-- Deactivate / Delete with SweetAlert2 -->
                                        <form asp-action="Delete" asp-route-id="@customer.Id" method="post" class="d-inline">
                                            <button type="button" class="btn btn-outline-danger" title="إلغاء التنشيط" data-confirm="هل أنت متأكد من إلغاء تنشيط العميل (@customer.Name)؟">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
