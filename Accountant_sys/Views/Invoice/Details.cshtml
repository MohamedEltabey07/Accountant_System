@model BLL.DTOs.Invoice.OutGoingData.InvoiceDto
@using DAL.Enums
@{
    ViewData["Title"] = (Model.Status == InvoiceStatus.Draft ? "مسودة فاتورة" : "فاتورة رقم " + Model.InvoiceNumber);
    var isDraft = Model.Status == InvoiceStatus.Draft;
    var isPosted = Model.Status == InvoiceStatus.Posted;
    var isCancelled = Model.Status == InvoiceStatus.Cancelled;
}

<style>
    @@media print {
        .no-print { display: none !important; }
        .card { border: none !important; box-shadow: none !important; }
        .main-content { margin: 0 !important; padding: 0 !important; }
        body { background: #fff !important; }
        .invoice-print-header { display: block !important; }
    }
    .invoice-print-header { display: none; }
</style>

<!-- Top Actions Bar (Hidden on Print) -->
<div class="d-flex justify-content-between align-items-center mb-3 no-print">
    <div class="d-flex align-items-center gap-2">
        <h4>
            <i class="bi bi-receipt me-1"></i>
            @(isDraft ? "مسودة فاتورة #" + Model.Id : "فاتورة: " + Model.InvoiceNumber)
        </h4>
        @if (isDraft)
        {
            <span class="badge bg-warning text-dark fs-6">مسودة قيد التعديل</span>
        }
        else if (isPosted)
        {
            <span class="badge bg-success fs-6">مرحّلة ومعتمدة</span>
        }
        else if (isCancelled)
        {
            <span class="badge bg-danger fs-6">ملغاة</span>
        }
    </div>
    <div class="d-flex gap-2">
        @if (isPosted)
        {
            <button onclick="window.print()" class="btn btn-outline-dark">
                <i class="bi bi-printer me-1"></i> طباعة الفاتورة
            </button>
            @if (Model.PaidAmount == 0)
            {
                <a asp-action="Cancel" asp-route-id="@Model.Id" class="btn btn-outline-danger">
                    <i class="bi bi-x-circle me-1"></i> إلغاء الفاتورة
                </a>
            }
        }
        else if (isDraft)
        {
            <form asp-action="Post" asp-route-id="@Model.Id" method="post" class="d-inline"
                  onsubmit="return confirm('هل أنت متأكد من ترحيل هذه الفاتورة؟ سيتم تجميد الأسعار والكميات وتحديث الأرصدة المالية.');">
                <button type="submit" class="btn btn-success" @(Model.Items.Count == 0 ? "disabled" : "")>
                    <i class="bi bi-check-all me-1"></i> ترحيل واعتماد الفاتورة
                </button>
            </form>
        }
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-right me-1"></i> رجوع للسجل
        </a>
    </div>
</div>

<!-- Draft Notice Banner -->
@if (isDraft)
{
    <div class="alert alert-warning d-flex align-items-center gap-2 shadow-sm no-print mb-3" role="alert">
        <i class="bi bi-info-circle-fill fs-4 text-warning"></i>
        <div>
            <strong>تنبيه مسودة:</strong> هذه الفاتورة لم تُرحل بعد. يمكنك إضافة البنود أو تعديلها أو حذفها بحرية. لن تظهر في الأرصدة المالية أو حسابات العملاء/الموردين إلا بعد الضغط على <strong>ترحيل واعتماد الفاتورة</strong>.
            @if (Model.Items.Count == 0)
            {
                <span class="text-danger fw-bold d-block mt-1">يجب إضافة بند واحد على الأقل قبل التمكن من الترحيل.</span>
            }
        </div>
    </div>
}
else if (isCancelled)
{
    <div class="alert alert-danger d-flex align-items-center gap-2 shadow-sm mb-3" role="alert">
        <i class="bi bi-x-octagon-fill fs-4 text-danger"></i>
        <div>
            <strong>تم إلغاء هذه الفاتورة:</strong>
            بتاريخ @(Model.CancelledAt?.ToString("yyyy/MM/dd hh:mm tt") ?? "-")
            <div class="mt-1">سبب الإلغاء: <em>@(Model.CancellationReason ?? "غير محدد")</em></div>
        </div>
    </div>
}

<!-- Printable Header for Invoices -->
<div class="invoice-print-header text-center mb-4 pb-3 border-bottom">
    <h2 class="fw-bold mb-1">مؤسسة التجارة الحديثة</h2>
    <p class="text-muted mb-1">نظام إدارة المحاسبة والمبيعات</p>
    <h4 class="fw-bold mt-2">
        @switch (Model.Type)
        {
            case InvoiceType.VendorPurchase:
                <span>فاتورة مشتريات مورد</span>
                break;
            case InvoiceType.WholesaleSales:
                <span>فاتورة مبيعات جملة</span>
                break;
            case InvoiceType.StoreCashSales:
                <span>فاتورة مبيعات تجزئة نقدي</span>
                break;
        }
    </h4>
    <div class="font-monospace fs-5">@Model.InvoiceNumber</div>
</div>

<!-- Invoice Information Card -->
<div class="card shadow-sm mb-4">
    <div class="card-header bg-white py-3">
        <div class="row align-items-center">
            <div class="col-sm-6">
                <h5 class="card-title mb-0 text-primary">
                    <i class="bi bi-file-text me-1"></i> بيانات الفاتورة
                </h5>
            </div>
            <div class="col-sm-6 text-sm-start mt-2 mt-sm-0">
                <span class="text-muted small">تاريخ التحرير:</span>
                <span class="fw-bold">@Model.TransactionDate.ToString("yyyy/MM/dd")</span>
            </div>
        </div>
    </div>
    <div class="card-body">
        <div class="row g-3">
            <div class="col-md-3">
                <div class="text-muted small">نوع الفاتورة</div>
                <div class="fw-semibold">
                    @switch (Model.Type)
                    {
                        case InvoiceType.VendorPurchase:
                            <span class="badge bg-secondary-subtle text-secondary border">مشتريات من مورد</span>
                            break;
                        case InvoiceType.WholesaleSales:
                            <span class="badge bg-primary-subtle text-primary border">مبيعات جملة</span>
                            break;
                        case InvoiceType.StoreCashSales:
                            <span class="badge bg-info-subtle text-info border">مبيعات تجزئة نقدي</span>
                            break;
                    }
                </div>
            </div>

            <div class="col-md-3">
                <div class="text-muted small">الطرف المعني</div>
                <div class="fw-bold fs-6">
                    @if (Model.Type == InvoiceType.VendorPurchase)
                    {
                        <a asp-controller="Vendor" asp-action="Details" asp-route-id="@Model.VendorId" class="text-decoration-none">
                            <i class="bi bi-truck me-1"></i> @(Model.VendorName ?? "-")
                        </a>
                    }
                    else if (Model.Type == InvoiceType.WholesaleSales)
                    {
                        <a asp-controller="Customer" asp-action="Details" asp-route-id="@Model.CustomerId" class="text-decoration-none">
                            <i class="bi bi-person me-1"></i> @(Model.CustomerName ?? "-")
                        </a>
                    }
                    else
                    {
                        <span class="text-muted"><i class="bi bi-cash me-1"></i> عميل نقدي (فوري)</span>
                    }
                </div>
            </div>

            <div class="col-md-3">
                <div class="text-muted small">حالة السداد</div>
                <div>
                    @switch (Model.PaymentStatus)
                    {
                        case InvoicePaymentStatus.Paid:
                            <span class="badge bg-success">مسددة بالكامل</span>
                            break;
                        case InvoicePaymentStatus.PartiallyPaid:
                            <span class="badge bg-warning text-dark">مسددة جزئياً</span>
                            break;
                        case InvoicePaymentStatus.Unpaid:
                            <span class="badge bg-danger">غير مسددة</span>
                            break;
                    }
                </div>
            </div>

            <div class="col-md-3">
                <div class="text-muted small">تاريخ الترحيل / الإنشاء</div>
                <div class="small">
                    @(Model.PostedAt.HasValue ? Model.PostedAt.Value.ToString("yyyy/MM/dd hh:mm tt") : Model.CreatedAt.ToString("yyyy/MM/dd hh:mm tt"))
                </div>
            </div>

            @if (!string.IsNullOrEmpty(Model.Notes))
            {
                <div class="col-12 mt-2 pt-2 border-top">
                    <span class="text-muted small fw-bold">ملاحظات:</span>
                    <span class="small">@Model.Notes</span>
                </div>
            }
        </div>
    </div>
</div>

<!-- Add Item Section (Only in Draft Mode) -->
@if (isDraft)
{
    <div class="card shadow-sm mb-4 border-primary no-print">
        <div class="card-header bg-primary text-white py-2">
            <h6 class="card-title mb-0">
                <i class="bi bi-plus-circle me-1"></i> إضافة بند جديد للمسودة
            </h6>
        </div>
        <div class="card-body">
            <form asp-action="AddItem" method="post" class="row g-2 align-items-end">
                <input type="hidden" name="InvoiceId" value="@Model.Id" />

                <div class="col-md-4">
                    <label class="form-label small fw-bold">المنتج <span class="text-danger">*</span></label>
                    <select name="ProductId" class="form-select form-select-sm" asp-items="ViewBag.Products" required>
                        <option value="">-- اختر المنتج من المخزن --</option>
                    </select>
                </div>

                <div class="col-md-2">
                    <label class="form-label small fw-bold">الكمية <span class="text-danger">*</span></label>
                    <input type="number" step="0.001" min="0.001" name="Quantity" class="form-control form-control-sm" value="1" required />
                </div>

                <div class="col-md-3">
                    <label class="form-label small fw-bold">سعر الوحدة (ج.م) <small class="text-muted fw-normal">(اختياري)</small></label>
                    <input type="number" step="0.01" min="0" name="UnitPrice" class="form-control form-control-sm" placeholder="اتركه فارغاً لاستخدام سعر الصنف" />
                </div>

                <div class="col-md-2">
                    <label class="form-label small fw-bold">خصم البند (ج.م)</label>
                    <input type="number" step="0.01" min="0" name="LineDiscountAmount" class="form-control form-control-sm" value="0.00" />
                </div>

                <div class="col-md-1">
                    <button type="submit" class="btn btn-primary btn-sm w-100">
                        <i class="bi bi-plus-lg"></i> إضافة
                    </button>
                </div>
            </form>
        </div>
    </div>
}

<!-- Invoice Items Table -->
<div class="card shadow-sm mb-4">
    <div class="card-header bg-white py-3">
        <h5 class="card-title mb-0">
            <i class="bi bi-list-check me-1"></i> بنود الفاتورة (@Model.Items.Count بند)
        </h5>
    </div>
    <div class="card-body p-0">
        @if (Model.Items.Count == 0)
        {
            <div class="text-center text-muted py-5">
                <i class="bi bi-cart-x fs-1 d-block mb-2"></i>
                <p class="fs-5 mb-1">لا توجد بنود في الفاتورة بعد.</p>
                <small>استخدم النموذج أعلاه لإضافة المنتجات إلى هذه المسودة.</small>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover table-striped align-middle text-center mb-0">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 50px;">#</th>
                            <th class="text-start">اسم الصنف / المنتج</th>
                            <th>الكمية</th>
                            <th>سعر الوحدة</th>
                            <th>خصم البند</th>
                            <th>إجمالي البند</th>
                            @if (isDraft)
                            {
                                <th class="no-print" style="width: 80px;">إجراء</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @{ int itemIndex = 1; }
                        @foreach (var item in Model.Items)
                        {
                            <tr>
                                <td>@(itemIndex++)</td>
                                <td class="text-start fw-bold">@item.ProductName</td>
                                <td>@item.Quantity.ToString("G29")</td>
                                <td>@item.UnitPrice.ToString("N2")</td>
                                <td>
                                    @if (item.LineDiscountAmount > 0)
                                    {
                                        <span class="text-danger">-@item.LineDiscountAmount.ToString("N2")</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">0.00</span>
                                    }
                                </td>
                                <td class="fw-bold">@item.LineTotal.ToString("N2") ج.م</td>
                                @if (isDraft)
                                {
                                    <td class="no-print">
                                        <form asp-action="RemoveItem" method="post" class="d-inline"
                                              onsubmit="return confirm('هل تريد حذف هذا البند من المسودة؟');">
                                            <input type="hidden" name="itemId" value="@item.Id" />
                                            <input type="hidden" name="invoiceId" value="@Model.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger" title="حذف البند">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<!-- Financial Summary Section -->
<div class="row justify-content-end">
    <div class="col-lg-5 col-md-7">
        <div class="card shadow-sm border-0 bg-light">
            <div class="card-body p-4">
                <h5 class="fw-bold mb-3 border-bottom pb-2">الملخص المالي للفاتورة</h5>

                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted">المجموع قبل الخصم (SubTotal):</span>
                    <span class="fw-bold">@Model.SubTotal.ToString("N2") ج.م</span>
                </div>

                @if (Model.ItemDiscountTotal > 0)
                {
                    <div class="d-flex justify-content-between mb-2 text-danger">
                        <span>إجمالي خصومات البنود:</span>
                        <span>-@Model.ItemDiscountTotal.ToString("N2") ج.م</span>
                    </div>
                }

                @if (Model.InvoiceDiscountAmount > 0)
                {
                    <div class="d-flex justify-content-between mb-2 text-danger">
                        <span>خصم إضافي على الفاتورة:</span>
                        <span>-@Model.InvoiceDiscountAmount.ToString("N2") ج.م</span>
                    </div>
                }

                <div class="d-flex justify-content-between my-3 pt-2 border-top border-dark border-2 fs-5 fw-bold">
                    <span>صافي الفاتورة الإجمالي:</span>
                    <span class="text-primary">@Model.TotalAmount.ToString("N2") ج.م</span>
                </div>

                @if (isPosted)
                {
                    <div class="d-flex justify-content-between mb-2 text-success">
                        <span>المدفوع حتى الآن:</span>
                        <span class="fw-bold">@Model.PaidAmount.ToString("N2") ج.م</span>
                    </div>

                    <div class="d-flex justify-content-between pt-2 border-top fs-5 fw-bold @(Model.RemainingBalance > 0 ? "text-danger" : "text-success")">
                        <span>المتبقي غير المسدد:</span>
                        <span>@Model.RemainingBalance.ToString("N2") ج.م</span>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
