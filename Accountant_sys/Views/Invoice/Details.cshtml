@model BLL.DTOs.Invoice.OutGoingData.InvoiceDto
@using DAL.Enums
@using BLL.DTOs.CreditNote.OutGoingData
@using BLL.DTOs.Product.OutGoingData
@using BLL.DTOs.Inventory.OutGoingData
@{
    var isDraft = Model.Status == InvoiceStatus.Draft;
    var isPosted = Model.Status == InvoiceStatus.Posted;
    var isCancelled = Model.Status == InvoiceStatus.Cancelled;
    var isMaritime = Model.Type == InvoiceType.MaritimeSupply;
    
    ViewData["Title"] = isDraft ? "مسودة فاتورة / عرض أسعار #" + Model.Id : "فاتورة: " + Model.InvoiceNumber;
    
    var returnedQuantities = ViewBag.ReturnedQuantities as Dictionary<int, decimal> ?? new Dictionary<int, decimal>();
    var creditNotes = ViewBag.CreditNotes as List<CreditNoteDto> ?? new List<CreditNoteDto>();
    var totalReturnedAmount = (decimal)(ViewBag.TotalReturnedAmount ?? 0m);

    // Maritime supply: every ACTIVE catalog product is selectable; each row's
    // supply source (freezer or not) is decided per item. Freezer balances are
    // used for the live availability hints on draft orders.
    var productOptions = isMaritime
        ? (ViewBag.ProductOptions as List<ProductDto> ?? new List<ProductDto>())
        : new List<ProductDto>();
    var freezerBalances = ViewBag.FreezerBalances as Dictionary<int, StockBalanceDto> ?? new Dictionary<int, StockBalanceDto>();
}

@using BLL.Service

<style>
    /* ==========================================================================
       Print & Screen Stylesheet (A4 Standard & 80mm Thermal Receipt Engine)
       ========================================================================== */
    @@page {
        size: A4 portrait;
        margin: 0 !important; /* Removes browser default headers (title/date) and footers (URL link) */
    }

    .invoice-container {
        max-width: 920px;
        margin: 0 auto;
        background: #ffffff;
        border-radius: 16px;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.06);
        border: 1px solid #e2e8f0;
        overflow: hidden;
    }

    .table-invoice {
        width: 100%;
        border-collapse: collapse;
    }

    .table-invoice th {
        background-color: #0f172a;
        color: #ffffff;
        font-weight: 700;
        font-size: 0.85rem;
        padding: 0.75rem 0.6rem;
        border: 1px solid #0f172a;
        text-align: center;
    }

    .table-invoice td {
        padding: 0.65rem 0.6rem;
        border: 1px solid #cbd5e1;
        font-size: 0.9rem;
        vertical-align: middle;
    }

    .watermark-badge {
        font-size: 0.85rem;
        font-weight: 700;
        letter-spacing: 0.03em;
        border-radius: 6px;
        padding: 0.35rem 0.85rem;
        display: inline-block;
    }

    .totals-box {
        background-color: #f8fafc;
        border: 1px solid #cbd5e1;
        border-radius: 10px;
        padding: 1.25rem;
    }

    .unpaid-highlight-box {
        background: #fff1f2;
        border: 2px solid #f43f5e;
        border-radius: 8px;
        padding: 0.75rem 1rem;
    }

    .paid-highlight-box {
        background: #f0fdf4;
        border: 2px solid #10b981;
        border-radius: 8px;
        padding: 0.75rem 1rem;
    }

    .draft-banner-print {
        display: none;
    }

    /* 80mm Thermal Receipt Layout (Hidden by default on screen and regular print) */
    .thermal-receipt-container {
        display: none;
    }

    /* Print Mode Reset (A4 Default) */
    @@media print {
        html, body {
            background: #ffffff !important;
            color: #000000 !important;
            margin: 0 !important;
            padding: 0 !important;
            font-size: 12px !important;
            -webkit-print-color-adjust: exact !important;
            print-color-adjust: exact !important;
        }

        .d-print-none,
        .sidebar,
        .top-navbar,
        .btn,
        .alert,
        header {
            display: none !important;
        }

        .main-content,
        .content-area {
            margin: 0 !important;
            padding: 0 !important;
            background: #fff !important;
        }

        .invoice-container {
            max-width: 100% !important;
            width: 100% !important;
            box-shadow: none !important;
            border: none !important;
            border-radius: 0 !important;
            padding: 8mm 10mm !important;
            margin: 0 !important;
        }

        /* Prevent awkward page cuts */
        .invoice-print-header,
        .invoice-party-card,
        .invoice-table-wrapper,
        .invoice-summary-box,
        .invoice-signature-block,
        tr {
            page-break-inside: avoid !important;
            break-inside: avoid !important;
        }

        .table-invoice th {
            background-color: #0f172a !important;
            color: #ffffff !important;
        }

        .draft-banner-print {
            display: block !important;
            border: 2px dashed #f59e0b !important;
            background-color: #fffbeb !important;
            color: #92400e !important;
            padding: 8px 12px !important;
            text-align: center !important;
            font-weight: 800 !important;
            font-size: 13px !important;
            border-radius: 6px !important;
            margin-bottom: 12px !important;
        }
    }

    /* Specialized 80mm Thermal Mode */
    @@media print {
        body.thermal-print-mode {
            width: 76mm !important;
            max-width: 76mm !important;
            margin: 0 !important;
            padding: 0 !important;
            font-family: 'Cairo', 'Segoe UI', sans-serif !important;
            font-size: 11px !important;
            line-height: 1.35 !important;
            color: #000 !important;
        }

        body.thermal-print-mode .invoice-container {
            display: none !important;
        }

        body.thermal-print-mode .thermal-receipt-container {
            display: block !important;
            width: 76mm !important;
            max-width: 76mm !important;
            margin: 0 auto !important;
            padding: 4mm 2mm !important;
            box-sizing: border-box !important;
        }

        body.thermal-print-mode .thermal-receipt-container table {
            width: 100% !important;
            border-collapse: collapse !important;
            font-size: 10px !important;
        }

        body.thermal-print-mode .thermal-receipt-container td,
        body.thermal-print-mode .thermal-receipt-container th {
            padding: 3px 1px !important;
            border-bottom: 1px dashed #cbd5e1 !important;
        }

        body.thermal-print-mode .thermal-divider {
            border-top: 1px dashed #000 !important;
            margin: 6px 0 !important;
        }
        
        body.thermal-print-mode .thermal-divider-double {
            border-top: 2px solid #000 !important;
            margin: 6px 0 !important;
        }
    }
</style>

<!-- Top Interactive Action & Print Toolbar (Hidden on Print) -->
<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2 d-print-none">
    <div class="d-flex align-items-center gap-2 flex-wrap">
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-right me-1"></i> رجوع للفواتير
        </a>
        <h4 class="mb-0 fw-bold text-dark">
            <i class="bi @(isMaritime ? "bi-anchor text-info" : "bi-receipt text-primary") me-1"></i>
            @(isDraft ? "مسودة فاتورة #" + Model.Id : (isMaritime ? "أمر توريد: " : "فاتورة: ") + Model.InvoiceNumber)
        </h4>
        @if (isDraft)
        {
            <span class="badge bg-warning text-dark fs-6">
                <i class="bi bi-pencil-square me-1"></i> مسودة قيد التعديل
            </span>
        }
        else if (isPosted)
        {
            <span class="badge bg-success fs-6">
                <i class="bi bi-check2-circle me-1"></i> مرحّلة ومعتمدة رسمياً
            </span>
        }
        else if (isCancelled)
        {
            <span class="badge bg-danger fs-6">
                <i class="bi bi-x-octagon me-1"></i> ملغاة
            </span>
        }
    </div>

    <!-- Print Modes & Operation Buttons -->
    <div class="d-flex align-items-center gap-2 flex-wrap">
        @if (isPosted)
        {
            <button type="button" onclick="window.print()" class="btn btn-primary shadow-sm fw-bold">
                <i class="bi bi-printer-fill me-1"></i> طباعة A4
            </button>
            <button type="button" onclick="printThermalReceipt()" class="btn btn-outline-dark shadow-sm fw-bold" title="طباعة إيصال كاشير مقاس 80 مم للرول الحراري">
                <i class="bi bi-receipt me-1"></i> إيصال كاشير (80mm)
            </button>

            @if (Model.RemainingBalance > 0 && (Model.Type == InvoiceType.WholesaleSales || Model.Type == InvoiceType.MaritimeSupply))
            {
                <a asp-controller="Payment" asp-action="CustomerPayment" asp-route-customerId="@Model.CustomerId" class="btn btn-success shadow-sm fw-bold">
                    <i class="bi bi-cash-stack me-1"></i> تسجيل دفعة نقدية
                </a>
            }

            @if (Model.RemainingBalance > 0 && Model.Type == InvoiceType.VendorPurchase)
            {
                <a asp-controller="Payment" asp-action="VendorPayment" asp-route-vendorId="@Model.VendorId" class="btn btn-danger shadow-sm fw-bold">
                    <i class="bi bi-wallet2 me-1"></i> سداد للمورد
                </a>
            }

            @if (Model.PaidAmount == 0 && Model.Type != InvoiceType.MaritimeSupply)
            {
                <a asp-action="Cancel" asp-route-id="@Model.Id" class="btn btn-outline-danger btn-sm"
                   data-confirm="هل تريد بالتأكيد إلغاء هذه الفاتورة؟ لن يمكنك التراجع عن ذلك.">
                    <i class="bi bi-x-circle me-1"></i> إلغاء الفاتورة
                </a>
            }

            @if (Model.Type == InvoiceType.MaritimeSupply)
            {
                <a asp-action="Amend" asp-route-id="@Model.Id" class="btn btn-outline-primary btn-sm">
                    <i class="bi bi-pencil-square me-1"></i> تصحيح أمر التوريد
                </a>
                <a asp-action="Cancel" asp-route-id="@Model.Id" class="btn btn-outline-danger btn-sm"
                   data-confirm="حذف/إلغاء أمر التوريد: سيُلغى الأمر نهائياً مع تسجيل سبب الإلغاء، وسَتَعُود الكميات المسحوبة إلى مخزون الثلاجة بحركات عكسية، وستبقى أي سدادات سابقة رصيداً في حساب الشركة (بدون اختفاء أي مبلغ). هل تريد المتابعة؟">
                    <i class="bi bi-trash3 me-1"></i> حذف/إلغاء الأمر
                </a>
            }
        }
        else if (isDraft)
        {
            <!-- Print draft as a formal quotation / proforma quote -->
            <button type="button" onclick="window.print()" class="btn btn-outline-primary shadow-sm fw-bold" title="طباعة عرض أسعار أو مسودة للعميل قبل الترحيل">
                <i class="bi bi-printer me-1"></i> طباعة عرض أسعار (A4)
            </button>
            <button type="button" onclick="printThermalReceipt()" class="btn btn-outline-secondary shadow-sm" title="طباعة مسودة إيصال كاشير">
                <i class="bi bi-receipt me-1"></i> إيصال مسودة (80mm)
            </button>

            <form asp-action="Post" asp-route-id="@Model.Id" method="post" class="d-inline">
                <button type="button" class="btn btn-success fw-bold shadow-sm" @(Model.Items.Count == 0 ? "disabled" : "")
                        data-confirm="هل أنت متأكد من ترحيل هذه الفاتورة؟ سيتم اعتماد الأسعار والكميات وتحديث الأرصدة المالية والخصم من المخزون.">
                    <i class="bi bi-check2-all me-1"></i> ترحيل واعتماد الفاتورة
                </button>
            </form>

            <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="d-inline">
                <button type="button" class="btn btn-outline-danger fw-bold"
                        data-confirm="حذف المسودة بالكامل: ستُحذف هذه المسودة وكل بنودها ومصاريفها نهائياً من قاعدة البيانات، ولن يؤثر ذلك على المخزون أو الأرصدة المالية لأن المسودة لم تُرحّل بعد. هل تريد المتابعة؟">
                    <i class="bi bi-trash3 me-1"></i> حذف الطلب
                </button>
            </form>
        }
    </div>
</div>

<!-- Draft Notice Banner (Screen Only) -->
@if (isDraft)
{
    <div class="alert alert-warning d-flex align-items-center gap-3 shadow-sm d-print-none mb-4" role="alert">
        <i class="bi bi-info-circle-fill fs-3 text-warning"></i>
        <div>
            <strong class="d-block">تنبيه المسودة وعرض الأسعار:</strong>
            هذه الفاتورة ما زالت قيد التعديل ولم تُرحل إلى الأرصدة أو دفاتر العملاء والمخازن. يمكنك إضافة وتعديل البنود بحرية قبل الترحيل، أو طباعتها كـ <strong>عرض أسعار مبدئي</strong>.
        </div>
    </div>
}
else if (isCancelled)
{
    <div class="alert alert-danger d-flex align-items-center gap-3 shadow-sm d-print-none mb-4" role="alert">
        <i class="bi bi-x-octagon-fill fs-3 text-danger"></i>
        <div>
            <strong class="d-block">فاتورة ملغاة:</strong>
            تم إلغاء هذه الفاتورة بتاريخ @(Model.CancelledAt?.ToString("yyyy-MM-dd hh:mm tt") ?? "-") - سبب الإلغاء: @(Model.CancellationReason ?? "غير محدد").
        </div>
    </div>
}

        <!-- Amendment history (posted maritime supply orders) -->
        @if (isPosted && isMaritime && Model.Amendments.Any())
        {
            <div class="alert alert-info d-print-none" role="alert">
                <strong class="d-block mb-1"><i class="bi bi-clock-history me-1"></i> سجل تصحيحات أمر التوريد:</strong>
                <ul class="mb-0 small">
                    @foreach (var amendment in Model.Amendments)
                    {
                        <li>
                            بتاريخ @amendment.AmendedAtUtc.ToLocalTime().ToString("yyyy-MM-dd hh:mm tt") —
                            السبب: <strong>@amendment.Reason</strong>
                        </li>
                    }
                </ul>
            </div>
        }

<!-- ==========================================================================
     1. THE OFFICIAL A4 PRINTABLE INVOICE SHEET
     ========================================================================== -->
<div class="invoice-container p-4 p-md-5">

    <!-- Draft Watermark Banner (Appears in Print when Invoice is Draft) -->
    @if (isDraft)
    {
        <div class="draft-banner-print">
            <i class="bi bi-exclamation-triangle-fill me-1"></i>
            مسودة تسعيرة وعرض أسعار مبدئي — غير مرحلة بالدفاتر ولا تعتبر فاتورة ضريبية رسمية
        </div>
    }

    <!-- Header Section (Commercial & Tax Header) -->
    <div class="invoice-print-header pb-3 mb-4 border-bottom">
        <div class="row align-items-center g-3">
            <!-- Merchant Brand Info (RTL Right) -->
            <div class="col-5">
                <h3 class="fw-bold text-dark mb-1">
                    <i class="bi bi-shield-check text-primary me-1"></i> شركة المصري للتجارة والتوريدات
                </h3>
                <div class="small text-muted">إدارة مبيعات الجملة، التجزئة، وتوريد الأسماك المجمدة</div>
                <div class="small text-muted mt-1">
                    <span><strong>س.ت:</strong> 104928</span> | 
                    <span><strong>ب.ض:</strong> 482-901-332</span>
                </div>
                <div class="small text-muted">
                    <i class="bi bi-geo-alt me-1"></i> جمهورية مصر العربية - المركز الرئيسي | هاتف: 01000000000
                </div>
            </div>

            <!-- Invoice Status Stamp & Type (Center) -->
            <div class="col-3 text-center">
                <h5 class="fw-bold mb-2">
                    @if (isDraft)
                    {
                        <span class="text-warning-emphasis">
                            <i class="bi bi-file-earmark-text me-1"></i> عرض أسعار / مسودة
                        </span>
                    }
                    else
                    {
                        @switch (Model.Type)
                        {
                            case InvoiceType.VendorPurchase:
                                <span class="text-secondary"><i class="bi bi-cart-check me-1"></i> فاتورة مشتريات</span>
                                break;
                            case InvoiceType.WholesaleSales:
                                <span class="text-primary"><i class="bi bi-receipt me-1"></i> فاتورة مبيعات جملة</span>
                                break;
                            case InvoiceType.StoreCashSales:
                                <span class="text-success"><i class="bi bi-shop me-1"></i> فاتورة مبيعات تجزئة</span>
                                break;
                            case InvoiceType.MaritimeSupply:
                                <span class="text-info"><i class="bi bi-anchor me-1"></i> أمر توريد شركة بحرية</span>
                                break;
                        }
                    }
                </h5>
                <div>
                    @if (isDraft)
                    {
                        <span class="watermark-badge bg-warning-subtle text-warning-emphasis border border-warning">
                            <i class="bi bi-clock-history me-1"></i> مسودة عمل غير مرحلة
                        </span>
                    }
                    else
                    {
                        @switch (Model.PaymentStatus)
                        {
                            case InvoicePaymentStatus.Paid:
                                <span class="watermark-badge bg-success-subtle text-success border border-success">
                                    <i class="bi bi-check-circle-fill me-1"></i> مسددة بالكامل
                                </span>
                                break;
                            case InvoicePaymentStatus.PartiallyPaid:
                                <span class="watermark-badge bg-warning-subtle text-warning-emphasis border border-warning">
                                    <i class="bi bi-hourglass-split me-1"></i> مسددة جزئياً
                                </span>
                                break;
                            case InvoicePaymentStatus.Unpaid:
                                <span class="watermark-badge bg-danger-subtle text-danger border border-danger">
                                    <i class="bi bi-exclamation-circle-fill me-1"></i> غير مسددة (آجل)
                                </span>
                                break;
                        }
                    }
                </div>
            </div>

            <!-- Invoice Number, Date & QR (RTL Left) -->
            <div class="col-4 text-start">
                <div class="d-flex justify-content-end align-items-center gap-3">
                    <div>
                        <div class="text-muted small">@(isDraft ? "كود المسودة:" : "رقم الفاتورة:")</div>
                        <h4 class="fw-bold font-tabular text-dark mb-1 font-monospace">
                            @(isDraft ? "#DRAFT-" + Model.Id.ToString("D4") : Model.InvoiceNumber)
                        </h4>
                        <div class="small text-muted">التاريخ: <strong>@Model.TransactionDate.ToString("yyyy-MM-dd")</strong></div>
                        <div class="small text-muted">الوقت: <strong>@(Model.PostedAt.HasValue ? Model.PostedAt.Value.ToString("hh:mm tt") : Model.CreatedAt.ToString("hh:mm tt"))</strong></div>
                        @if (isMaritime)
                        {
                            <div class="small text-muted mt-1">
                                <i class="bi bi-hash"></i> أمر الشركة: <strong class="text-dark font-monospace">@(string.IsNullOrWhiteSpace(Model.ExternalOrderNumber) ? "-" : Model.ExternalOrderNumber)</strong>
                            </div>
                            <div class="small text-muted">
                                <i class="bi bi-calendar-event"></i> تاريخ الأمر: <strong>@(Model.SupplyOrderDate?.ToString("yyyy-MM-dd") ?? "-")</strong>
                            </div>
                        }
                    </div>
                    <!-- Official QR Code Placeholder -->
                    <div class="p-1 border rounded bg-light text-center" style="width: 70px; height: 70px;">
                        <svg viewBox="0 0 100 100" width="60" height="60" style="margin-top: 1px;">
                            <rect width="100" height="100" fill="#ffffff" />
                            <rect x="5" y="5" width="30" height="30" fill="#0f172a" />
                            <rect x="10" y="10" width="20" height="20" fill="#ffffff" />
                            <rect x="13" y="13" width="14" height="14" fill="#0f172a" />
                            <rect x="65" y="5" width="30" height="30" fill="#0f172a" />
                            <rect x="70" y="10" width="20" height="20" fill="#ffffff" />
                            <rect x="73" y="13" width="14" height="14" fill="#0f172a" />
                            <rect x="5" y="65" width="30" height="30" fill="#0f172a" />
                            <rect x="10" y="70" width="20" height="20" fill="#ffffff" />
                            <rect x="13" y="73" width="14" height="14" fill="#0f172a" />
                            <rect x="42" y="10" width="16" height="20" fill="#0f172a" />
                            <rect x="42" y="42" width="16" height="16" fill="#0f172a" />
                            <rect x="65" y="42" width="25" height="15" fill="#0f172a" />
                            <rect x="65" y="65" width="12" height="25" fill="#0f172a" />
                            <rect x="82" y="75" width="12" height="15" fill="#0f172a" />
                            <rect x="42" y="65" width="16" height="25" fill="#0f172a" />
                        </svg>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Party Information Card (Two Columns) -->
    <div class="invoice-party-card p-3 rounded-3 border bg-light mb-4">
        <div class="row g-3">
            <!-- Party Data -->
            <div class="col-md-7 border-start">
                <span class="text-muted small fw-bold d-block mb-1">
                    @(Model.Type == InvoiceType.VendorPurchase ? "بيانات المورد (طرف التعامل):" : isMaritime ? "بيانات شركة التوريد الملاحي (المشتري):" : "بيانات العميل (المشتري):")
                </span>
                <h5 class="fw-bold text-dark mb-1">
                    @if (Model.Type == InvoiceType.VendorPurchase)
                    {
                        @(Model.VendorName ?? "مورد غير محدد")
                    }
                    else if (Model.Type == InvoiceType.WholesaleSales)
                    {
                        @(Model.CustomerName ?? "عميل جملة")
                    }
                    else if (isMaritime)
                    {
                        <span><i class="bi bi-anchor text-info me-1"></i>@(Model.CustomerName ?? "شركة بحرية غير محددة")</span>
                    }
                    else
                    {
                        <span>عميل تجزئة نقدي (شراء مباشر)</span>
                    }
                </h5>
                @if (isMaritime && !string.IsNullOrWhiteSpace(Model.ExternalOrderNumber))
                {
                    <div class="small text-dark mt-1">
                        <strong>رقم أمر التوريد المرجعي:</strong> <span class="badge bg-light text-dark border font-monospace">@Model.ExternalOrderNumber</span>
                        @if (Model.SupplyOrderDate.HasValue)
                        {
                            <span class="ms-2"><strong>بتاريخ:</strong> @Model.SupplyOrderDate.Value.ToString("yyyy-MM-dd")</span>
                        }
                    </div>
                }
                @if (!string.IsNullOrEmpty(Model.Notes))
                {
                    <div class="small text-muted mt-1">
                        <i class="bi bi-chat-left-text me-1"></i> ملاحظات: @Model.Notes
                    </div>
                }
            </div>

            <!-- Payment & Transaction Terms -->
            <div class="col-md-5">
                <span class="text-muted small fw-bold d-block mb-1">شروط وطريقة التعامل:</span>
                <div class="fw-bold text-dark mb-1">
                    @switch (Model.Type)
                    {
                        case InvoiceType.StoreCashSales:
                            <span>سداد نقدي فوري بالخزينة</span>
                            break;
                        case InvoiceType.WholesaleSales:
                            <span>حساب آجل (ذمم مدينة)</span>
                            break;
                        case InvoiceType.VendorPurchase:
                            <span>حساب مورد آجل (ذمم دائنة)</span>
                            break;
                        case InvoiceType.MaritimeSupply:
                            <span>حساب شركة توريد بحري آجل (توريدات أسماك مجمدة)</span>
                            break;
                    }
                </div>
                <div class="small text-muted">
                    حالة المستند: <strong>@(isPosted ? "مرحّلة ومعتمدة بالدفاتر" : "مسودة عمل قيد التدقيق")</strong>
                </div>
            </div>
        </div>
    </div>

    <!-- Add Item Section (Only in Draft Mode - Screen Only) -->
    @if (isDraft)
    {
        <div class="card shadow-sm mb-4 border-primary d-print-none">
            <div class="card-header bg-primary text-white py-2">
                <h6 class="card-title mb-0">
                    <i class="bi bi-plus-circle me-1"></i> @(isMaritime ? "إضافة صنف جديد لامر التوريد" : "إضافة صنف جديد للمسودة")
                </h6>
            </div>
            <div class="card-body">
                <form asp-action="AddItem" method="post" class="row g-2 align-items-end">
                    <input type="hidden" name="InvoiceId" value="@Model.Id" />

                    <div class="col-md-3">
                        <label class="form-label small fw-bold">@(isMaritime ? "الصنف" : "الصنف / المنتج") <span class="text-danger">*</span></label>
                        @if (isMaritime)
                        {
                            <select name="ProductId" id="maritimeProductSelect" class="form-select form-select-sm" required>
                                <option value="">-- اختر الصنف --</option>
                                @foreach (var p in productOptions)
                                {
                                    freezerBalances.TryGetValue(p.Id, out var bal);
                                    var frozen = p.Category == ProductCategory.FrozenFish;
                                    var availableKg = frozen ? bal?.AvailableKg ?? 0m : 0m;
                                    var perCarton = p.DefaultCartonWeightKg ?? 0m;
                                    <option value="@p.Id"
                                            data-frozen="@(frozen ? "1" : "0")"
                                            data-available-kg="@availableKg.ToString("0.000", System.Globalization.CultureInfo.InvariantCulture)"
                                            data-per-carton="@perCarton.ToString("0.000", System.Globalization.CultureInfo.InvariantCulture)"
                                            data-price="@p.MaritimePricePerKg?.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)">
                                        @p.Name@(frozen ? " — مجمد" : " — عادي")@(frozen ? $" (متاح: {availableKg:N3} كجم)" : "")
                                    </option>
                                }
                            </select>
                        }
                        else
                        {
                            <select name="ProductId" class="form-select form-select-sm" asp-items="ViewBag.Products" required>
                                <option value="">-- اختر الصنف من المخزن --</option>
                            </select>
                        }
                    </div>

                    <div class="col-md-2">
                        <label class="form-label small fw-bold">@(isMaritime ? "الوزن المطلوب (كجم)" : "الكمية") <span class="text-danger">*</span></label>
                        <input type="number" step="0.001" min="0.001" name="Quantity" id="itemQuantityInput" class="form-control form-control-sm font-tabular" value="1" required />
                    </div>

                    <div class="col-md-2">
                        <label class="form-label small fw-bold">@(isMaritime ? "سعر الكجم (ج.م)" : "سعر الوحدة (ج.م)") <small class="text-muted fw-normal">(افتراضي من الدليل)</small></label>
                        <input type="number" step="0.01" min="0" name="UnitPrice" id="itemUnitPriceInput" class="form-control form-control-sm font-tabular" placeholder="سعر الصنف الافتراضي" />
                    </div>

                    <div class="col-md-2">
                        @if (isMaritime)
                        {
                            <label class="form-label small fw-bold">بيان مصدر التوريد</label>
                            <div class="form-check form-switch align-middle p-0">
                                <input type="checkbox" class="form-check-input ms-0" id="isFromFreezerSwitch" name="IsFromFreezer" value="true" />
                                <label class="form-check-label small fw-bold ms-1" for="isFromFreezerSwitch">
                                    التوريد من الثلاجة
                                </label>
                            </div>
                            <div class="small text-muted">مصدر البند يحدَّد لكل صنف على حدة</div>
                        }
                        else
                        {
                            <label class="form-label small fw-bold" style="visibility:hidden;">-</label>
                            <span class="d-block small text-muted">&nbsp;</span>
                        }
                    </div>

                    <div class="col-md-2">
                        <label class="form-label small fw-bold">خصم البند (ج.م)</label>
                        <input type="number" step="0.01" min="0" name="LineDiscountAmount" class="form-control form-control-sm font-tabular" value="0.00" />
                    </div>

                    <div class="col-md-1">
                        <button type="submit" class="btn btn-primary btn-sm w-100">
                            <i class="bi bi-plus-lg"></i>
                        </button>
                    </div>

                    @if (isMaritime)
                    {
                        <div class="col-12">
                            <div id="freezerAvailabilityBox" class="small rounded-2 px-3 py-2 d-none border border-info bg-info-subtle">
                                <span id="freezerAvailabilityText"></span>
                                <span id="freezerRemainingHint" class="fw-bold"></span>
                            </div>
                        </div>
                    }
                </form>
            </div>
        </div>
    }

    @if (isMaritime && isDraft)
    {
        // ============================================================
        // Additional charges & costs on the supply order
        // (billable charges flow into the final order total;
        //  internal charges are cost tracking only and never billed;
        //  NO cash movement is created for adding a charge)
        // ============================================================
        var billableChargesTotal = Model.AdditionalCharges.Where(c => c.IsBillableToCompany).Sum(c => c.Amount);
        var internalChargesTotal = Model.AdditionalCharges.Where(c => !c.IsBillableToCompany).Sum(c => c.Amount);
        <div class="card shadow-sm mb-4 border-secondary d-print-none">
            <div class="card-header bg-secondary bg-opacity-75 text-white py-2 d-flex justify-content-between align-items-center">
                <h6 class="card-title mb-0"><i class="bi bi-receipt-cutoff me-1"></i> المصاريف والتكاليف الإضافية</h6>
                <span class="badge bg-light text-dark">@billableChargesTotal.ToString("N2") ج.م على الشركة + @internalChargesTotal.ToString("N2") ج.م تكلفة داخلية</span>
            </div>
            <div class="card-body">
                <div class="table-responsive mb-3">
                    <table class="table table-sm table-bordered text-center mb-0 align-middle">
                        <thead class="table-light">
                            <tr>
                                <th class="text-start" style="width:30%;">اسم المصروف</th>
                                <th style="width:12%;">الكمية</th>
                                <th style="width:14%;">سعر الوحدة</th>
                                <th style="width:14%;">القيمة (ج.م)</th>
                                <th style="width:18%;">الاحتساب</th>
                                <th style="width:12%;"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.AdditionalCharges.Any())
                            {
                                <tr><td colspan="6" class="text-muted py-2">لا توجد مصاريف إضافية على هذا أمر التوريد.</td></tr>
                            }
                            @foreach (var charge in Model.AdditionalCharges)
                            {
                                <tr>
                                    <td class="text-start fw-bold">
                                        @charge.Description
                                        @if (!string.IsNullOrWhiteSpace(charge.Notes))
                                        {
                                            <div class="small text-muted">@charge.Notes</div>
                                        }
                                    </td>
                                    <td class="font-tabular">@(charge.Quantity?.ToString("0.###") ?? "-")</td>
                                    <td class="font-tabular">@(charge.UnitPrice?.ToString("N2") ?? "-")</td>
                                    <td class="font-tabular fw-bold">@charge.Amount.ToString("N2")</td>
                                    <td>
                                        @if (charge.IsBillableToCompany)
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success-subtle">محتسب على الشركة</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle">تكلفة داخلية (غير محتسبة)</span>
                                        }
                                    </td>
                                    <td>
                                        <form asp-action="RemoveCharge" method="post" class="d-inline" asp-route-invoiceId="@Model.Id">
                                            <input type="hidden" name="chargeId" value="@charge.Id" />
                                            <input type="hidden" name="invoiceId" value="@Model.Id" />
                                            <button type="button" class="btn btn-sm btn-outline-danger p-1" title="حذف المصروف"
                                                    data-confirm="هل تريد حذف هذا المصروف من أمر التوريد؟">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <form asp-action="AddCharge" method="post" class="row g-2 align-items-end">
                    <input type="hidden" name="InvoiceId" value="@Model.Id" />
                    <div class="col-md-3">
                        <label class="form-label small fw-bold">اسم المصروف <span class="text-danger">*</span></label>
                        <input type="text" name="Description" class="form-control form-control-sm" maxlength="200" placeholder="مثال: صناديق ثلج، كراتين" required />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label small fw-bold">الكمية</label>
                        <input type="number" step="0.001" min="0" name="Quantity" class="form-control form-control-sm font-tabular" placeholder="اختياري" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label small fw-bold">سعر الوحدة</label>
                        <input type="number" step="0.01" min="0" name="UnitPrice" class="form-control form-control-sm font-tabular" placeholder="اختياري" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label small fw-bold">قيمة مباشرة (ج.م)</label>
                        <input type="number" step="0.01" min="0" name="Amount" class="form-control form-control-sm font-tabular" placeholder="إن لم تُدخل الكمية والسعر" />
                    </div>
                    <div class="col-md-2">
                        <div class="form-check form-switch">
                            <input type="checkbox" class="form-check-input" name="IsBillableToCompany" value="true" checked />
                            <label class="form-check-label small">محتسب على الشركة</label>
                        </div>
                        <input type="text" name="Notes" class="form-control form-control-sm mt-1" maxlength="500" placeholder="ملاحظات (اختياري)" />
                    </div>
                    <div class="col-md-1">
                        <button type="submit" class="btn btn-secondary btn-sm w-100"><i class="bi bi-plus-lg"></i></button>
                    </div>
                    <div class="col-12 small text-muted">
                        أدخل الكمية وسعر الوحدة معاً لتُحسب القيمة تلقائياً على الخادم، أو أدخل جملة القيمة المباشرة. المصروفات المحتسبة على الشركة تُضاف إلى إجمالي أمر التوريد وتؤثر على رصيد الشركة؛ وإذا ادفع التاجر ثمناً لصناديق أو كراتين فعلياً فسجّل ذلك كمصروف نقدي عادي من صفحة المصاريف — إدخال المصروف هنا لا يُنشئ أي حركة نقدية.
                    </div>
                </form>
            </div>
        </div>
    }

    <!-- Line Items Table (A4 Standard) -->
    <div class="invoice-table-wrapper mb-4">
        <table class="table-invoice">
            <thead>
                <tr>
                    <th style="width: 40px;">#</th>
                    <th class="text-start">اسم الصنف / المنتج</th>
                    <th style="width: 90px;">@(isMaritime ? "الوزن (كجم)" : "الكمية")</th>
                    @if (isPosted)
                    {
                        <th style="width: 75px;">المرتجع</th>
                        <th style="width: 75px;">الصافي</th>
                    }
                    <th style="width: 95px;">@(isMaritime ? "سعر الكجم" : "سعر الوحدة")</th>
                    <th style="width: 85px;">الخصم</th>
                    <th style="width: 110px;">الإجمالي</th>
                    @if (isDraft)
                    {
                        <th class="d-print-none" style="width: 60px;">حذف</th>
                    }
                </tr>
            </thead>
            <tbody>
                @if (Model.Items.Count == 0)
                {
                    <tr>
                        <td colspan="@(isDraft ? "7" : (isPosted ? "8" : "6"))" class="text-center py-4 text-muted">
                            <i class="bi bi-inbox fs-3 d-block mb-1 text-secondary"></i>
                            لا توجد أصناف في الفاتورة بعد.
                        </td>
                    </tr>
                }
                else
                {
                    int itemIdx = 1;
                    foreach (var item in Model.Items)
                    {
                        returnedQuantities.TryGetValue(item.ProductId, out var retQty);
                        var netQty = item.Quantity - retQty;
                        <tr>
                            <td class="text-center text-muted fw-bold">@(itemIdx++)</td>
                            <td class="text-start fw-bold text-dark">
                                <span>@(!string.IsNullOrWhiteSpace(item.ProductName) ? item.ProductName : "صنف غير محدد")</span>
                                @if (isMaritime)
                                {
                                    @if (item.IsFromFreezer)
                                    {
                                        <span class="badge bg-info-subtle text-info border border-info-subtle ms-1" style="font-size:0.75rem;">من الثلاجة</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle ms-1" style="font-size:0.75rem;">خارج الثلاجة</span>
                                    }
                                    @if (isDraft && item.IsFromFreezer && freezerBalances.TryGetValue(item.ProductId, out var rowBalance))
                                    {
                                        <div class="small text-muted">
                                            الرصيد بالثلاجة: @rowBalance.AvailableKg.ToString("N3") كجم
                                        </div>
                                    }
                                }
                            </td>
                            <td class="text-center font-tabular fw-bold">
                                @item.Quantity.ToString("G29")@(isMaritime ? " كجم" : "")
                            </td>
                            @if (isPosted)
                            {
                                <td class="text-center font-tabular text-danger">
                                    @(retQty > 0 ? retQty.ToString("G29") : "-")
                                </td>
                                <td class="text-center font-tabular fw-bold @(retQty > 0 ? "text-primary" : "")">
                                    @netQty.ToString("G29")
                                </td>
                            }
                            <td class="text-center font-tabular">@item.UnitPrice.ToString("N2")</td>
                            <td class="text-center font-tabular text-danger">
                                @(item.LineDiscountAmount > 0 ? "-" + item.LineDiscountAmount.ToString("N2") : "-")
                            </td>
                            <td class="text-center font-tabular fw-bold text-dark">@item.LineTotal.ToString("N2")</td>
                            @if (isDraft)
                            {
                                <td class="text-center d-print-none">
                                    <form asp-action="RemoveItem" method="post" class="d-inline">
                                        <input type="hidden" name="itemId" value="@item.Id" />
                                        <input type="hidden" name="invoiceId" value="@Model.Id" />
                                        <button type="button" class="btn btn-sm btn-outline-danger p-1" title="حذف"
                                                data-confirm="هل تريد حذف هذا البند من المسودة؟">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </td>
                            }
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <!-- Additional Charges Table (print-visible for maritime supply orders) -->
    @if (isMaritime && Model.AdditionalCharges.Any())
    {
        <div class="invoice-table-wrapper mb-4">
            <table class="table-invoice">
                <thead>
                    <tr>
                        <th class="text-start">المصاريف والتكاليف الإضافية</th>
                        <th style="width: 90px;" class="text-center">الكمية</th>
                        <th style="width: 100px;" class="text-center">سعر الوحدة</th>
                        <th style="width: 110px;" class="text-center">القيمة</th>
                        <th style="width: 110px;" class="text-center">الاحتساب</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var charge in Model.AdditionalCharges)
                    {
                        <tr>
                            <td class="text-start text-dark">
                                @charge.Description
                                @if (!string.IsNullOrWhiteSpace(charge.Notes))
                                {
                                    <div class="small text-muted">@charge.Notes</div>
                                }
                            </td>
                            <td class="text-center font-tabular">@(charge.Quantity?.ToString("0.###") ?? "-")</td>
                            <td class="text-center font-tabular">@(charge.UnitPrice?.ToString("N2") ?? "-")</td>
                            <td class="text-center font-tabular fw-bold text-dark">@charge.Amount.ToString("N2")</td>
                            <td class="text-center">
                                @(charge.IsBillableToCompany ? "محتسب على الشركة" : "تكلفة داخلية")
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    <!-- Credit Notes Linked Sub-Table (If Returns Exist) -->
    @if (isPosted && creditNotes.Any())
    {
        <div class="mb-4 p-3 bg-light rounded-3 border border-warning">
            <h6 class="fw-bold text-dark mb-2">
                <i class="bi bi-arrow-return-left text-danger me-1"></i> إشعارات الخصم والمرتجعات الصادرة على الفاتورة:
            </h6>
            <div class="table-responsive">
                <table class="table table-sm table-bordered bg-white text-center mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>رقم الإشعار</th>
                            <th>تاريخ المرتجع</th>
                            <th class="text-start">الأصناف المرتجعة</th>
                            <th>المبلغ المخصوم</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var note in creditNotes)
                        {
                            <tr>
                                <td class="fw-bold font-monospace">@note.CreditNoteNumber</td>
                                <td class="font-tabular">@note.TransactionDate.ToString("yyyy-MM-dd")</td>
                                <td class="text-start small">
                                    @foreach (var nItem in note.Items)
                                    {
                                        <span class="d-inline-block me-2">• @nItem.ProductName (@nItem.Quantity × @nItem.UnitPrice.ToString("N2"))</span>
                                    }
                                </td>
                                <td class="fw-bold text-danger font-tabular">-@note.TotalAmount.ToString("N2") ج.م</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    <!-- Financial Totals & Tafqeet Box -->
    <div class="invoice-summary-box mb-4">
        <div class="row g-4 align-items-center">
            <!-- Arabic Tafqeet Box (RTL Right) -->
            <div class="col-md-7">
                <div class="p-3 bg-light rounded-3 border">
                    <span class="text-muted small fw-bold d-block mb-1">المبلغ الإجمالي كتابةً (فقط وقدره):</span>
                    <div class="fw-bold text-dark fs-6">
                        @Tafqeet.ToArabicWords(Model.TotalAmount)
                    </div>
                    @if (isPosted && Model.RemainingBalance > 0)
                    {
                        <div class="text-danger small mt-2 pt-2 border-top">
                            <i class="bi bi-exclamation-circle me-1"></i>
                            <strong>المبلغ المتبقي غير المسدد:</strong> @Tafqeet.ToArabicWords(Model.RemainingBalance)
                        </div>
                    }
                </div>
            </div>

            <!-- Totals Numbers (RTL Left) -->
            <div class="col-md-5">
                <div class="totals-box">
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">المجموع قبل الخصم:</span>
                        <span class="fw-bold font-tabular">@Model.SubTotal.ToString("N2") ج.م</span>
                    </div>

                    @if (Model.ItemDiscountTotal > 0 || Model.InvoiceDiscountAmount > 0)
                    {
                        <div class="d-flex justify-content-between mb-2 text-danger">
                            <span>إجمالي الخصومات:</span>
                            <span class="font-tabular">-@((Model.ItemDiscountTotal + Model.InvoiceDiscountAmount).ToString("N2")) ج.م</span>
                        </div>
                    }

                    @if (totalReturnedAmount > 0)
                    {
                        <div class="d-flex justify-content-between mb-2 text-danger">
                            <span>إجمالي المرتجعات:</span>
                            <span class="font-tabular">-@totalReturnedAmount.ToString("N2") ج.م</span>
                        </div>
                    }

                    @if (isMaritime && Model.BillableChargesTotal > 0)
                    {
                        <div class="d-flex justify-content-between mb-2 text-secondary">
                            <span>مصاريف إضافية محتسبة على الشركة:</span>
                            <span class="font-tabular">+@Model.BillableChargesTotal.ToString("N2") ج.م</span>
                        </div>
                        @if (Model.InternalChargesTotal > 0)
                        {
                            <div class="d-flex justify-content-between mb-2 text-muted small">
                                <span>تكاليف داخلية (غير محتسبة على الشركة):</span>
                                <span class="font-tabular">@Model.InternalChargesTotal.ToString("N2") ج.م</span>
                            </div>
                        }
                    }

                    <div class="d-flex justify-content-between py-2 border-top border-bottom border-2 my-2 fs-5 fw-bold text-dark">
                        <span>صافي الفاتورة الإجمالي:</span>
                        <span class="text-primary font-tabular">@Model.TotalAmount.ToString("N2") ج.م</span>
                    </div>

                    @if (isPosted)
                    {
                        <div class="d-flex justify-content-between mb-2 text-success">
                            <span>المدفوع حتى الآن:</span>
                            <span class="fw-bold font-tabular">@Model.PaidAmount.ToString("N2") ج.م</span>
                        </div>

                        <div class="d-flex justify-content-between pt-2 @(Model.RemainingBalance > 0 ? "unpaid-highlight-box text-danger" : "paid-highlight-box text-success")">
                            <span class="fw-bold">المتبقي غير المسدد:</span>
                            <span class="fw-bold fs-5 font-tabular">@Model.RemainingBalance.ToString("N2") ج.م</span>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Footer Terms & Dual Signature Blocks -->
    <div class="invoice-signature-block pt-4 border-top">
        <div class="row text-center mb-3">
            <div class="col-6">
                <div class="text-muted small mb-4">توقيع المستلم / العميل</div>
                <div class="d-inline-block border-bottom border-dark pb-1 px-5">
                    ............................................................
                </div>
            </div>
            <div class="col-6">
                <div class="text-muted small mb-4">توقيع أمين الخزينة / الحسابات</div>
                <div class="d-inline-block border-bottom border-dark pb-1 px-5">
                    ............................................................
                </div>
            </div>
        </div>

        <div class="text-center text-muted small mt-4 pt-2 border-top">
            <p class="mb-0">
                • البضاعة المباعة ترد وتستبدل خلال 14 يوماً بموجب أصل الفاتورة بحالتها الأصلية.
                • شكراً لتعاملكم معنا!
            </p>
        </div>
    </div>
</div>

<!-- ==========================================================================
     2. THE 80MM POS THERMAL RECEIPT ENGINE (Printed only when requested)
     ========================================================================== -->
<div class="thermal-receipt-container">
    <div class="text-center mb-2">
        <h5 class="fw-bold mb-0">شركة المصري للتجارة والتوريدات</h5>
        <div style="font-size: 10px;">Elmasry Trading & Supplies | إدارة المبيعات</div>
        <div style="font-size: 9.5px;">س.ت: 104928 | ب.ض: 482-901-332</div>
        <div style="font-size: 9.5px;">هاتف: 01000000000</div>
    </div>

    <div class="thermal-divider"></div>

    <div class="text-center my-1">
        <strong style="font-size: 12px;">
            @(isDraft ? "مسودة إيصال كاشير (غير مرحلة)" : (isMaritime ? "إيصال أمر توريد بحري" : "إيصال مبيعات نقدية"))
        </strong>
    </div>

    <div class="thermal-divider"></div>

    <div style="font-size: 10px; margin-bottom: 4px;">
        <div class="d-flex justify-content-between">
            <span>رقم الإيصال:</span>
            <strong class="font-monospace">@(isDraft ? "#DRAFT-" + Model.Id : Model.InvoiceNumber)</strong>
        </div>
        <div class="d-flex justify-content-between">
            <span>التاريخ والوقت:</span>
            <span>@Model.TransactionDate.ToString("yyyy-MM-dd") @(Model.PostedAt?.ToLocalTime().ToString("hh:mm tt") ?? (Model.CreatedAt != default ? Model.CreatedAt.ToLocalTime().ToString("hh:mm tt") : Model.TransactionDate.ToString("hh:mm tt")))</span>
        </div>
        @if (isMaritime && !string.IsNullOrWhiteSpace(Model.ExternalOrderNumber))
        {
            <div class="d-flex justify-content-between">
                <span>أمر التوريد:</span>
                <strong class="font-monospace">@Model.ExternalOrderNumber</strong>
            </div>
        }
        <div class="d-flex justify-content-between">
            <span>العميل / الطرف:</span>
            <strong>@(Model.CustomerName ?? Model.VendorName ?? "عميل نقدي")</strong>
        </div>
        <div class="d-flex justify-content-between">
            <span>الكاشير:</span>
            <span>@(User.Identity?.Name ?? "Admin")</span>
        </div>
    </div>

    <div class="thermal-divider"></div>

    <!-- Items List -->
    <table>
        <thead>
            <tr>
                <th class="text-start">الصنف</th>
                <th class="text-center">الكمية</th>
                <th class="text-center">السعر</th>
                <th class="text-end">الإجمالي</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Items)
            {
                <tr>
                    <td class="text-start">@(!string.IsNullOrWhiteSpace(item.ProductName) ? item.ProductName : "صنف سمك مجمد")</td>
                    <td class="text-center font-tabular">@item.Quantity.ToString("G29")@(isMaritime ? "ك" : "")</td>
                    <td class="text-center font-tabular">@item.UnitPrice.ToString("N1")</td>
                    <td class="text-end font-tabular fw-bold">@item.LineTotal.ToString("N2")</td>
                </tr>
            }
        </tbody>
    </table>

    <div class="thermal-divider-double"></div>

    <!-- Totals -->
    <div style="font-size: 10.5px;">
        <div class="d-flex justify-content-between mb-1">
            <span>المجموع:</span>
            <span class="font-tabular">@Model.SubTotal.ToString("N2") ج.م</span>
        </div>
        @if (Model.ItemDiscountTotal > 0 || Model.InvoiceDiscountAmount > 0)
        {
            <div class="d-flex justify-content-between mb-1">
                <span>الخصومات:</span>
                <span class="font-tabular">-@((Model.ItemDiscountTotal + Model.InvoiceDiscountAmount).ToString("N2")) ج.م</span>
            </div>
        }
        @if (isMaritime && Model.BillableChargesTotal > 0)
        {
            <div class="d-flex justify-content-between mb-1">
                <span>مصاريف إضافية:</span>
                <span class="font-tabular">+@Model.BillableChargesTotal.ToString("N2") ج.م</span>
            </div>
            @foreach (var charge in Model.AdditionalCharges.Where(c => c.IsBillableToCompany))
            {
                <div class="d-flex justify-content-between" style="font-size: 9px;">
                    <span class="text-muted">• @charge.Description</span>
                    <span class="font-tabular">@charge.Amount.ToString("N2")</span>
                </div>
            }
        }
        <div class="d-flex justify-content-between my-1 pt-1 border-top border-dark" style="font-size: 12px;">
            <strong>الصافي المستحق:</strong>
            <strong class="font-tabular">@Model.TotalAmount.ToString("N2") ج.م</strong>
        </div>
        @if (isPosted)
        {
            <div class="d-flex justify-content-between mb-1">
                <span>المدفوع:</span>
                <span class="font-tabular">@Model.PaidAmount.ToString("N2") ج.م</span>
            </div>
            <div class="d-flex justify-content-between mb-1">
                <strong>المتبقي:</strong>
                <strong class="font-tabular">@Model.RemainingBalance.ToString("N2") ج.م</strong>
            </div>
        }
    </div>

    <div class="thermal-divider"></div>

    <!-- Footer Notice -->
    <div class="text-center mt-2" style="font-size: 9.5px;">
        <p class="mb-1">البضاعة المباعة ترد وتستبدل خلال 14 يوماً مع إحضار أصل الإيصال.</p>
        <p class="fw-bold mb-0">شكراً لزيارتكم ونسعد بخدمتكم دائماً!</p>
    </div>
</div>

@section Scripts {
    <script>
        function printThermalReceipt() {
            document.body.classList.add('thermal-print-mode');
            window.print();
        }

        window.addEventListener('afterprint', function () {
            document.body.classList.remove('thermal-print-mode');
        });

        @if (isDraft && isMaritime)
        {
            <text>
            // ============================================================
            // Maritime draft: per-item supply source controls
            // ============================================================
            (function () {
                const productSelect = document.getElementById('maritimeProductSelect');
                const freezerSwitch = document.getElementById('isFromFreezerSwitch');
                const availabilityBox = document.getElementById('freezerAvailabilityBox');
                const availabilityText = document.getElementById('freezerAvailabilityText');
                const remainingHint = document.getElementById('freezerRemainingHint');
                const quantityInput = document.getElementById('itemQuantityInput');
                const unitPriceInput = document.getElementById('itemUnitPriceInput');

                function selectedOption() {
                    return productSelect.options[productSelect.selectedIndex];
                }

                function parse(value) {
                    const n = parseFloat(value);
                    return isNaN(n) ? 0 : n;
                }

                function formatKg(value) {
                    return value.toLocaleString('ar-EG', { minimumFractionDigits: 3, maximumFractionDigits: 3 });
                }

                function refresh() {
                    const option = selectedOption();
                    if (!option || !option.value) {
                        freezerSwitch.checked = false;
                        freezerSwitch.disabled = true;
                        availabilityBox.classList.add('d-none');
                        availabilityText.textContent = '';
                        remainingHint.textContent = '';
                        remainingHint.className = 'fw-bold';
                        return;
                    }

                    const frozen = option.dataset.frozen === '1';
                    const availableKg = parse(option.dataset.availableKg);
                    const perCarton = parse(option.dataset.perCarton);

                    if (!frozen) {
                        // Regular products are supplied from outside the freezer;
                        // the option is disabled so it can never be inferred.
                        freezerSwitch.checked = false;
                        freezerSwitch.disabled = true;
                        availabilityBox.classList.remove('d-none');
                        availabilityBox.className = 'small rounded-2 px-3 py-2 border border-warning bg-warning-subtle';
                        availabilityText.textContent = 'هذا صنف عادي: لا يوجد له رصيد بالثلاجة، وسيُحسب في الإجمالي بدون أي شطب من مخزون الثلاجات.';
                        remainingHint.textContent = '';
                        // NOTE: intentionally NO focus() here — the availability panel
                        // refreshes on every KG keystroke; stealing the cursor prevented
                        // normal multi-digit weight entry (e.g. 125.500).
                    } else {
                        freezerSwitch.disabled = false;
                        unitPriceInput.placeholder = '';

                        // Default per-KG price from the product catalog (user can override).
                        if (option.dataset.price && !unitPriceInput.value) {
                            unitPriceInput.value = option.dataset.price;
                        }

                        const qty = parse(quantityInput.value);
                        const fromFreezer = freezerSwitch.checked;

                        if (fromFreezer) {
                            availabilityBox.classList.remove('d-none');
                            availabilityBox.className = 'small rounded-2 px-3 py-2 border border-info bg-info-subtle';
                            availabilityText.textContent =
                                'التوريد من الثلاجة — الرصيد المتاح حالياً: ' + formatKg(availableKg) + ' كجم'
                                + (perCarton > 0 ? ' (' + formatKg(qty / perCarton) + ' كرتونة مطلوبة)' : '');

                            if (qty > availableKg) {
                                remainingHint.textContent = ' ⚠ الكمية المطلوبة أكبر من الكمية المتاحة في التلاجة.';
                                remainingHint.className = 'fw-bold text-danger';
                            } else {
                                remainingHint.textContent = ' ✓ متاح — رصيد الثلاجة بعد التسليم: ' + formatKg(availableKg - qty) + ' كجم.';
                                remainingHint.className = 'fw-bold text-success';
                            }
                        } else {
                            availabilityBox.classList.remove('d-none');
                            availabilityBox.className = 'small rounded-2 px-3 py-2 border border-info bg-info-subtle';
                            availabilityText.textContent =
                                'الصنف مجمد ويتوفر بالثلاجة (' + formatKg(availableKg) + ' كجم) — لكن السحب من الثلاجة غير مُحدَّد لهذا البند: لن يتم التحقق من المخزون ولن يُخصم شيئاً.';
                            remainingHint.textContent = '';
                        }
                    }
                }

                productSelect.addEventListener('change', refresh);
                freezerSwitch.addEventListener('change', refresh);
                quantityInput.addEventListener('input', refresh);

                // Re-run once when the form is reloaded (browser back navigation).
                refresh();
            })();
            </text>
        }
    </script>
}