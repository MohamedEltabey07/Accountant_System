@model BLL.DTOs.Invoice.InComingData.CancelInvoiceDto
@{
    ViewData["Title"] = "إلغاء فاتورة مرحلة";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4><i class="bi bi-x-octagon me-2 text-danger"></i> إلغاء الفاتورة</h4>
    <a asp-action="Details" asp-route-id="@Model.InvoiceId" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-right me-1"></i> رجوع للفاتورة
    </a>
</div>

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card shadow-sm border-danger">
            <div class="card-header bg-danger text-white py-3">
                <h5 class="card-title mb-0">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i> تأكيد إلغاء الفاتورة
                </h5>
            </div>
            <div class="card-body">
                <div class="alert alert-warning mb-4">
                    <h6 class="fw-bold mb-1"><i class="bi bi-info-circle me-1"></i> تنبيه محاسبي هام:</h6>
                    <ul class="mb-0 small">
                        <li>إلغاء الفاتورة عملية نهائية ولا يمكن التراجع عنها.</li>
                        <li>سيتم تصفير تأثير هذه الفاتورة على رصيد العميل أو المورد.</li>
                        <li>لا يمكن إلغاء الفواتير التي تم تسجيل دفعات أو مرتجعات عليها.</li>
                    </ul>
                </div>

                <div asp-validation-summary="All" class="text-danger mb-3"></div>

                <form asp-action="Cancel" method="post">
                    <input type="hidden" asp-for="InvoiceId" />

                    <div class="mb-3">
                        <label asp-for="CancellationReason" class="form-label fw-bold">سبب الإلغاء <span class="text-danger">*</span></label>
                        <textarea asp-for="CancellationReason" class="form-control" rows="4" placeholder="اكتب بالتفصيل سبب إلغاء هذه الفاتورة للرجوع إليها مستقبلاً..."></textarea>
                        <span asp-validation-for="CancellationReason" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-between pt-3 border-top">
                        <a asp-action="Details" asp-route-id="@Model.InvoiceId" class="btn btn-outline-secondary">
                            تراجع
                        </a>
                        <button type="submit" class="btn btn-danger" onclick="return confirm('هل أنت متأكد من رغبتك في إلغاء هذه الفاتورة نهائياً؟');">
                            <i class="bi bi-x-circle me-1"></i> تأكيد الإلغاء النهائي
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
