@model List<BLL.DTOs.Invoice.OutGoingData.InvoiceDto>
@using DAL.Enums
@{
    ViewData["Title"] = "سجل الفواتير";
    var selectedType = ViewBag.SelectedType as InvoiceType?;
    var selectedStatus = ViewBag.SelectedStatus as InvoiceStatus?;
}

<!-- Page Header -->
<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
    <div>
        <h3 class="fw-bold mb-1">
            <i class="bi bi-receipt-cutoff text-primary me-2"></i> سجل الفواتير والمبيعات
        </h3>
        <p class="text-muted mb-0">إدارة فواتير المشتريات، مبيعات الجملة، ومبيعات التجزئة النقدية</p>
    </div>
    <div class="d-flex gap-2">
        <button type="button" class="btn btn-outline-success shadow-sm" onclick="exportTableToCSV('invoiceTable', 'سجل_الفواتير')">
            <i class="bi bi-file-earmark-excel me-1"></i> تصدير Excel
        </button>
        <a asp-action="Create" class="btn btn-primary shadow-sm fw-bold">
            <i class="bi bi-plus-lg me-1"></i> إنشاء فاتورة جديدة
        </a>
    </div>
</div>

<!-- Filters & Real-time Search Card -->
<div class="card shadow-sm border-0 mb-3">
    <div class="card-body p-3">
        <form method="get" asp-action="Index" id="invoiceFilterForm" class="row g-2 align-items-end mb-2">
            <div class="col-sm-6 col-md-5">
                <label class="form-label small fw-bold text-muted">تصفية بنوع الفاتورة</label>
                <select name="type" class="form-select form-select-sm" onchange="this.form.submit()">
                    <option value="" selected="@(selectedType == null ? "selected" : null)">-- كل الأنواع --</option>
                    <option value="@((int)InvoiceType.WholesaleSales)" selected="@(selectedType == InvoiceType.WholesaleSales ? "selected" : null)">مبيعات جملة</option>
                    <option value="@((int)InvoiceType.StoreCashSales)" selected="@(selectedType == InvoiceType.StoreCashSales ? "selected" : null)">مبيعات تجزئة نقدي</option>
                    <option value="@((int)InvoiceType.VendorPurchase)" selected="@(selectedType == InvoiceType.VendorPurchase ? "selected" : null)">مشتريات من مورد</option>
                    <option value="@((int)InvoiceType.MaritimeSupply)" selected="@(selectedType == InvoiceType.MaritimeSupply ? "selected" : null)">توريد لشركة بحرية</option>
                </select>
            </div>
            <div class="col-sm-6 col-md-5">
                <label class="form-label small fw-bold text-muted">حالة الفاتورة بالدفاتر</label>
                <select name="status" class="form-select form-select-sm" onchange="this.form.submit()">
                    <option value="" selected="@(selectedStatus == null ? "selected" : null)">-- كل الحالات --</option>
                    <option value="@((int)InvoiceStatus.Draft)" selected="@(selectedStatus == InvoiceStatus.Draft ? "selected" : null)">مسودة (قيد التعديل)</option>
                    <option value="@((int)InvoiceStatus.Posted)" selected="@(selectedStatus == InvoiceStatus.Posted ? "selected" : null)">مرحّلة ومعتمدة</option>
                    <option value="@((int)InvoiceStatus.Cancelled)" selected="@(selectedStatus == InvoiceStatus.Cancelled ? "selected" : null)">ملغاة</option>
                </select>
            </div>
            <div class="col-md-2">
                <a asp-action="Index" class="btn btn-sm btn-outline-secondary w-100" title="إعادة تعيين الفلاتر">
                    <i class="bi bi-arrow-clockwise me-1"></i> إعادة ضبط
                </a>
            </div>
        </form>

        <div class="row align-items-center pt-2 border-top g-2">
            <div class="col-md-6">
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                    <input type="text" class="form-control border-start-0" placeholder="بحث فوري برقم الفاتورة، اسم العميل، أو المورد..." data-table-search="invoiceTable" data-counter-target="invoiceCounter" />
                </div>
            </div>
            <div class="col-md-6 text-md-start">
                <span class="badge bg-light text-dark border p-2 font-tabular" id="invoiceCounter">
                    عرض @Model.Count من إجمالي @Model.Count فاتورة
                </span>
            </div>
        </div>
    </div>
</div>

<!-- Invoices Table / Empty State -->
<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        @if (Model.Count == 0)
        {
            <div class="text-center py-5">
                <i class="bi bi-receipt fs-1 text-muted d-block mb-3"></i>
                <h5 class="fw-bold text-dark">لا توجد فواتير مطابقة في السجل</h5>
                <p class="text-muted small mb-3">ابدأ بإنشاء أول فاتورة مبيعات أو مشتريات.</p>
                <a asp-action="Create" class="btn btn-primary btn-sm">
                    <i class="bi bi-plus-lg me-1"></i> إنشاء فاتورة جديدة
                </a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-modern align-middle text-center mb-0" id="invoiceTable">
                    <thead>
                        <tr>
                            <th>رقم الفاتورة</th>
                            <th>النوع</th>
                            <th>التاريخ</th>
                            <th class="text-start">الطرف (العميل / المورد)</th>
                            <th>الإجمالي</th>
                            <th>المدفوع</th>
                            <th>المتبقي</th>
                            <th>حالة السداد</th>
                            <th>الحالة</th>
                            <th class="no-export">الإجراءات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var inv in Model)
                        {
                            <tr>
                                <td class="fw-bold font-monospace">
                                    @if (!string.IsNullOrEmpty(inv.InvoiceNumber))
                                    {
                                        <a asp-action="Details" asp-route-id="@inv.Id" class="text-decoration-none fw-bold text-primary">
                                            @inv.InvoiceNumber
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">مسودة #@inv.Id</span>
                                    }
                                </td>
                                <td>
                                    @switch (inv.Type)
                                    {
                                        case InvoiceType.VendorPurchase:
                                            <span class="badge bg-secondary-subtle text-secondary border">
                                                <i class="bi bi-cart-plus me-1"></i> مشتريات
                                            </span>
                                            break;
                                        case InvoiceType.WholesaleSales:
                                            <span class="badge bg-primary-subtle text-primary border">
                                                <i class="bi bi-receipt me-1"></i> جملة
                                            </span>
                                            break;
                                        case InvoiceType.StoreCashSales:
                                            <span class="badge bg-success-subtle text-success border">
                                                <i class="bi bi-shop me-1"></i> تجزئة نقدي
                                            </span>
                                            break;
                                        case InvoiceType.MaritimeSupply:
                                            <span class="badge bg-info-subtle text-info border">
                                                <i class="bi bi-anchor me-1"></i> توريد بحري
                                            </span>
                                            break;
                                    }
                                </td>
                                <td class="font-tabular">@inv.TransactionDate.ToString("yyyy-MM-dd")</td>
                                <td class="text-start">
                                    @if (inv.Type == InvoiceType.VendorPurchase)
                                    {
                                        <span class="fw-bold text-dark"><i class="bi bi-truck text-muted me-1"></i>@(inv.VendorName ?? "-")</span>
                                    }
                                    else if (inv.Type == InvoiceType.WholesaleSales)
                                    {
                                        <span class="fw-bold text-dark"><i class="bi bi-person text-muted me-1"></i>@(inv.CustomerName ?? "-")</span>
                                    }
                                    else if (inv.Type == InvoiceType.MaritimeSupply)
                                    {
                                        <span class="fw-bold text-dark"><i class="bi bi-anchor text-info me-1"></i>@(inv.CustomerName ?? "-")</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted"><i class="bi bi-cash me-1"></i>مبيعات نقدية</span>
                                    }
                                </td>
                                <td class="fw-bold font-tabular text-dark">@inv.TotalAmount.ToString("N2")</td>
                                <td class="text-success font-tabular">@inv.PaidAmount.ToString("N2")</td>
                                <td class="font-tabular @(inv.RemainingBalance > 0 ? "text-danger fw-bold" : "text-muted")">
                                    @inv.RemainingBalance.ToString("N2")
                                </td>
                                <td>
                                    @switch (inv.PaymentStatus)
                                    {
                                        case InvoicePaymentStatus.Paid:
                                            <span class="badge bg-success-subtle text-success border border-success">
                                                مسددة
                                            </span>
                                            break;
                                        case InvoicePaymentStatus.PartiallyPaid:
                                            <span class="badge bg-warning-subtle text-warning-emphasis border border-warning">
                                                مسددة جزئياً
                                            </span>
                                            break;
                                        case InvoicePaymentStatus.Unpaid:
                                            <span class="badge bg-danger-subtle text-danger border border-danger">
                                                غير مسددة
                                            </span>
                                            break;
                                    }
                                </td>
                                <td>
                                    @switch (inv.Status)
                                    {
                                        case InvoiceStatus.Draft:
                                            <span class="badge bg-warning text-dark">مسودة</span>
                                            break;
                                        case InvoiceStatus.Posted:
                                            <span class="badge bg-success">مرحّلة</span>
                                            break;
                                        case InvoiceStatus.Cancelled:
                                            <span class="badge bg-secondary">ملغاة</span>
                                            break;
                                    }
                                </td>
                                <td class="no-export">
                                    <div class="btn-group btn-group-sm">
                                        <a asp-action="Details" asp-route-id="@inv.Id" class="btn btn-outline-primary" title="عرض الفاتورة والطباعة">
                                            <i class="bi bi-printer"></i>
                                        </a>
                                        @if (inv.Status == InvoiceStatus.Posted && inv.PaidAmount == 0)
                                        {
                                            <a asp-action="Cancel" asp-route-id="@inv.Id" class="btn btn-outline-danger" title="إلغاء الفاتورة" data-confirm="هل تريد بالتأكيد إلغاء الفاتورة رقم (@inv.InvoiceNumber)؟">
                                                <i class="bi bi-x-circle"></i>
                                            </a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
