@model List<BLL.DTOs.Invoice.OutGoingData.InvoiceDto>
@using DAL.Enums
@{
    ViewData["Title"] = "سجل الفواتير";
    var selectedType = ViewBag.SelectedType as InvoiceType?;
    var selectedStatus = ViewBag.SelectedStatus as InvoiceStatus?;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4><i class="bi bi-receipt me-2"></i> سجل الفواتير</h4>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-lg me-1"></i> إنشاء فاتورة جديدة
    </a>
</div>

<!-- Filters -->
<div class="card shadow-sm mb-3">
    <div class="card-body py-3">
        <form method="get" asp-action="Index" id="invoiceFilterForm" class="row g-2 align-items-end">
            <div class="col-md-5">
                <label class="form-label small fw-semibold text-muted">نوع الفاتورة</label>
                <select name="type" class="form-select form-select-sm" onchange="this.form.submit()">
                    <option value="" selected="@(selectedType == null ? "selected" : null)">-- كل الأنواع --</option>
                    <option value="@((int)InvoiceType.VendorPurchase)" selected="@(selectedType == InvoiceType.VendorPurchase ? "selected" : null)">مشتريات من مورد</option>
                    <option value="@((int)InvoiceType.WholesaleSales)" selected="@(selectedType == InvoiceType.WholesaleSales ? "selected" : null)">مبيعات جملة</option>
                    <option value="@((int)InvoiceType.StoreCashSales)" selected="@(selectedType == InvoiceType.StoreCashSales ? "selected" : null)">مبيعات تجزئة نقدي</option>
                </select>
            </div>
            <div class="col-md-5">
                <label class="form-label small fw-semibold text-muted">حالة الفاتورة</label>
                <select name="status" class="form-select form-select-sm" onchange="this.form.submit()">
                    <option value="" selected="@(selectedStatus == null ? "selected" : null)">-- كل الحالات --</option>
                    <option value="@((int)InvoiceStatus.Draft)" selected="@(selectedStatus == InvoiceStatus.Draft ? "selected" : null)">مسودة</option>
                    <option value="@((int)InvoiceStatus.Posted)" selected="@(selectedStatus == InvoiceStatus.Posted ? "selected" : null)">مرحّلة</option>
                    <option value="@((int)InvoiceStatus.Cancelled)" selected="@(selectedStatus == InvoiceStatus.Cancelled ? "selected" : null)">ملغاة</option>
                </select>
            </div>
            <div class="col-md-2 d-flex gap-1">
                <a asp-action="Index" class="btn btn-sm btn-outline-secondary w-100" title="إعادة تعيين الفلاتر">
                    <i class="bi bi-arrow-clockwise me-1"></i> إعادة تعيين
                </a>
            </div>
        </form>
    </div>
</div>

<!-- Active Filter Indicator Bar -->
@if (selectedType != null || selectedStatus != null)
{
    <div class="alert alert-info py-2 px-3 d-flex align-items-center justify-content-between mb-3 shadow-sm">
        <div class="d-flex align-items-center flex-wrap gap-2">
            <i class="bi bi-funnel-fill text-primary"></i>
            <span class="small fw-bold">الفلتر المطبق حالياً:</span>

            @if (selectedType != null)
            {
                <span class="badge bg-primary fs-7">
                    النوع:
                    @(selectedType == InvoiceType.VendorPurchase ? "مشتريات من مورد" :
                      selectedType == InvoiceType.WholesaleSales ? "مبيعات جملة" : "مبيعات تجزئة نقدي")
                </span>
            }

            @if (selectedStatus != null)
            {
                <span class="badge bg-secondary fs-7">
                    الحالة:
                    @(selectedStatus == InvoiceStatus.Draft ? "مسودة" :
                      selectedStatus == InvoiceStatus.Posted ? "مرحّلة" : "ملغاة")
                </span>
            }
        </div>
        <a asp-action="Index" class="btn btn-sm btn-outline-dark py-0 px-2" title="إلغاء التصفية">
            <i class="bi bi-x-lg me-1"></i> إلغاء الفلتر
        </a>
    </div>
}

<!-- Invoices Table / Empty State -->
<div class="card shadow-sm">
    <div class="card-body">
        @if (Model.Count == 0)
        {
            <div class="text-center py-5">
                <i class="bi bi-inbox fs-1 text-muted d-block mb-3"></i>
                @if (selectedType != null)
                {
                    var typeName = selectedType == InvoiceType.VendorPurchase ? "مشتريات من مورد" :
                                   selectedType == InvoiceType.WholesaleSales ? "مبيعات جملة" : "مبيعات تجزئة نقدي";
                    <h5 class="fw-bold text-danger mb-2">لا يوجد فواتير من هذا النوع الآن (@typeName)</h5>
                    <p class="text-muted small mb-3">لم يتم تسجيل أي فواتير تحت تصنيف "@typeName" حتى هذه اللحظة.</p>
                    <div class="d-flex justify-content-center gap-2">
                        <a asp-action="Create" asp-route-type="@((int)selectedType)" class="btn btn-primary btn-sm">
                            <i class="bi bi-plus-lg me-1"></i> إنشاء فاتورة @typeName جديدة
                        </a>
                        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                            <i class="bi bi-arrow-clockwise me-1"></i> عرض كل الفواتير
                        </a>
                    </div>
                }
                else if (selectedStatus != null)
                {
                    var statusName = selectedStatus == InvoiceStatus.Draft ? "مسودة" :
                                     selectedStatus == InvoiceStatus.Posted ? "مرحّلة" : "ملغاة";
                    <h5 class="fw-bold text-secondary mb-2">لا توجد فواتير بحالة (@statusName) الآن</h5>
                    <p class="text-muted small mb-3">لا توجد فواتير مطابقة لحالة الفلتر المحددة.</p>
                    <div class="mt-3">
                        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                            <i class="bi bi-arrow-clockwise me-1"></i> عرض كل الفواتير
                        </a>
                    </div>
                }
                else
                {
                    <h5 class="fw-bold text-secondary mb-2">لا توجد فواتير مسجلة في النظام بعد</h5>
                    <p class="text-muted small mb-3">ابدأ بإنشاء أول فاتورة مبيعات أو مشتريات.</p>
                    <div class="mt-3">
                        <a asp-action="Create" class="btn btn-primary btn-sm">
                            <i class="bi bi-plus-lg me-1"></i> إنشاء أول فاتورة الآن
                        </a>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle text-center mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>رقم الفاتورة</th>
                            <th>النوع</th>
                            <th>التاريخ</th>
                            <th>الطرف (العميل / المورد)</th>
                            <th>الإجمالي</th>
                            <th>المدفوع</th>
                            <th>المتبقي</th>
                            <th>حالة السداد</th>
                            <th>الحالة</th>
                            <th>إجراءات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var inv in Model)
                        {
                            <tr>
                                <td class="fw-bold font-monospace">
                                    @if (!string.IsNullOrEmpty(inv.InvoiceNumber))
                                    {
                                        <span>@inv.InvoiceNumber</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">مسودة #@inv.Id</span>
                                    }
                                </td>
                                <td>
                                    @switch (inv.Type)
                                    {
                                        case InvoiceType.VendorPurchase:
                                            <span class="badge bg-secondary-subtle text-secondary border">
                                                <i class="bi bi-cart-plus me-1"></i> مشتريات مورد
                                            </span>
                                            break;
                                        case InvoiceType.WholesaleSales:
                                            <span class="badge bg-primary-subtle text-primary border">
                                                <i class="bi bi-receipt me-1"></i> مبيعات جملة
                                            </span>
                                            break;
                                        case InvoiceType.StoreCashSales:
                                            <span class="badge bg-info-subtle text-info border">
                                                <i class="bi bi-shop me-1"></i> تجزئة نقدي
                                            </span>
                                            break;
                                    }
                                </td>
                                <td>@inv.TransactionDate.ToString("yyyy/MM/dd")</td>
                                <td>
                                    @if (inv.Type == InvoiceType.VendorPurchase)
                                    {
                                        <span class="fw-semibold">@(inv.VendorName ?? "-")</span>
                                    }
                                    else if (inv.Type == InvoiceType.WholesaleSales)
                                    {
                                        <span class="fw-semibold">@(inv.CustomerName ?? "-")</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">مبيعات نقدية</span>
                                    }
                                </td>
                                <td class="fw-bold">@inv.TotalAmount.ToString("N2")</td>
                                <td class="text-success">@inv.PaidAmount.ToString("N2")</td>
                                <td class="@(inv.RemainingBalance > 0 ? "text-danger fw-bold" : "text-muted")">
                                    @inv.RemainingBalance.ToString("N2")
                                </td>
                                <td>
                                    @switch (inv.PaymentStatus)
                                    {
                                        case InvoicePaymentStatus.Paid:
                                            <span class="badge bg-success-subtle text-success border border-success">
                                                مسددة بالكامل
                                            </span>
                                            break;
                                        case InvoicePaymentStatus.PartiallyPaid:
                                            <span class="badge bg-warning-subtle text-warning-emphasis border border-warning">
                                                مسددة جزئياً
                                            </span>
                                            break;
                                        case InvoicePaymentStatus.Unpaid:
                                            <span class="badge bg-danger-subtle text-danger border border-danger">
                                                غير مسددة
                                            </span>
                                            break;
                                    }
                                </td>
                                <td>
                                    @switch (inv.Status)
                                    {
                                        case InvoiceStatus.Draft:
                                            <span class="badge bg-warning text-dark">مسودة</span>
                                            break;
                                        case InvoiceStatus.Posted:
                                            <span class="badge bg-success">مرحّلة</span>
                                            break;
                                        case InvoiceStatus.Cancelled:
                                            <span class="badge bg-secondary">ملغاة</span>
                                            break;
                                    }
                                </td>
                                <td>
                                    <div class="btn-group btn-group-sm">
                                        <a asp-action="Details" asp-route-id="@inv.Id" class="btn btn-outline-info" title="عرض التفاصيل">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        @if (inv.Status == InvoiceStatus.Posted && inv.PaidAmount == 0)
                                        {
                                            <a asp-action="Cancel" asp-route-id="@inv.Id" class="btn btn-outline-danger" title="إلغاء الفاتورة">
                                                <i class="bi bi-x-circle"></i>
                                            </a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
