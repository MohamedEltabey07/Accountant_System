@model List<BLL.DTOs.Product.OutGoingData.ProductDto>
@{
    ViewData["Title"] = "دليل المنتجات";
    var currentStatus = ViewBag.Status as string ?? "active";
}

<!-- Page Header -->
<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
    <div>
        <h3 class="fw-bold mb-1">
            <i class="bi bi-box-seam text-primary me-2"></i> دليل المنتجات والأسعار
        </h3>
        <p class="text-muted mb-0">إدارة قائمة الأصناف، أسعار الشراء، أسعار بيع الجملة والتجزئة</p>
    </div>
    <div class="d-flex gap-2">
        <button type="button" class="btn btn-outline-success shadow-sm" onclick="exportTableToCSV('productTable', 'دليل_المنتجات')">
            <i class="bi bi-file-earmark-excel me-1"></i> تصدير Excel
        </button>
        <a asp-action="Create" class="btn btn-primary shadow-sm fw-bold">
            <i class="bi bi-plus-lg me-1"></i> صنف جديد
        </a>
    </div>
</div>

<!-- Search & Live Counter Toolbar -->
<div class="card shadow-sm border-0 mb-3">
    <div class="card-body p-3">
        <div class="row align-items-center g-2">
            <div class="col-md-5">
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                    <input type="text" class="form-control border-start-0" placeholder="بحث فوري باسم الصنف أو الكود..." data-table-search="productTable" data-counter-target="productCounter" />
                </div>
            </div>
            <div class="col-md-7 d-flex flex-wrap align-items-md-start gap-3">
                <!-- Active Status Filter (backend-filtered via ?status=) -->
                <div class="btn-group btn-group-sm" role="group" aria-label="فلتر حالة الصنف">
                    <a asp-action="Index" asp-route-status="active" class="btn @(currentStatus == "active" ? "btn-primary" : "btn-outline-primary")">
                        نشط
                    </a>
                    <a asp-action="Index" asp-route-status="inactive" class="btn @(currentStatus == "inactive" ? "btn-secondary" : "btn-outline-secondary")">
                        غير نشط
                    </a>
                    <a asp-action="Index" asp-route-status="all" class="btn @(currentStatus == "all" ? "btn-dark" : "btn-outline-dark")">
                        الكل
                    </a>
                </div>
                <span class="badge bg-light text-dark border p-2 font-tabular" id="productCounter">
                    عرض @Model.Count من إجمالي @Model.Count صنف
                </span>
            </div>
        </div>
    </div>
</div>

<!-- Products Table Card -->
<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        @if (Model.Count == 0)
        {
            <div class="text-center text-muted py-5">
                <i class="bi bi-box-seam fs-1 d-block mb-3 text-secondary"></i>
                <h5 class="fw-bold text-dark">لا توجد منتجات مسجلة بعد</h5>
                <p class="text-muted small">ابدأ بإضافة أول صنف لتتمكن من إنشاء فواتير المبيعات والمشتريات.</p>
                <a asp-action="Create" class="btn btn-primary btn-sm mt-2">
                    <i class="bi bi-plus-lg me-1"></i> إضافة صنف جديد
                </a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-modern align-middle text-center mb-0" id="productTable">
                    <thead>
                        <tr>
                            <th style="width: 50px;">#</th>
                            <th class="text-start">اسم الصنف / المنتج</th>
                            <th>سعر الشراء</th>
                            <th>سعر بيع الجملة</th>
                            <th>سعر بيع التجزئة (كاش)</th>
                            <th style="width: 90px;">الحالة</th>
                            <th class="no-export">الإجراءات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var product in Model)
                        {
                            <tr>
                                <td class="text-muted fw-bold font-tabular">@product.Id</td>
                                <td class="text-start">
                                    <div class="fw-bold text-dark fs-6">@product.Name</div>
                                    <small class="text-muted">كود: #PRD-@product.Id.ToString("D4")</small>
                                </td>
                                <td class="font-tabular fw-semibold text-secondary">@product.PurchasePrice.ToString("N2") ج.م</td>
                                <td class="font-tabular fw-bold text-primary">@product.WholesalePrice.ToString("N2") ج.م</td>
                                <td class="font-tabular fw-bold text-success">@product.RetailPrice.ToString("N2") ج.م</td>
                                <td>
                                    @if (product.IsActive)
                                    {
                                        <span class="badge bg-success-subtle text-success-emphasis border border-success-subtle">
                                            <i class="bi bi-check-circle me-1"></i>نشط
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary-emphasis border border-secondary-subtle">
                                            <i class="bi bi-slash-circle me-1"></i>غير نشط
                                        </span>
                                    }
                                </td>
                                <td class="no-export">
                                    <div class="btn-group btn-group-sm">
                                        <a asp-action="Details" asp-route-id="@product.Id" class="btn btn-outline-info" title="تفاصيل الصنف">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@product.Id" class="btn btn-outline-warning" title="تعديل الأسعار">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <form asp-action="ToggleStatus" asp-route-id="@product.Id" method="post" class="d-inline">
                                            <button type="submit" class="btn btn-outline-secondary" title="تغيير الحالة النشطة">
                                                <i class="bi bi-arrow-repeat"></i>
                                            </button>
                                        </form>
                                        <form asp-action="Delete" asp-route-id="@product.Id" method="post" class="d-inline">
                                            <button type="button" class="btn btn-outline-danger" title="إلغاء التنشيط" data-confirm="هل تريد إلغاء تنشيط الصنف (@product.Name)؟">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
