@model BLL.DTOs.Product.InComingData.CreateProductDto
@{
    ViewData["Title"] = "منتج جديد";
}

<h4 class="mb-3"><i class="bi bi-plus-lg me-2"></i> منتج جديد</h4>

<div class="card shadow-sm">
    <div class="card-body">
        <div asp-validation-summary="All" class="text-danger mb-3"></div>

        <form asp-action="Create" method="post">
            <div class="mb-3">
                <label asp-for="Name" class="form-label">اسم المنتج</label>
                <input asp-for="Name" class="form-control" placeholder="أدخل اسم المنتج" />
                <span asp-validation-for="Name" class="text-danger small"></span>
            </div>

            <div class="row">
                <div class="col-md-4 mb-3">
                    <label asp-for="PurchasePrice" class="form-label">سعر الشراء</label>
                    <input asp-for="PurchasePrice" class="form-control" type="number" step="0.01" />
                    <span asp-validation-for="PurchasePrice" class="text-danger small"></span>
                </div>
                <div class="col-md-4 mb-3">
                    <label asp-for="WholesalePrice" class="form-label">سعر الجملة</label>
                    <input asp-for="WholesalePrice" class="form-control" type="number" step="0.01" />
                    <span asp-validation-for="WholesalePrice" class="text-danger small"></span>
                </div>
                <div class="col-md-4 mb-3">
                    <label asp-for="RetailPrice" class="form-label">سعر التجزئة</label>
                    <input asp-for="RetailPrice" class="form-control" type="number" step="0.01" />
                    <span asp-validation-for="RetailPrice" class="text-danger small"></span>
                </div>
            </div>

            <div class="row">
                <div class="col-md-12 mb-3">
                    <label asp-for="Category" class="form-label fw-bold">تصنيف المنتج / النشاط</label>
                    <select asp-for="Category" class="form-select form-select-lg" id="productCategory">
                        <option value="@((int)DAL.Enums.ProductCategory.RegularProduct)">منتج عادي (غير متتبع بمخزون الثلاجات)</option>
                        <option value="@((int)DAL.Enums.ProductCategory.FrozenFish)">سمك مجمد (متابعة مخزون الثلاجات وأوامر التوريد الملاحي)</option>
                    </select>
                    <span asp-validation-for="Category" class="text-danger small"></span>
                    <div class="form-text">الأصناف المجمدة تُتابع في الثلاجات بالكراتين والكيلوجرام، وتُستخدم في أوامر التوريد للشركات البحرية.</div>
                </div>
            </div>

            <div class="row p-3 rounded-3 mb-3 bg-light border" id="frozenFishFieldsRow" style="display:none;">
                <div class="col-12 mb-2">
                    <strong class="text-primary"><i class="bi bi-thermometer-snow me-1"></i> إعدادات الأسماك المجمدة والتوريد الملاحي:</strong>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="DefaultCartonWeightKg" class="form-label fw-bold">وزن الكرتونة الافتراضي (كجم) <span class="text-danger">*</span></label>
                    <input asp-for="DefaultCartonWeightKg" class="form-control font-tabular" type="number" step="0.001" min="0.001" id="cartonWeightField" placeholder="مثال: 10 أو 20" />
                    <span asp-validation-for="DefaultCartonWeightKg" class="text-danger small"></span>
                    <div class="form-text">الوزن القياسي للكرتونة الواحدة؛ يُستخدم في حساب إجمالي الأوزان عند الاستلام أو التوريد.</div>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="MaritimePricePerKg" class="form-label fw-bold">سعر الكجم للشركات البحرية (اختياري)</label>
                    <input asp-for="MaritimePricePerKg" class="form-control font-tabular" type="number" step="0.01" min="0" placeholder="اتركه فارغاً إن لم يُحدد" />
                    <span asp-validation-for="MaritimePricePerKg" class="text-danger small"></span>
                    <div class="form-text">السعر الافتراضي لكل كجم عند إنشاء أمر توريد لشركة بحرية.</div>
                </div>
            </div>

            <button type="submit" class="btn btn-primary px-4 fw-bold">
                <i class="bi bi-check-lg me-1"></i> حفظ المنتج
            </button>
            <a asp-action="Index" class="btn btn-outline-secondary">رجوع</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function toggleFrozenFields() {
            var cat = document.getElementById('productCategory').value;
            var row = document.getElementById('frozenFishFieldsRow');
            var weightInput = document.getElementById('cartonWeightField');
            if (cat === "@((int)DAL.Enums.ProductCategory.FrozenFish)") {
                row.style.display = 'flex';
                weightInput.setAttribute('required', 'required');
            } else {
                row.style.display = 'none';
                weightInput.removeAttribute('required');
            }
        }
        document.getElementById('productCategory').addEventListener('change', toggleFrozenFields);
        toggleFrozenFields();
    </script>
}
