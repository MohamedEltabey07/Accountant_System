@model BLL.DTOs.Vendor.OutGoingData.VendorDto
@using Accountant_sys.Models
@{
    ViewData["Title"] = "تفاصيل المورد - " + Model.Name;
    var summary = ViewBag.StatementSummary as StatementViewModel;
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
    <h4 class="mb-0"><i class="bi bi-truck me-2 text-primary"></i> تفاصيل المورد: <span class="text-primary">@Model.Name</span></h4>
    <div class="d-flex flex-wrap gap-2">
        <a asp-action="Statement" asp-route-id="@Model.Id" asp-route-mode="detailed" class="btn btn-primary btn-sm fw-bold">
            <i class="bi bi-card-text me-1"></i> كشف الحساب التفصيلي
        </a>
        <a asp-action="Statement" asp-route-id="@Model.Id" asp-route-mode="summary" class="btn btn-outline-primary btn-sm">
            <i class="bi bi-list-columns-reverse me-1"></i> كشف الحساب الموجز
        </a>
        <a asp-controller="Payment" asp-action="VendorPayment" asp-route-vendorId="@Model.Id" class="btn btn-danger btn-sm fw-bold">
            <i class="bi bi-wallet2 me-1"></i> تسجيل دفعة (سند صرف)
        </a>
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning btn-sm">
            <i class="bi bi-pencil me-1"></i> تعديل
        </a>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-right me-1"></i> رجوع للقائمة
        </a>
    </div>
</div>

@if (summary != null)
{
    <!-- Clear Money-Flow Cards -->
    <div class="row g-3 mb-3">
        <div class="col-md-4">
            <div class="card shadow-sm border-0 border-start border-danger border-4 h-100">
                <div class="card-body py-3">
                    <small class="text-muted d-block">إجمالي المستحق للمورد (مشتريات + افتتاحي)</small>
                    <h4 class="fw-bold text-danger font-tabular mb-1">+@summary.TotalAdditions.ToString("N2") <small class="fs-6 text-muted">ج.م</small></h4>
                    <small class="text-muted">فواتير مشتريات: @summary.TotalInvoices.ToString("N2") | افتتاحي: @summary.TotalOpening.ToString("N2")</small>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow-sm border-0 border-start border-success border-4 h-100">
                <div class="card-body py-3">
                    <small class="text-muted d-block">إجمالي ما دفعناه للمورد + المرتجعات</small>
                    <h4 class="fw-bold text-success font-tabular mb-1">-@summary.TotalDeductions.ToString("N2") <small class="fs-6 text-muted">ج.م</small></h4>
                    <small class="text-muted">مدفوعات نقدية: @summary.TotalPayments.ToString("N2") | مرتجعات: @summary.TotalReturns.ToString("N2")</small>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow-sm border-0 border-start border-dark border-4 h-100">
                <div class="card-body py-3">
                    <small class="text-muted d-block">الرصيد المتبقي الحالي</small>
                    <h4 class="fw-bold font-tabular mb-1 @(Model.CurrentBalance > 0 ? "text-danger" : (Model.CurrentBalance < 0 ? "text-info" : "text-success"))">
                        @Math.Abs(Model.CurrentBalance).ToString("N2") <small class="fs-6 text-muted">ج.م</small>
                    </h4>
                    <small class="fw-bold @(Model.CurrentBalance > 0 ? "text-danger" : (Model.CurrentBalance < 0 ? "text-info" : "text-success"))">
                        @(Model.CurrentBalance > 0 ? "مستحق للمورد (علينا دفعه)" : (Model.CurrentBalance < 0 ? "رصيد لنا عند المورد (مدفوع مقدماً)" : "الحساب خالص ومسدد"))
                    </small>
                </div>
            </div>
        </div>
    </div>
}

<div class="row g-3 mb-4">
    <!-- Basic Info Card -->
    <div class="col-lg-7">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-white py-3">
                <h5 class="card-title mb-0 text-primary">
                    <i class="bi bi-info-circle me-1"></i> البيانات الأساسية ومعلومات الاتصال
                </h5>
            </div>
            <div class="card-body">
                <dl class="row mb-0 gy-3">
                    <dt class="col-sm-4 text-muted">كود المورد</dt>
                    <dd class="col-sm-8 fw-semibold">#VND-@Model.Id.ToString("D4")</dd>

                    <dt class="col-sm-4 text-muted">اسم المورد</dt>
                    <dd class="col-sm-8 fw-bold fs-5">@Model.Name</dd>

                    <dt class="col-sm-4 text-muted">رقم الهاتف</dt>
                    <dd class="col-sm-8">
                        @if (!string.IsNullOrEmpty(Model.PhoneNumber))
                        {
                            <a href="tel:@Model.PhoneNumber" class="text-decoration-none">
                                <i class="bi bi-telephone me-1"></i> @Model.PhoneNumber
                            </a>
                        }
                        else
                        {
                            <span class="text-muted">غير مسجل</span>
                        }
                    </dd>

                    <dt class="col-sm-4 text-muted">العنوان</dt>
                    <dd class="col-sm-8">@(string.IsNullOrEmpty(Model.Address) ? "غير مسجل" : Model.Address)</dd>

                    <dt class="col-sm-4 text-muted">الحالة</dt>
                    <dd class="col-sm-8">
                        @if (Model.IsActive)
                        {
                            <span class="badge bg-success-subtle text-success border border-success px-2 py-1">
                                <i class="bi bi-check-circle me-1"></i> نشط
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-secondary-subtle text-secondary border border-secondary px-2 py-1">
                                <i class="bi bi-slash-circle me-1"></i> غير نشط
                            </span>
                        }
                    </dd>

                    <dt class="col-sm-4 text-muted">تاريخ التسجيل</dt>
                    <dd class="col-sm-8">@Model.CreatedAt.ToString("yyyy/MM/dd - hh:mm tt")</dd>
                </dl>
            </div>
        </div>
    </div>

    <!-- Financial Balance Card -->
    <div class="col-lg-5">
        <div class="card shadow-sm h-100 border-0">
            <div class="card-body p-4 text-center d-flex flex-column justify-content-between rounded @(Model.CurrentBalance > 0 ? "bg-danger-subtle text-danger-emphasis border border-danger" : (Model.CurrentBalance < 0 ? "bg-info-subtle text-info-emphasis border border-info" : "bg-success-subtle text-success-emphasis border border-success"))">
                <div>
                    <div class="fs-1 mb-2">
                        @if (Model.CurrentBalance > 0)
                        {
                            <i class="bi bi-exclamation-triangle text-danger"></i>
                        }
                        else if (Model.CurrentBalance < 0)
                        {
                            <i class="bi bi-arrow-down-left-circle text-info"></i>
                        }
                        else
                        {
                            <i class="bi bi-check2-circle text-success"></i>
                        }
                    </div>
                    <h5 class="fw-bold mb-1">صافي رصيد المورد</h5>
                    <small class="text-muted d-block mb-3">فواتير المشتريات + الافتتاحي - ما دفعناه والمرتجعات</small>

                    <div class="display-6 fw-bold mb-2">
                        @Math.Abs(Model.CurrentBalance).ToString("N2") <small class="fs-6">ج.م</small>
                    </div>

                    <div>
                        @if (Model.CurrentBalance > 0)
                        {
                            <span class="badge bg-danger fs-6 px-3 py-2">
                                <i class="bi bi-arrow-up-right me-1"></i> مستحق للمورد (علينا دفعه)
                            </span>
                        }
                        else if (Model.CurrentBalance < 0)
                        {
                            <span class="badge bg-info text-dark fs-6 px-3 py-2">
                                <i class="bi bi-arrow-down-left me-1"></i> رصيد لنا عند المورد (مدفوع مقدماً)
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-success fs-6 px-3 py-2">
                                <i class="bi bi-check-lg me-1"></i> الرصيد مسوّى تماماً (0.00 ج.م)
                            </span>
                        }
                    </div>
                </div>

                <div class="mt-4 pt-3 border-top border-white-50">
                    <a asp-controller="Invoice" asp-action="Create" asp-route-type="1" asp-route-vendorId="@Model.Id" class="btn btn-outline-dark btn-sm w-100 mb-2">
                        <i class="bi bi-plus-circle me-1"></i> إنشاء فاتورة مشتريات جديدة
                    </a>
                    <a asp-controller="Invoice" asp-action="Index" asp-route-type="VendorPurchase" class="btn btn-link btn-sm text-decoration-none">
                        <i class="bi bi-cart-check me-1"></i> استعراض فواتير المشتريات
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@if (summary != null && summary.Lines.Any())
{
    <div class="card shadow-sm border-0">
        <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
            <h5 class="card-title mb-0 fw-bold text-dark">
                <i class="bi bi-arrow-left-right text-primary me-1"></i> تسلسل حركات الحساب (الفواتير والمدفوعات)
            </h5>
            <a asp-action="Statement" asp-route-id="@Model.Id" asp-route-mode="detailed" class="btn btn-outline-primary btn-sm">
                فتح الكشف التفصيلي الكامل <i class="bi bi-arrow-left ms-1"></i>
            </a>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle text-center mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>التاريخ</th>
                            <th>العملية</th>
                            <th class="text-start">تفاصيل الحركة</th>
                            <th>رقم المستند</th>
                            <th>علينا (مشتريات +)</th>
                            <th>المدفوع للمورد (-)</th>
                            <th>المتبقي بعد الحركة</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var line in summary.Lines.TakeLast(15))
                        {
                            <tr>
                                <td class="font-tabular">@line.Date.ToString("yyyy-MM-dd")</td>
                                <td><span class="badge bg-light text-dark border">@line.DocumentType</span></td>
                                <td class="text-start small">@(string.IsNullOrWhiteSpace(line.Description) ? line.DocumentType : line.Description)</td>
                                <td class="font-monospace fw-bold">@line.DocumentNo</td>
                                <td class="font-tabular @(line.Credit > 0 ? "text-danger fw-bold" : "text-muted")">@(line.Credit > 0 ? "+" + line.Credit.ToString("N2") : "-")</td>
                                <td class="font-tabular @(line.Debit > 0 ? "text-success fw-bold" : "text-muted")">@(line.Debit > 0 ? "-" + line.Debit.ToString("N2") : "-")</td>
                                <td class="font-tabular fw-bold">
                                    @Math.Abs(line.RunningBalance).ToString("N2")
                                    <small class="text-muted fw-normal">@(Math.Abs(line.RunningBalance) < 0.005m ? "(خالص)" : (line.RunningBalance > 0 ? "(علينا)" : "(لنا)"))</small>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}
