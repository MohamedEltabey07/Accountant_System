@model List<BLL.DTOs.Vendor.OutGoingData.VendorDto>
@{
    ViewData["Title"] = "الموردين";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4><i class="bi bi-truck me-2"></i> الموردين</h4>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-lg me-1"></i> مورد جديد
    </a>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        @if (Model.Count == 0)
        {
            <div class="text-center text-muted py-5">
                <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                <p class="fs-5 mb-1">لا يوجد موردين مسجلين بعد.</p>
                <small>أضف أول مورد لتبدأ في تسجيل فواتير المشتريات.</small>
                <div class="mt-3">
                    <a asp-action="Create" class="btn btn-outline-primary btn-sm">
                        <i class="bi bi-plus-lg me-1"></i> إضافة مورد الآن
                    </a>
                </div>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle text-center mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>#</th>
                            <th>اسم المورد</th>
                            <th>رقم الهاتف</th>
                            <th>العنوان</th>
                            <th>الرصيد المستحق</th>
                            <th>الحالة</th>
                            <th>إجراءات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var vendor in Model)
                        {
                            <tr>
                                <td>@vendor.Id</td>
                                <td class="fw-bold">@vendor.Name</td>
                                <td>
                                    @if (!string.IsNullOrEmpty(vendor.PhoneNumber))
                                    {
                                        <a href="tel:@vendor.PhoneNumber" class="text-decoration-none text-dark">
                                            <i class="bi bi-telephone text-muted me-1"></i>@vendor.PhoneNumber
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td>@(string.IsNullOrEmpty(vendor.Address) ? "-" : vendor.Address)</td>
                                <td>
                                    @if (vendor.CurrentBalance > 0)
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger fs-6 px-2 py-1">
                                            @vendor.CurrentBalance.ToString("N2") ج.م
                                            <i class="bi bi-arrow-up-right small"></i>
                                        </span>
                                    }
                                    else if (vendor.CurrentBalance < 0)
                                    {
                                        <span class="badge bg-info-subtle text-info border border-info fs-6 px-2 py-1">
                                            @vendor.CurrentBalance.ToString("N2") ج.م
                                            <i class="bi bi-arrow-down-left small"></i>
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success fs-6 px-2 py-1">
                                            0.00 ج.م
                                        </span>
                                    }
                                </td>
                                <td>
                                    @if (vendor.IsActive)
                                    {
                                        <span class="badge bg-success-subtle text-success">نشط</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary">معطل</span>
                                    }
                                </td>
                                <td>
                                    <div class="btn-group btn-group-sm">
                                        <a asp-action="Details" asp-route-id="@vendor.Id" class="btn btn-outline-info" title="تفاصيل ورصيد">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@vendor.Id" class="btn btn-outline-warning" title="تعديل">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <form asp-action="ToggleStatus" asp-route-id="@vendor.Id" method="post" class="d-inline">
                                            <button type="submit" class="btn btn-outline-secondary" title="تغيير الحالة (نشط/معطل)">
                                                <i class="bi bi-arrow-repeat"></i>
                                            </button>
                                        </form>
                                        <form asp-action="Delete" asp-route-id="@vendor.Id" method="post" class="d-inline"
                                              onsubmit="return confirm('هل أنت متأكد من إلغاء تنشيط هذا المورد؟');">
                                            <button type="submit" class="btn btn-outline-danger" title="إلغاء التنشيط">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
