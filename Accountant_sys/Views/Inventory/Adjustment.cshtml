@model BLL.DTOs.Inventory.InComingData.CreateStockAdjustmentDto
@{
    ViewData["Title"] = "تسوية جرد المخزون";
    var balances = ViewBag.Balances as Dictionary<int, BLL.DTOs.Inventory.OutGoingData.StockBalanceDto> ?? new();
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h4 class="fw-bold mb-1"><i class="bi bi-sliders text-warning me-2"></i> تسوية الجرد الفعلي لمخزون الثلاجات</h4>
        <p class="text-muted small mb-0">مطابقة الأرصدة الدفترية مع الجرد الفعلي في العنابر والثلاجات مع توثيق السبب المالي</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-right me-1"></i> رجوع للمخزون
    </a>
</div>

<div class="alert alert-warning py-2 px-3 d-flex align-items-center gap-2 mb-3 border-0 bg-warning-subtle text-warning-emphasis">
    <i class="bi bi-exclamation-triangle-fill fs-5"></i>
    <div class="small">
        استخدم التسوية لتصحيح الفروق المكتشفة عند الجرد الفعلي. كل تسوية تُسجل في سجل حركة المخزون باسم المستخدم والسبب ولا يمكن التراجع عنها إلا بتسوية مقابلة.
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white py-3 border-bottom">
                <h5 class="card-title mb-0 text-primary fw-bold">
                    <i class="bi bi-pencil-square me-1"></i> إذن تسوية الرصيد
                </h5>
            </div>
            <div class="card-body p-4">
                <div asp-validation-summary="All" class="text-danger mb-3"></div>

                <form asp-action="Adjustment" method="post" id="adjustmentForm">
                    <div class="mb-3">
                        <label asp-for="ProductId" class="form-label fw-bold">صنف السمك المجمد <span class="text-danger">*</span></label>
                        <select asp-for="ProductId" class="form-select form-select-lg" id="stockAdjProduct">
                            <option value="">-- اختر صنف السمك المراد تسويته --</option>
                            @foreach (var (id, balance) in balances.OrderBy(b => b.Value.ProductName))
                            {
                                <option value="@id"
                                        data-available-kg="@balance.AvailableKg.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                        data-available-cartons="@balance.AvailableCartons.ToString(System.Globalization.CultureInfo.InvariantCulture)">
                                    @balance.ProductName — الحالي: @balance.AvailableKg.ToString("N3") كجم (@balance.AvailableCartons.ToString("N2") كرتونة)
                                </option>
                            }
                        </select>
                        <span asp-validation-for="ProductId" class="text-danger small"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label asp-for="MovementDate" class="form-label fw-bold">تاريخ التسوية <span class="text-danger">*</span></label>
                            <input asp-for="MovementDate" type="date" class="form-control" value="@Model.MovementDate.ToString("yyyy-MM-dd")" />
                            <span asp-validation-for="MovementDate" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label asp-for="CartonsAdjustment" class="form-label fw-bold">تسوية الكراتين (±)</label>
                            <input asp-for="CartonsAdjustment" type="number" step="0.001" class="form-control" id="adjCartons" placeholder="مثال: -50 أو 25" />
                            <span asp-validation-for="CartonsAdjustment" class="text-danger small"></span>
                            <div class="form-text small">قيمة سالبة للنقص وموجبة للزيادة.</div>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label fw-bold">تسوية الوزن (كجم) (±)</label>
                            <input asp-for="WeightKgAdjustment" type="number" step="0.001" class="form-control" id="adjWeight" placeholder="مثال: -120 أو 80" />
                            <span asp-validation-for="WeightKgAdjustment" class="text-danger small"></span>
                            <div class="form-text small">قيمة سالبة للنقص وموجبة للزيادة.</div>
                        </div>
                    </div>

                    <!-- Live Expected Balance After Adjustment -->
                    <div class="alert alert-secondary py-2 px-3 mb-3 border-0 bg-light text-dark">
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="fw-bold"><i class="bi bi-arrow-repeat me-1"></i> الرصيد المتوقع بعد التسوية:</span>
                            <strong id="expectedBalancePreview" class="font-tabular fs-5 text-primary">-</strong>
                        </div>
                    </div>

                    <!-- Warning if negative -->
                    <div class="alert alert-danger py-2 px-3 d-none mb-3 border-0" id="adjWarningBox">
                        <i class="bi bi-exclamation-octagon-fill me-1"></i>
                        <span id="adjWarningText"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Reason" class="form-label fw-bold">سبب التسوية <span class="text-danger">*</span></label>
                        <input asp-for="Reason" class="form-control" placeholder="مثال: تسوية فروق الجرد الفعلي لشهر ... / هالك تجميد" />
                        <span asp-validation-for="Reason" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Notes" class="form-label fw-bold">ملاحظات إضافية</label>
                        <textarea asp-for="Notes" class="form-control" rows="2" placeholder="ملاحظات المعتمد أو أمين المخزن..."></textarea>
                        <span asp-validation-for="Notes" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            <i class="bi bi-x-lg me-1"></i> إلغاء
                        </a>
                        <button type="submit" class="btn btn-warning px-4 fw-bold shadow-sm" id="adjSubmitBtn">
                            <i class="bi bi-check-lg me-1"></i> تسجيل التسوية
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            const product = document.getElementById('stockAdjProduct');
            const adjCartons = document.getElementById('adjCartons');
            const adjWeight = document.getElementById('adjWeight');
            const preview = document.getElementById('expectedBalancePreview');
            const warningBox = document.getElementById('adjWarningBox');
            const warningText = document.getElementById('adjWarningText');
            const submitBtn = document.getElementById('adjSubmitBtn');

            function update() {
                const opt = product.selectedOptions[0];
                const curKg = opt && opt.dataset.availableKg ? parseFloat(opt.dataset.availableKg) : 0;
                const curCartons = opt && opt.dataset.availableCartons ? parseFloat(opt.dataset.availableCartons) : 0;

                const cAdj = parseFloat(adjCartons.value) || 0;
                const wAdj = parseFloat(adjWeight.value) || 0;

                if (opt && opt.value) {
                    const newKg = curKg + wAdj;
                    const newCartons = curCartons + cAdj;

                    preview.textContent = newKg.toLocaleString('en-US', { minimumFractionDigits: 3, maximumFractionDigits: 3 }) + ' كجم (' + newCartons.toLocaleString('en-US', { maximumFractionDigits: 2 }) + ' كرتونة)';

                    if (newKg < 0 || newCartons < 0) {
                        warningBox.classList.remove('d-none');
                        warningText.textContent = `تنبيه: التسوية ستجعل الرصيد سالباً (${newKg.toFixed(3)} كجم / ${newCartons.toFixed(2)} كرتونة) وهو غير مسموح به!`;
                        submitBtn.classList.add('btn-secondary');
                        submitBtn.classList.remove('btn-warning');
                    } else {
                        warningBox.classList.add('d-none');
                        submitBtn.classList.remove('btn-secondary');
                        submitBtn.classList.add('btn-warning');
                    }
                } else {
                    preview.textContent = '-';
                    warningBox.classList.add('d-none');
                }
            }

            product.addEventListener('change', update);
            adjCartons.addEventListener('input', update);
            adjWeight.addEventListener('input', update);
            update();
        })();
    </script>
}
