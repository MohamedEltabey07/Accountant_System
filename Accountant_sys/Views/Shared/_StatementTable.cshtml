@model Accountant_sys.Models.StatementViewModel
@using System.Globalization
@using BLL.Service

<style>
    /* ==========================================================================
       Practical & High-Density A4 Statement Styles (Work-Ready)
       ========================================================================== */
    @@page {
        size: A4 portrait;
        margin: 0 !important; /* Removes browser default headers (title/date) and footers (URL link) */
    }

    .statement-sheet {
        background: #ffffff;
        border-radius: 12px;
        box-shadow: 0 2px 12px rgba(0, 0, 0, 0.04);
        border: 1px solid #e2e8f0;
        padding: 1.25rem;
    }

    /* Compact Header Bar */
    .statement-header-box {
        border: 1px solid #cbd5e1;
        border-radius: 8px;
        background: #f8fafc;
        padding: 0.65rem 0.85rem;
        margin-bottom: 0.65rem;
    }

    /* Compact 1-Line Financial Summary Strip */
    .statement-summary-strip {
        border: 1px solid #cbd5e1;
        border-radius: 8px;
        background: #ffffff;
        margin-bottom: 0.75rem;
        overflow: hidden;
    }

    .summary-strip-col {
        padding: 0.45rem 0.65rem;
        border-left: 1px solid #e2e8f0;
        text-align: center;
    }

    .summary-strip-col:last-child {
        border-left: none;
    }

    /* High-Density Work Table */
    .table-statement {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.84rem;
    }

    .table-statement thead {
        display: table-header-group; /* Repeats table header across multiple printed A4 pages */
    }

    .table-statement th {
        background-color: #1e293b !important;
        color: #ffffff !important;
        font-weight: 700;
        font-size: 0.80rem;
        padding: 0.45rem 0.5rem;
        border: 1px solid #1e293b;
        text-align: center;
        vertical-align: middle;
        white-space: nowrap;
    }

    .table-statement td {
        padding: 0.38rem 0.5rem;
        border: 1px solid #cbd5e1;
        vertical-align: middle;
        line-height: 1.3;
    }

    .table-statement tfoot td {
        background-color: #f1f5f9 !important;
        font-weight: 700;
        padding: 0.40rem 0.5rem;
        border: 1px solid #cbd5e1;
    }

    /* Refined compact status pill that fits neatly within rows without border interference */
    .status-pill {
        display: inline-block;
        font-size: 0.74rem;
        line-height: 1.1;
        padding: 2px 7px;
        border-radius: 4px;
        font-weight: 600;
        vertical-align: middle;
        white-space: nowrap;
        border: 1px solid transparent;
        box-sizing: border-box;
    }

    .status-pill-opening {
        background-color: #f1f5f9;
        color: #334155;
        border-color: #cbd5e1;
    }

    .status-pill-receipt {
        background-color: #ecfdf5;
        color: #065f46;
        border-color: #a7f3d0;
    }

    .status-pill-invoice {
        background-color: #f0f9ff;
        color: #0369a1;
        border-color: #bae6fd;
    }

    .status-pill-return {
        background-color: #fffbeb;
        color: #92400e;
        border-color: #fde68a;
    }

    .status-pill-disbursement {
        background-color: #fef2f2;
        color: #991b1b;
        border-color: #fecaca;
    }

    /* Print Specific Overrides — Maximum rows per page */
    @@media print {
        html, body {
            background: #ffffff !important;
            color: #000000 !important;
            margin: 0 !important;
            padding: 0 !important;
            font-size: 9.5pt !important;
            -webkit-print-color-adjust: exact !important;
            print-color-adjust: exact !important;
        }

        .d-print-none,
        .sidebar,
        .top-navbar,
        header,
        .btn,
        .alert,
        .form-control {
            display: none !important;
        }

        .main-content,
        .content-area {
            margin: 0 !important;
            padding: 0 !important;
            background: #fff !important;
        }

        .statement-sheet {
            max-width: 100% !important;
            width: 100% !important;
            box-shadow: none !important;
            border: none !important;
            border-radius: 0 !important;
            padding: 8mm 10mm !important;
            margin: 0 !important;
        }

        .statement-header-box {
            background: #ffffff !important;
            border: 1px solid #94a3b8 !important;
            padding: 5px 8px !important;
            margin-bottom: 6px !important;
        }

        .statement-summary-strip {
            border: 1px solid #94a3b8 !important;
            margin-bottom: 6px !important;
        }

        .summary-strip-col {
            padding: 3px 5px !important;
            border-left: 1px solid #cbd5e1 !important;
        }

        .table-statement {
            font-size: 8.5pt !important;
        }

        .table-statement th {
            padding: 3px 4px !important;
            font-size: 8pt !important;
        }

        .table-statement td {
            padding: 2.5px 4px !important;
            line-height: 1.2 !important;
            border-color: #94a3b8 !important;
        }

        .status-pill {
            font-size: 7.5pt !important;
            padding: 1px 4px !important;
            line-height: 1.05 !important;
            border: 1px solid #64748b !important;
            background-color: transparent !important;
            color: #000000 !important;
        }

        .statement-signatures,
        .statement-tafqeet-box,
        tr {
            page-break-inside: avoid !important;
            break-inside: avoid !important;
        }
    }
</style>

<!-- Top Interactive Toolbar (Screen Only) -->
<div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2 d-print-none">
    <div class="d-flex align-items-center gap-2">
        <h5 class="mb-0 fw-bold text-dark">
            <i class="bi bi-file-earmark-spreadsheet-fill text-primary me-2"></i>
            كشف حساب @(Model.PartyType == "Vendor" ? "مورد" : "عميل"): <span class="text-primary">@Model.PartyName</span>
        </h5>
    </div>

    <!-- Actions Dock -->
    <div class="d-flex align-items-center gap-2">
        <button type="button" class="btn btn-primary btn-sm shadow-sm fw-bold px-3" onclick="window.print()">
            <i class="bi bi-printer-fill me-1"></i> طباعة كشف الحساب (A4)
        </button>
        <button type="button" class="btn btn-outline-success btn-sm shadow-sm" onclick="exportTableToCSV('statementLedgerTable', 'كشف_حساب_@(Model.PartyName)_@DateTime.Today.ToString("yyyyMMdd")')">
            <i class="bi bi-file-earmark-excel me-1"></i> تصدير Excel
        </button>
        @if (Model.PartyType == "Customer")
        {
            <a asp-controller="Payment" asp-action="CustomerPayment" asp-route-customerId="@Model.PartyId" class="btn btn-success btn-sm shadow-sm fw-bold">
                <i class="bi bi-cash-stack me-1"></i> سند قبض
            </a>
            <a asp-controller="Customer" asp-action="Index" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-arrow-right me-1"></i> العملاء
            </a>
        }
        else
        {
            <a asp-controller="Payment" asp-action="VendorPayment" asp-route-vendorId="@Model.PartyId" class="btn btn-danger btn-sm shadow-sm fw-bold">
                <i class="bi bi-wallet2 me-1"></i> سند صرف
            </a>
            <a asp-controller="Vendor" asp-action="Index" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-arrow-right me-1"></i> الموردين
            </a>
        }
    </div>
</div>

<!-- Date Range Filter Form (Screen Only) -->
<div class="card shadow-sm border-0 mb-3 d-print-none">
    <div class="card-body p-2 px-3">
        <form method="get" asp-controller="@Model.ControllerName" asp-action="Statement" class="row g-2 align-items-end">
            <input type="hidden" name="id" value="@Model.PartyId" />
            
            <div class="col-sm-6 col-md-3">
                <label class="form-label small fw-bold text-muted mb-1"><i class="bi bi-calendar3 me-1"></i> من تاريخ</label>
                <input type="date" name="from" value="@(Model.From?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture))" class="form-control form-control-sm" />
            </div>
            
            <div class="col-sm-6 col-md-3">
                <label class="form-label small fw-bold text-muted mb-1"><i class="bi bi-calendar3 me-1"></i> إلى تاريخ</label>
                <input type="date" name="to" value="@(Model.To?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture))" class="form-control form-control-sm" />
            </div>
            
            <div class="col-md-6 d-flex gap-2">
                <button type="submit" class="btn btn-primary btn-sm flex-grow-1">
                    <i class="bi bi-funnel-fill me-1"></i> تحديث الفترة
                </button>
                <a asp-controller="@Model.ControllerName" asp-action="Statement" asp-route-id="@Model.PartyId" class="btn btn-outline-secondary btn-sm">
                    <i class="bi bi-arrow-counterclockwise me-1"></i> كل الحركات
                </a>
            </div>
        </form>
    </div>
</div>

<!-- ==========================================================================
     THE PRACTICAL WORK STATEMENT SHEET (High-Density Print Ready)
     ========================================================================== -->
<div class="statement-sheet">

    <!-- 1. Compact Commercial Header Box (Takes only ~35mm vertical space) -->
    <div class="statement-header-box">
        <div class="row align-items-center g-2">
            <!-- Merchant Brand (Right) -->
            <div class="col-4">
                <h6 class="fw-bold text-dark mb-0">المصري للتجارة والتوريدات</h6>
                <div class="text-muted" style="font-size: 0.76rem;">Elmasry Trading & Supplies | إدارة الحسابات</div>
                <div class="text-muted" style="font-size: 0.72rem;">س.ت: 104928 | ب.ض: 482-901-332 | هاتف: 01000000000</div>
            </div>

            <!-- Statement Document Title (Center) -->
            <div class="col-4 text-center">
                <h6 class="fw-bold mb-0 text-dark">كشف حساب @(Model.PartyType == "Vendor" ? "مورد" : "عميل") تفصيلي</h6>
                <div class="text-muted" style="font-size: 0.74rem;">
                    تاريخ الطباعة: <strong>@DateTime.Today.ToString("yyyy-MM-dd")</strong>
                </div>
            </div>

            <!-- Code & Period (Left) -->
            <div class="col-4 text-start">
                <div class="d-inline-block text-end">
                    <div style="font-size: 0.75rem;">
                        كود الحساب: <strong class="text-primary font-monospace">#@Model.PartyType.ToUpper().Substring(0, 3)-@Model.PartyId.ToString("D4")</strong>
                    </div>
                    <div style="font-size: 0.74rem;" class="text-muted font-tabular">
                        الفترة: 
                        @if (Model.From.HasValue && Model.To.HasValue)
                        {
                            <span>@Model.From.Value.ToString("yyyy-MM-dd") إلى @Model.To.Value.ToString("yyyy-MM-dd")</span>
                        }
                        else
                        {
                            <span>كافة الحركات التاريخية</span>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Party Info Mini Bar -->
        <div class="d-flex justify-content-between align-items-center border-top mt-1 pt-1" style="font-size: 0.80rem;">
            <div>
                <span class="text-muted">صاحب الحساب:</span>
                <strong class="text-dark fs-6 ms-1">@Model.PartyName</strong>
                <span class="badge bg-light text-dark border ms-1" style="font-size: 0.70rem;">
                    @(Model.PartyType == "Vendor" ? "مورد بضائع ومشتريات" : "عميل مبيعات ومسحوبات")
                </span>
            </div>
            <div>
                <span class="text-muted">العملة:</span>
                <strong class="text-dark">الجنيه المصري (ج.م)</strong>
            </div>
        </div>
    </div>

    <!-- 2. Compact 1-Line Financial Summary Strip (Takes only ~28mm vertical space) -->
    <div class="statement-summary-strip">
        <div class="row g-0">
            <!-- 1. Beginning Balance -->
            <div class="col-3 summary-strip-col">
                <span class="text-muted d-block" style="font-size: 0.72rem;">رصيد أول المدة (السابق)</span>
                <strong class="font-tabular text-dark" style="font-size: 0.95rem;">
                    @Model.BeginningBalance.ToString("N2") <small style="font-size: 0.70rem;">ج.م</small>
                </strong>
            </div>

            <!-- 2. Total Invoices / Debits -->
            <div class="col-3 summary-strip-col">
                <span class="text-muted d-block" style="font-size: 0.72rem;">
                    @(Model.PartyType == "Customer" ? "إجمالي المسحوبات (مبيعات +)" : "إجمالي المدفوعات للمورد (+)")
                </span>
                <strong class="font-tabular text-primary" style="font-size: 0.95rem;">
                    +@Model.TotalInvoices.ToString("N2") <small style="font-size: 0.70rem;">ج.م</small>
                </strong>
            </div>

            <!-- 3. Total Credits (Payments & Returns) -->
            <div class="col-3 summary-strip-col">
                <span class="text-muted d-block" style="font-size: 0.72rem;">
                    @(Model.PartyType == "Customer" ? "إجمالي السدادات والمرتجع (-)" : "إجمالي المشتريات والتوريد (-)")
                </span>
                <strong class="font-tabular text-success" style="font-size: 0.95rem;">
                    -@((Model.TotalPayments + Model.TotalReturns).ToString("N2")) <small style="font-size: 0.70rem;">ج.م</small>
                </strong>
            </div>

            <!-- 4. Ending Balance Highlight -->
            @{
                var isSettled = Math.Abs(Model.EndingBalance) < 0.005m;
                var endClass = isSettled ? "bg-success-subtle text-success" : (Model.EndingBalance > 0 ? "bg-danger-subtle text-danger" : "bg-info-subtle text-info");
            }
            <div class="col-3 summary-strip-col @endClass">
                <span class="d-block fw-bold" style="font-size: 0.72rem;">
                    @if (isSettled)
                    {
                        <span>الحساب مسدد بالكامل</span>
                    }
                    else if (Model.PartyType == "Customer")
                    {
                        <span>@(Model.EndingBalance > 0 ? "المتبقي على العميل (لنا)" : "رصيد دائن للعميل (له)")</span>
                    }
                    else
                    {
                        <span>@(Model.EndingBalance > 0 ? "المستحق للمورد (علينا)" : "مدفوع مقدماً للمورد (لنا)")</span>
                    }
                </span>
                <strong class="font-tabular" style="font-size: 1.05rem;">
                    @Math.Abs(Model.EndingBalance).ToString("N2") <small style="font-size: 0.70rem;">ج.م</small>
                </strong>
            </div>
        </div>
    </div>

    <!-- Client-Side Instant Table Search Bar (Screen Only) -->
    <div class="d-flex justify-content-between align-items-center mb-2 d-print-none">
        <div class="input-group input-group-sm" style="max-width: 350px;">
            <span class="input-group-text bg-white border-end-0 py-0"><i class="bi bi-search text-muted small"></i></span>
            <input type="text" class="form-control form-control-sm border-start-0 py-1" placeholder="بحث سريع في الحركات..." data-table-search="statementLedgerTable" data-counter-target="statementCounter" />
        </div>
        <span class="badge bg-light text-muted border font-tabular" id="statementCounter" style="font-size: 0.75rem;">
            عرض @Model.Lines.Count من إجمالي @Model.Lines.Count حركة
        </span>
    </div>

    <!-- 3. High-Density Statement Ledger Table (Fits 30-35 rows per page on A4) -->
    <div class="table-responsive mb-2">
        <table class="table-statement" id="statementLedgerTable">
            <thead>
                <tr>
                    <th style="width: 35px;">#</th>
                    <th style="width: 90px;">التاريخ</th>
                    <th class="text-start">البيان والمعاملة</th>
                    <th style="width: 110px;">رقم المستند</th>
                    @if (Model.PartyType == "Customer")
                    {
                        <th style="width: 105px;">عليه (مبيعات +)</th>
                        <th style="width: 105px;">له (سدادات -)</th>
                        <th style="width: 120px;">الرصيد المتبقي</th>
                    }
                    else
                    {
                        <th style="width: 105px;">له (سدادات -)</th>
                        <th style="width: 105px;">علينا (مشتريات +)</th>
                        <th style="width: 120px;">المستحق للمورد</th>
                    }
                </tr>
            </thead>
            <tbody>
                @if (Model.Lines.Count == 0)
                {
                    <tr>
                        <td colspan="7" class="text-center py-4 text-muted bg-white">
                            <i class="bi bi-journal-x fs-2 d-block mb-1 text-secondary"></i>
                            لا توجد أي حركات مالية مسجلة خلال الفترة المحددة.
                        </td>
                    </tr>
                }
                else
                {
                    int lineIdx = 1;
                    foreach (var line in Model.Lines)
                    {
                        <tr>
                            <td class="text-center text-muted fw-bold font-tabular">@(lineIdx++)</td>
                            <td class="text-center font-tabular">@line.Date.ToString("yyyy-MM-dd")</td>
                            <td class="text-start">
                                @if (line.DocumentType.Contains("فاتورة") || line.DocumentType.Contains("توريد"))
                                {
                                    <span class="status-pill status-pill-invoice">
                                        <i class="bi bi-receipt me-1"></i>@(Model.PartyType == "Customer" ? "فاتورة مبيعات" : "فاتورة مشتريات")
                                    </span>
                                }
                                else if (line.DocumentType.Contains("قبض") || line.DocumentType.Contains("دفعة"))
                                {
                                    <span class="status-pill status-pill-receipt">
                                        <i class="bi bi-cash-stack me-1"></i>سند قبض (دفعة)
                                    </span>
                                }
                                else if (line.DocumentType.Contains("صرف"))
                                {
                                    <span class="status-pill status-pill-disbursement">
                                        <i class="bi bi-wallet2 me-1"></i>سند صرف (دفعة)
                                    </span>
                                }
                                else if (line.DocumentType.Contains("مرتجع"))
                                {
                                    <span class="status-pill status-pill-return">
                                        <i class="bi bi-arrow-return-right me-1"></i>إشعار مرتجع بضاعة
                                    </span>
                                }
                                else
                                {
                                    <span class="status-pill status-pill-opening">
                                        <i class="bi bi-clock-history me-1"></i>رصيد افتتاحي
                                    </span>
                                }
                            </td>
                            <td class="text-center font-monospace fw-bold text-dark" style="font-size: 0.80rem;">@line.DocumentNo</td>
                            <td class="text-center font-tabular @(line.Debit > 0 ? "text-danger fw-bold" : "text-muted")">
                                @(line.Debit > 0 ? line.Debit.ToString("N2") : "-")
                            </td>
                            <td class="text-center font-tabular @(line.Credit > 0 ? "text-success fw-bold" : "text-muted")">
                                @(line.Credit > 0 ? line.Credit.ToString("N2") : "-")
                            </td>
                            <td class="text-center font-tabular fw-bold text-dark">
                                <span>@Math.Abs(line.RunningBalance).ToString("N2")</span>
                                @if (Math.Abs(line.RunningBalance) < 0.005m)
                                {
                                    <span class="text-success ms-1 small fw-normal" style="font-size: 0.70rem;">(خالص)</span>
                                }
                                else if (Model.PartyType == "Customer")
                                {
                                    if (line.RunningBalance > 0)
                                    {
                                        <span class="text-danger ms-1 small fw-normal" style="font-size: 0.70rem;">(عليه)</span>
                                    }
                                    else
                                    {
                                        <span class="text-info ms-1 small fw-normal" style="font-size: 0.70rem;">(له)</span>
                                    }
                                }
                                else
                                {
                                    if (line.RunningBalance > 0)
                                    {
                                        <span class="text-danger ms-1 small fw-normal" style="font-size: 0.70rem;">(له)</span>
                                    }
                                    else
                                    {
                                        <span class="text-info ms-1 small fw-normal" style="font-size: 0.70rem;">(لنا)</span>
                                    }
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
            <tfoot>
                <tr>
                    <td colspan="4" class="fw-bold text-end">الإجمالي والرصيد الختامي:</td>
                    <td class="text-center fw-bold text-danger font-tabular">@Model.TotalInvoices.ToString("N2")</td>
                    <td class="text-center fw-bold text-success font-tabular">@((Model.TotalPayments + Model.TotalReturns).ToString("N2"))</td>
                    <td class="text-center fw-bold text-dark font-tabular">
                        @Math.Abs(Model.EndingBalance).ToString("N2") ج.م
                    </td>
                </tr>
            </tfoot>
        </table>
    </div>

    <!-- 4. Compact 1-Line Tafqeet Strip -->
    <div class="statement-tafqeet-box p-2 bg-light rounded border mb-3" style="font-size: 0.80rem;">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-1">
            <div>
                <span class="text-muted fw-bold">الرصيد المتبقي كتابةً:</span>
                <strong class="text-dark ms-1">
                    @if (Math.Abs(Model.EndingBalance) < 0.005m)
                    {
                        <span class="text-success">الحساب خالص ومسدد بالكامل (صفر ج.م).</span>
                    }
                    else
                    {
                        <span>فقط @Tafqeet.ToArabicWords(Math.Abs(Model.EndingBalance)) لا غير</span>
                    }
                </strong>
            </div>
            <div>
                <span class="badge bg-white text-dark border px-2 py-1 font-tabular" style="font-size: 0.72rem;">
                    حالة الحساب: 
                    @if (Math.Abs(Model.EndingBalance) < 0.005m)
                    {
                        <strong class="text-success">مسدد بالكامل</strong>
                    }
                    else if (Model.PartyType == "Customer")
                    {
                        <strong class="@(Model.EndingBalance > 0 ? "text-danger" : "text-info")">
                            @(Model.EndingBalance > 0 ? "مستحق على العميل (لنا)" : "فائض لصالح العميل (له)")
                        </strong>
                    }
                    else
                    {
                        <strong class="@(Model.EndingBalance > 0 ? "text-danger" : "text-info")">
                            @(Model.EndingBalance > 0 ? "مستحق للمورد (علينا)" : "مدفوع مقدماً للمورد (لنا)")
                        </strong>
                    }
                </span>
            </div>
        </div>
    </div>

    <!-- 5. Compact Dual Signatures (Does not push onto an empty extra page) -->
    <div class="statement-signatures pt-2 border-top">
        <div class="row text-center g-2" style="font-size: 0.78rem;">
            <div class="col-6">
                <div class="fw-bold text-dark mb-3">توقيع وختم الإدارة المالية / الحسابات</div>
                <div class="d-inline-block border-bottom border-dark pb-1 px-4 text-muted" style="font-size: 0.72rem;">
                    ............................................................
                </div>
            </div>
            <div class="col-6">
                <div class="fw-bold text-dark mb-3">توقيع واعتماد صاحب الحساب (@(Model.PartyType == "Vendor" ? "المورد" : "العميل"))</div>
