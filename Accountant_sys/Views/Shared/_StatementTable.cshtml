@model Accountant_sys.Models.StatementViewModel
@using System.Globalization
@using Accountant_sys.Models
@{
    var labels = Model.Labels;
    var modeClass = Model.IsDetailed ? "is-detailed" : "is-summary";
    var today = DateTime.Today;
    var monthStart = new DateTime(today.Year, today.Month, 1);
    var last30 = today.AddDays(-29);
    var hasAnyFilter = Model.From.HasValue || Model.To.HasValue;
    var partyMeta = string.Join(" · ", new[]
    {
        $"كود {Model.AccountCode}",
        Model.PartyAddress,
        Model.PartyPhoneNumber
    }.Where(x => !string.IsNullOrWhiteSpace(x)));
}

<link rel="stylesheet" href="~/css/statement.css" asp-append-version="true" />

<div class="statement-page @modeClass" id="statementPage" data-mode="@Model.Mode">

    <!-- ================================================================
         Screen toolbar: sticky under the app navbar, hidden in print
         ================================================================ -->
    <div class="st-toolbar d-print-none" id="stToolbar" role="toolbar" aria-label="أدوات كشف الحساب">
        <div class="st-toolbar-row">
            <div class="st-toolbar-group st-toolbar-title">
                <span class="st-toolbar-eyebrow">@labels.StatementTitle</span>
                <b>@Model.PartyName</b>
                <span class="st-toolbar-code num-ltr">@Model.AccountCode</span>
            </div>

            <div class="st-toolbar-group">
                <button type="button" class="st-btn st-btn-primary" id="stPrint">
                    <i class="bi bi-printer-fill"></i> طباعة / PDF
                </button>
                <button type="button" class="st-btn" id="stExport"
                        data-export-table="statementLedgerTable"
                        data-export-filename="كشف_حساب_@(Model.PartyName)_@today.ToString("yyyyMMdd")">
                    <i class="bi bi-file-earmark-excel"></i> تصدير Excel
                </button>
                @if (!Model.IsVendor)
                {
                    <a asp-controller="Payment" asp-action="CustomerPayment" asp-route-customerId="@Model.PartyId"
                       class="st-btn st-btn-success">
                        <i class="bi bi-cash-stack"></i> تسجيل دفعة
                    </a>
                }
                else
                {
                    <a asp-controller="Payment" asp-action="VendorPayment" asp-route-vendorId="@Model.PartyId"
                       class="st-btn st-btn-danger">
                        <i class="bi bi-wallet2"></i> تسجيل دفعة
                    </a>
                }
                <a asp-controller="@Model.ControllerName" asp-action="Index" class="st-btn">
                    <i class="bi bi-arrow-right"></i> @labels.PartyIndexLabel
                </a>
            </div>

            <div class="st-toolbar-group">
                <div class="st-mode-switch" role="group" aria-label="طريقة العرض">
                    <button type="button" data-st-mode="detailed"
                            aria-pressed="@(Model.IsDetailed ? "true" : "false")">تفصيلي</button>
                    <button type="button" data-st-mode="summary"
                            aria-pressed="@(Model.IsDetailed ? "false" : "true")">مختصر</button>
                </div>
                <button type="button" class="st-btn st-btn-icon" id="stThemeToggle"
                        title="تبديل الوضع الليلي" aria-label="تبديل الوضع الليلي">
                    <i class="bi bi-moon-stars"></i>
                </button>
            </div>
        </div>

        <div class="st-toolbar-row st-toolbar-filters">
            <form method="get" asp-controller="@Model.ControllerName" asp-action="Statement"
                  class="st-filter-form" id="stFilterForm">
                <input type="hidden" name="id" value="@Model.PartyId" />
                <input type="hidden" name="mode" value="@Model.Mode" id="stModeField" />

                <label class="st-field">
                    <span>من</span>
                    <input type="date" name="from" id="stFrom"
                           value="@(Model.From?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture))" />
                </label>
                <label class="st-field">
                    <span>إلى</span>
                    <input type="date" name="to" id="stTo"
                           value="@(Model.To?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture))" />
                </label>
                <button type="submit" class="st-btn st-btn-primary">
                    <i class="bi bi-funnel-fill"></i> تحديث الفترة
                </button>
                <a asp-controller="@Model.ControllerName" asp-action="Statement"
                   asp-route-id="@Model.PartyId" asp-route-mode="@Model.Mode"
                   class="st-btn @(hasAnyFilter ? "" : "is-disabled")" aria-disabled="@(hasAnyFilter ? "false" : "true")">
                    <i class="bi bi-arrow-counterclockwise"></i> كل الحركات
                </a>

                <div class="st-date-chips" role="group" aria-label="فترات سريعة">
                    <a class="st-date-chip @(!hasAnyFilter ? "is-active" : "")"
                       asp-controller="@Model.ControllerName" asp-action="Statement"
                       asp-route-id="@Model.PartyId" asp-route-mode="@Model.Mode">كل الحركات</a>
                    <a class="st-date-chip @(Model.From?.Date == last30 && Model.To?.Date == today ? "is-active" : "")"
                       asp-controller="@Model.ControllerName" asp-action="Statement"
                       asp-route-id="@Model.PartyId" asp-route-mode="@Model.Mode"
                       asp-route-from="@last30.ToString("yyyy-MM-dd")"
                       asp-route-to="@today.ToString("yyyy-MM-dd")">آخر 30 يوم</a>
                    <a class="st-date-chip @(Model.From?.Date == monthStart && Model.To?.Date == today ? "is-active" : "")"
                       asp-controller="@Model.ControllerName" asp-action="Statement"
                       asp-route-id="@Model.PartyId" asp-route-mode="@Model.Mode"
                       asp-route-from="@monthStart.ToString("yyyy-MM-dd")"
                       asp-route-to="@today.ToString("yyyy-MM-dd")">الشهر الحالي</a>
                </div>
            </form>

            <div class="st-filter-tools">
                <label class="st-search">
                    <i class="bi bi-search" aria-hidden="true"></i>
                    <input type="search" id="stSearch" placeholder="بحث برقم المستند أو البيان أو الصنف…"
                           aria-label="بحث في حركات كشف الحساب" autocomplete="off" />
                </label>

                <label class="st-field st-field-inline">
                    <span>النوع</span>
                    <select id="stKind" aria-label="فلترة نوع الحركة">
                        <option value="all">كل الحركات</option>
                        <option value="invoice">فواتير</option>
                        <option value="payment">مدفوعات</option>
                        <option value="return">مرتجعات</option>
                        <option value="refund">استرداد</option>
                        <option value="opening">رصيد أول المدة</option>
                    </select>
                </label>

                <div class="st-expand-tools">
                    <button type="button" class="st-btn st-btn-sm" id="stExpandAll">توسيع الكل</button>
                    <button type="button" class="st-btn st-btn-sm" id="stCollapseAll">طي الكل</button>
                </div>

                <span class="st-count" id="stVisibleCount" aria-live="polite">
                    عرض @Model.Lines.Count من إجمالي @Model.Lines.Count حركة
                </span>
            </div>
        </div>
    </div>

    <!-- Client-side error panel (screen only) -->
    <div class="st-error-panel d-print-none" id="stErrorPanel" role="alert" hidden>
        <i class="bi bi-exclamation-triangle-fill"></i>
        <div>
            <b>حصلت مشكلة في تحميل أدوات الكشف</b>
            <span>الكشف نفسه ظاهر بالكامل. جرّب تحديث الصفحة لو المحتوى مش ظاهر صح.</span>
        </div>
        <button type="button" class="st-btn st-btn-sm" id="stRetry">إعادة المحاولة</button>
    </div>

    <!-- ================================================================
         The printed statement sheet
         ================================================================ -->
    <div class="statement-sheet" id="statementSheet">
        <partial name="_StatementHeader" model="Model" />
        <partial name="_StatementHero" model="Model" />
        <partial name="_StatementMovements" model="Model" />
        <partial name="_StatementUnpaidInvoices" model="Model" />
        <partial name="_StatementFooter" model="Model" />
    </div>

    <!-- Loading overlay (screen only) -->
    <div class="st-loading d-print-none" id="stLoading" hidden role="status" aria-live="polite">
        <span class="st-spinner" aria-hidden="true"></span>
        <span>جاري تحميل الكشف…</span>
    </div>

    <!-- Copy toast -->
    <div class="st-toast d-print-none" id="stToast" role="status" aria-live="polite" aria-atomic="true"></div>

    <div class="st-visually-hidden" aria-hidden="true">@partyMeta</div>
</div>

<script src="~/js/statement.js" asp-append-version="true"></script>
