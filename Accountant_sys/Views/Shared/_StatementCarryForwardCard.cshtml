@model Accountant_sys.Models.StatementViewModel
@{
    var isVendor = Model.PartyType == "Vendor";
    var hasCarryForward = Math.Abs(Model.BeginningBalance) >= 0.005m;
    var balanceTag = StatementBuilder.FormatBalanceTag(Model.BeginningBalance, isVendor);
    var balanceClass = Model.BeginningBalance > 0 ? "text-danger" : "text-info";
}

@if (hasCarryForward)
{
    <div class="order-block" style="border-color: #64748b;">
        <div class="order-block-header" style="background: #f1f5f9; border-bottom-color: #cbd5e1;">
            <div class="row align-items-center g-2">
                <div class="col-3 text-start">
                    <span class="badge bg-secondary-subtle text-dark border border-secondary-subtle" style="font-size: 0.76rem;">
                        رصيد سابق مرحّل
                    </span>
                </div>
                <div class="col-6 text-center">
                    <span class="order-title-prominent">
                        [ ما قبل @(Model.From?.ToString("yyyy-MM-dd") ?? "الفترة") ]
                    </span>
                </div>
                <div class="col-3 text-end">
                    <span class="text-muted small">بداية الفترة:</span>
                    <strong class="font-tabular ms-1" style="font-size: 0.85rem;">@(Model.From?.ToString("yyyy-MM-dd") ?? "-")</strong>
                </div>
            </div>
        </div>
        <div class="order-block-footer d-flex justify-content-between align-items-center flex-wrap gap-2">
            <span class="small text-muted">الرصيد المتراكم من المعاملات المسجلة قبل بداية هذه الفترة</span>
            <span class="badge bg-white text-dark border px-2 py-1 font-tabular" style="font-size: 0.80rem;">
                الرصيد المرحّل: <strong class="@balanceClass ms-1">@Math.Abs(Model.BeginningBalance).ToString("N2") ج.م @balanceTag</strong>
            </span>
        </div>
    </div>
}
