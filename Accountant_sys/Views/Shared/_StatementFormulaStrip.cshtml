@model Accountant_sys.Models.StatementViewModel
@using Accountant_sys.Models
@{
    var labels = Model.Labels;
    var isSettled = Math.Abs(Model.EndingBalance) < 0.005m;
    var finalClass = isSettled
        ? "is-final-settled"
        : (Model.EndingBalance > 0 ? "is-final-owed" : "is-final-credit");
    var finalTitle = isSettled
        ? "الرصيد النهائي"
        : (Model.EndingBalance > 0 ? labels.OutstandingBalanceLabel : labels.CreditBalanceLabel);
    var finalSub = isSettled
        ? "الحساب خالص ومسدد"
        : (Model.EndingBalance > 0 ? labels.OutstandingStatusDetail : labels.CreditStatusDetail);

    var prevSub = Math.Abs(Model.BeginningBalance) < 0.005m
        ? "لا يوجد رصيد مرحّل"
        : StatementBuilder.FormatBalanceTag(Model.BeginningBalance, Model.IsVendor);

    var addExtras = new List<string>();
    if (Model.TotalOpening > 0)
        addExtras.Add($"رصيد افتتاحي: {StatementBuilder.FormatMoney(Model.TotalOpening)}");
    if (Model.TotalRefunds > 0)
        addExtras.Add($"{(Model.IsVendor ? "استرداد نقدي" : "رد نقدي")}: {StatementBuilder.FormatMoney(Model.TotalRefunds)}");
}

<div class="st-summary-grid" aria-label="ملخص الحساب المالي">
    <!-- 1. Previous Balance -->
    <div class="st-summary-cell">
        <span class="st-summary-label">الرصيد السابق</span>
        <span class="st-summary-value">
            <span class="num-ltr">@StatementBuilder.FormatMoney(Math.Abs(Model.BeginningBalance))</span>
            <span class="st-summary-currency">ج.م</span>
        </span>
        <span class="st-summary-sub">@prevSub</span>
    </div>

    <!-- 2. Sales / Purchases / Supply Orders (+ Opening / Refunds if within period) -->
    <div class="st-summary-cell is-addition">
        <span class="st-summary-label">@labels.InvoicesLabel</span>
        <span class="st-summary-value">
            <span class="num-ltr">@StatementBuilder.FormatMoney(Model.TotalInvoices)</span>
            <span class="st-summary-currency">ج.م</span>
        </span>
        @if (addExtras.Any())
        {
            <span class="st-summary-sub">+ @string.Join(" | ", addExtras)</span>
            <span class="st-summary-sub fw-bold">الإجمالي المضاف: <span class="num-ltr">@StatementBuilder.FormatMoney(Model.TotalAdditions)</span></span>
        }
        else
        {
            <span class="st-summary-sub">@labels.AdditionHint</span>
        }
    </div>

    <!-- 3. Payments -->
    <div class="st-summary-cell is-deduction">
        <span class="st-summary-label">@labels.PaymentsLabel</span>
        <span class="st-summary-value">
            <span class="num-ltr">@StatementBuilder.FormatMoney(Model.TotalPayments)</span>
            <span class="st-summary-currency">ج.م</span>
        </span>
        <span class="st-summary-sub">إجمالي المدفوعات</span>
    </div>

    <!-- 4. Returns / Credit Notes -->
    <div class="st-summary-cell is-deduction">
        <span class="st-summary-label">@labels.ReturnsLabel</span>
        <span class="st-summary-value">
            <span class="num-ltr">@StatementBuilder.FormatMoney(Model.TotalReturns)</span>
            <span class="st-summary-currency">ج.م</span>
        </span>
        <span class="st-summary-sub">إشعارات الخصم والمرتجعات</span>
    </div>

    <!-- 5. Current Outstanding / Credit Balance -->
    <div class="st-summary-cell @finalClass">
        <span class="st-summary-label">@finalTitle</span>
        <span class="st-summary-value">
            <span class="num-ltr">@StatementBuilder.FormatMoney(Math.Abs(Model.EndingBalance))</span>
            <span class="st-summary-currency">ج.م</span>
        </span>
        <span class="st-summary-sub fw-semibold">@finalSub</span>
    </div>
</div>
