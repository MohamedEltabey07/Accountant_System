<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - نظام المحاسبة</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.rtl.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <style>
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: #f4f6f9;
        }
        /* Sidebar */
        .sidebar {
            position: fixed;
            top: 0;
            right: 0;
            width: 260px;
            height: 100vh;
            background: linear-gradient(180deg, #1a1a2e 0%, #16213e 100%);
            padding-top: 0;
            z-index: 1000;
            overflow-y: auto;
            transition: all 0.3s;
        }
        .sidebar .brand {
            padding: 1.2rem 1rem;
            text-align: center;
            border-bottom: 1px solid rgba(255,255,255,0.1);
        }
        .sidebar .brand h5 {
            color: #fff;
            margin: 0;
            font-weight: 700;
        }
        .sidebar .brand small {
            color: rgba(255,255,255,0.5);
            font-size: 0.75rem;
        }
        .sidebar .nav-link {
            color: rgba(255,255,255,0.7);
            padding: 0.7rem 1.2rem;
            font-size: 0.92rem;
            border-radius: 0;
            transition: all 0.2s;
        }
        .sidebar .nav-link:hover,
        .sidebar .nav-link.active {
            color: #fff;
            background: rgba(255,255,255,0.1);
        }
        .sidebar .nav-link i {
            width: 24px;
            text-align: center;
            margin-left: 8px;
        }
        .sidebar .section-title {
            color: rgba(255,255,255,0.4);
            font-size: 0.75rem;
            text-transform: uppercase;
            padding: 1rem 1.2rem 0.4rem;
            letter-spacing: 1px;
            font-weight: 600;
        }
        /* Main content */
        .main-content {
            margin-right: 260px;
            min-height: 100vh;
        }
        /* Top navbar */
        .top-navbar {
            background: #fff;
            border-bottom: 1px solid #e0e0e0;
            padding: 0.6rem 1.5rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        .top-navbar .page-title {
            font-size: 1.1rem;
            font-weight: 600;
            color: #333;
        }
        .content-area {
            padding: 1.5rem;
        }
        /* Print: hide sidebar and navbar */
        @@media print {
            .sidebar, .top-navbar { display: none !important; }
            .main-content { margin-right: 0 !important; }
        }
        /* Mobile responsive */
        @@media (max-width: 768px) {
            .sidebar { width: 0; overflow: hidden; }
            .sidebar.show { width: 260px; }
            .main-content { margin-right: 0; }
        }
    </style>
</head>
<body>
    <!-- Sidebar -->
    <nav class="sidebar" id="sidebar">
        <div class="brand">
            <h5><i class="bi bi-calculator-fill me-1"></i> نظام المحاسبة</h5>
            <small>Accountant System</small>
        </div>

        <div class="section-title">القائمة الرئيسية</div>
        <ul class="nav flex-column">
            <li class="nav-item">
                <a class="nav-link" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-speedometer2"></i> لوحة التحكم
                </a>
            </li>
        </ul>

        <div class="section-title">المنتجات والأطراف</div>
        <ul class="nav flex-column">
            <li class="nav-item">
                <a class="nav-link" asp-controller="Product" asp-action="Index">
                    <i class="bi bi-box-seam"></i> المنتجات
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" asp-controller="Customer" asp-action="Index">
                    <i class="bi bi-people-fill"></i> العملاء
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" asp-controller="Vendor" asp-action="Index">
                    <i class="bi bi-truck"></i> الموردين
                </a>
            </li>
        </ul>

        <div class="section-title">الفواتير</div>
        <ul class="nav flex-column">
            <li class="nav-item">
                <a class="nav-link" asp-controller="Invoice" asp-action="Index">
                    <i class="bi bi-collection"></i> جميع الفواتير
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" asp-controller="Invoice" asp-action="Index" asp-route-type="@((int)DAL.Enums.InvoiceType.VendorPurchase)">
                    <i class="bi bi-cart-plus"></i> فواتير المشتريات
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" asp-controller="Invoice" asp-action="Index" asp-route-type="@((int)DAL.Enums.InvoiceType.WholesaleSales)">
                    <i class="bi bi-receipt"></i> فواتير الجملة
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" asp-controller="Invoice" asp-action="Index" asp-route-type="@((int)DAL.Enums.InvoiceType.StoreCashSales)">
                    <i class="bi bi-shop"></i> مبيعات التجزئة
                </a>
            </li>
        </ul>

        <div class="section-title">الخزينة</div>
        <ul class="nav flex-column">
            <li class="nav-item">
                <a class="nav-link" href="#">
                    <i class="bi bi-cash-stack"></i> حركات الخزينة
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="#">
                    <i class="bi bi-credit-card"></i> المدفوعات
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="#">
                    <i class="bi bi-wallet2"></i> المصروفات
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="#">
                    <i class="bi bi-arrow-return-left"></i> المرتجعات
                </a>
            </li>
        </ul>

        <div class="section-title">التقارير</div>
        <ul class="nav flex-column">
            <li class="nav-item">
                <a class="nav-link" href="#">
                    <i class="bi bi-calendar-check"></i> الإقفال اليومي
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="#">
                    <i class="bi bi-file-earmark-text"></i> كشف حساب عميل
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="#">
                    <i class="bi bi-file-earmark-text"></i> كشف حساب مورد
                </a>
            </li>
        </ul>

        <div class="section-title">الإعدادات</div>
        <ul class="nav flex-column">
            <li class="nav-item">
                <a class="nav-link" asp-controller="Account" asp-action="ChangePassword">
                    <i class="bi bi-key-fill"></i> تغيير كلمة المرور
                </a>
            </li>
        </ul>
    </nav>

    <!-- Main Content -->
    <div class="main-content">
        <!-- Top Navbar -->
        <div class="top-navbar">
            <div>
                <button class="btn btn-sm btn-outline-secondary d-md-none" onclick="document.getElementById('sidebar').classList.toggle('show')">
                    <i class="bi bi-list"></i>
                </button>
                <span class="page-title me-2">@ViewData["Title"]</span>
            </div>
            <div class="d-flex align-items-center gap-3">
                <span class="text-muted small">
                    <i class="bi bi-person-circle me-1"></i>
                    @User.Identity?.Name
                </span>
                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                    <button type="submit" class="btn btn-sm btn-outline-danger">
                        <i class="bi bi-box-arrow-right me-1"></i> خروج
                    </button>
                </form>
            </div>
        </div>

        <!-- Page Content -->
        <div class="content-area">
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <i class="bi bi-check-circle-fill me-2"></i>
                    @TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>
                    @TempData["ErrorMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            @RenderBody()
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
