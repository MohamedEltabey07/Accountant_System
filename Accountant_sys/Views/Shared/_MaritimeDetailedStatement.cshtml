@model Accountant_sys.Models.StatementViewModel
@using Accountant_sys.Models
@using BLL.DTOs.MaritimeCompany.OutGoingData
@{
    Model.AccountType = StatementAccountType.MaritimeCompany;
    Model.Mode = "detailed";
    if (!Model.SupplyOrders.Any() && ViewData["SupplyOrders"] is List<MaritimeSupplyOrderDto> viewOrders)
    {
        Model.SupplyOrders = viewOrders;
    }
}
<partial name="_StatementTable" model="Model" />
