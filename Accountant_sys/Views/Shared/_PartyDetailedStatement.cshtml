@model Accountant_sys.Models.StatementViewModel
@using BLL.DTOs.Invoice.OutGoingData
@{
    Model.Mode = "detailed";
    if (!Model.DetailedInvoices.Any() && ViewData["DetailedInvoices"] is List<StatementInvoiceDetailDto> viewInvoices)
    {
        Model.DetailedInvoices = viewInvoices;
    }
}
<partial name="_StatementTable" model="Model" />
