@model List<BLL.DTOs.MaritimeCompany.OutGoingData.MaritimeCompanyDto>
@{
    ViewData["Title"] = "الشركات البحرية";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
    <div>
        <h3 class="fw-bold mb-1">
            <i class="bi bi-anchor text-info me-2"></i> الشركات البحرية
        </h3>
        <p class="text-muted mb-0">متابعة حسابات شركات توريد الأسماك المجمدة وأرصدتها المستحقة</p>
    </div>
    <div class="d-flex gap-2">
        <button type="button" class="btn btn-outline-success shadow-sm" onclick="exportTableToCSV('maritimeTable', 'الشركات_البحرية')">
            <i class="bi bi-file-earmark-excel me-1"></i> تصدير Excel
        </button>
        <a asp-action="Create" class="btn btn-primary shadow-sm fw-bold">
            <i class="bi bi-plus-lg me-1"></i> شركة بحرية جديدة
        </a>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card shadow-sm border-0 text-center">
            <div class="card-body py-3">
                <small class="text-muted d-block">عدد الشركات المسجلة</small>
                <h4 class="fw-bold text-dark mb-0">@Model.Count</h4>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card shadow-sm border-0 text-center">
            <div class="card-body py-3">
                <small class="text-muted d-block">الشركات النشطة</small>
                <h4 class="fw-bold text-success mb-0">@Model.Count(c => c.IsActive)</h4>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card shadow-sm border-0 text-center">
            <div class="card-body py-3">
                <small class="text-muted d-block">إجمالي الأرصدة المستحقة</small>
                <h4 class="fw-bold text-danger mb-0">@Model.Sum(c => c.OutstandingBalance).ToString("N2") <small class="fs-6 text-muted">ج.م</small></h4>
            </div>
        </div>
    </div>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-3">
        <div class="row align-items-center g-2 mb-2">
            <div class="col-md-5">
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                    <input type="text" class="form-control border-start-0" placeholder="بحث فوري بالاسم أو الهاتف..." data-table-search="maritimeTable" data-counter-target="maritimeCounter" />
                </div>
            </div>
            <div class="col-md-7 text-md-start">
                <span class="badge bg-light text-dark border p-2 font-tabular" id="maritimeCounter">
                    عرض @Model.Count من إجمالي @Model.Count شركة
                </span>
            </div>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle text-center mb-0" id="maritimeTable">
                <thead class="bg-light">
                    <tr>
                        <th>#</th>
                        <th class="text-start">اسم الشركة</th>
                        <th>رقم الهاتف</th>
                        <th>العنوان</th>
                        <th>الرصيد المستحق</th>
                        <th>الحالة</th>
                        <th>إجراءات</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Count == 0)
                    {
                        <tr>
                            <td colspan="7" class="text-center text-muted py-5">
                                <i class="bi bi-anchor fs-1 d-block mb-2 text-secondary"></i>
                                لا توجد شركات بحرية مسجلة بعد.
                            </td>
                        </tr>
                    }
                    else
                    {
                        int index = 1;
                        @foreach (var company in Model)
                        {
                        <tr>
                            <td class="text-muted fw-bold">@(index++)</td>
                            <td class="text-start fw-bold text-dark">@company.Name</td>
                            <td class="font-tabular">@(string.IsNullOrWhiteSpace(company.PhoneNumber) ? "-" : company.PhoneNumber)</td>
                            <td class="text-muted small">@(string.IsNullOrWhiteSpace(company.Address) ? "-" : company.Address)</td>
                            <td class="font-tabular fw-bold @(company.OutstandingBalance > 0 ? "text-danger" : "text-success")">
                                @company.OutstandingBalance.ToString("N2") ج.م
                            </td>
                            <td>
                                @if (company.IsActive)
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle">نشطة</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary-subtle text-secondary border">غير نشطة</span>
                                }
                            </td>
                            <td>
                                <div class="btn-group btn-group-sm" role="group">
                                    <a asp-action="Details" asp-route-id="@company.Id" class="btn btn-outline-primary" title="تفاصيل الشركة">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a asp-action="Statement" asp-route-id="@company.Id" class="btn btn-outline-info" title="كشف الحساب">
                                        <i class="bi bi-receipt-cutoff"></i>
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@company.Id" class="btn btn-outline-warning" title="تعديل">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <a asp-controller="Invoice" asp-action="Create" asp-route-type="4" asp-route-customerId="@company.Id"
                                       class="btn btn-outline-success" title="أمر توريد جديد">
                                        <i class="bi bi-box-arrow-in-up-left"></i>
                                    </a>
                                    <form asp-action="ToggleStatus" asp-route-id="@company.Id" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-outline-danger @(company.IsActive ? "" : "btn-success")"
                                                title="@(company.IsActive ? "تعطيل الشركة" : "تنشيط الشركة")">
                                            <i class="bi @(company.IsActive ? "bi-pause" : "bi-play")"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
