@model Accountant_sys.Models.StatementViewModel
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    ViewData["Title"] = "كشف حساب شركة بحرية";
}

@if (Model == null)
{
    <div class="row justify-content-center py-4">
        <div class="col-lg-7">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white py-3 border-bottom d-flex align-items-center gap-2">
                    <div class="p-2 bg-info-subtle text-info rounded-3">
                        <i class="bi bi-anchor fs-4"></i>
                    </div>
                    <div>
                        <h5 class="card-title mb-0 fw-bold text-dark">كشف حساب شركة بحرية</h5>
                        <small class="text-muted">أوامر التوريد، الدفعات المستلمة، والمرتجعات مع الأرصدة التراكمية</small>
                    </div>
                </div>
                <div class="card-body p-4">
                    <p class="text-muted mb-4">
                        حدد الشركة البحرية واختيارياً نطاق التاريخ لاستخراج كشف حساب يشمل أوامر التوريد المرحلة، سندات الدفعات المستلمة، والإشعارات الائتمانية.
                    </p>

                    <form method="get" asp-controller="MaritimeCompany" asp-action="Statement" class="row g-3">
                        <div class="col-12">
                            <label class="form-label fw-bold">الشركة البحرية <span class="text-danger">*</span></label>
                            <select name="id" class="form-select form-select-lg" required>
                                <option value="">-- اختر الشركة من السجل --</option>
                                @if (ViewBag.Parties != null)
                                {
                                    foreach (var item in (SelectList)ViewBag.Parties)
                                    {
                                        <option value="@item.Value">@item.Text</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-muted">من تاريخ (اختياري)</label>
                            <input type="date" value="2000-01-01" name="from" class="form-control" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-muted">إلى تاريخ (اختياري)</label>
                            <input type="date" value="2100-01-01" name="to" class="form-control" />
                        </div>
                        <div class="col-12 pt-3 border-top d-flex gap-2 justify-content-end">
                            <a asp-controller="MaritimeCompany" asp-action="Index" class="btn btn-outline-secondary">إلغاء</a>
                            <button type="submit" class="btn btn-primary px-4 fw-bold shadow-sm">
                                <i class="bi bi-search me-1"></i> استخراج كشف الحساب
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <partial name="_StatementTable" model="Model" />
}
