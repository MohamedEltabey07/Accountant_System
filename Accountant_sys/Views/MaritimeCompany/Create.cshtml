@model BLL.DTOs.MaritimeCompany.InComingData.CreateMaritimeCompanyDto
@{
    ViewData["Title"] = "شركة بحرية جديدة";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4><i class="bi bi-anchor me-2 text-info"></i> تسجيل شركة بحرية جديدة</h4>
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-right me-1"></i> رجوع لسجل الشركات
    </a>
</div>

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card shadow-sm">
            <div class="card-header bg-white py-3">
                <h5 class="card-title mb-0 text-primary">
                    <i class="bi bi-person-vcard me-1"></i> بيانات الشركة البحرية
                </h5>
                <small class="text-muted">تُفتح الشركة البحرية كحساب مستقل تماماً عن عملاء الجملة</small>
            </div>
            <div class="card-body">
                <div asp-validation-summary="All" class="text-danger mb-3"></div>

                <form asp-action="Create" method="post">
                    <div class="mb-3">
                        <label asp-for="Name" class="form-label fw-bold">اسم الشركة <span class="text-danger">*</span></label>
                        <input asp-for="Name" class="form-control" placeholder="مثال: الشركة البحرية للتوريدات" />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                        <div class="form-text">اسم الشركة يظهر في أوامر التوريد وكشوف الحساب والتقارير.</div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="PhoneNumber" class="form-label fw-bold">رقم الهاتف</label>
                            <input asp-for="PhoneNumber" class="form-control" dir="ltr" placeholder="رقم الهاتف" />
                            <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="Address" class="form-label fw-bold">العنوان</label>
                            <input asp-for="Address" class="form-control" placeholder="العنوان (اختياري)" />
                            <span asp-validation-for="Address" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="alert alert-info py-2">
                        <i class="bi bi-info-circle-fill me-1"></i>
                        يتم إنشاء الحساب بحالة نشطة، ويمكن لاحقاً تعطيله أو تنشيطه من سجل الشركات.
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Index" class="btn btn-outline-secondary">إلغاء</a>
                        <button type="submit" class="btn btn-primary px-4 fw-bold shadow-sm">
                            <i class="bi bi-check-lg me-1"></i> حفظ الشركة
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
