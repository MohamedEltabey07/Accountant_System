@model BLL.DTOs.MaritimeCompany.OutGoingData.MaritimeCompanyDto
@using BLL.DTOs.Invoice.OutGoingData
@{
    ViewData["Title"] = "تفاصيل الشركة البحرية";
    var supplyOrders = ViewBag.SupplyOrders as List<InvoiceDto> ?? new List<InvoiceDto>();
    var totalSupplied = supplyOrders.Where(i => i.Status == DAL.Enums.InvoiceStatus.Posted).Sum(i => i.TotalAmount);
    var totalPaid = supplyOrders.Sum(i => i.PaidAmount);
    var fullyPaid = supplyOrders.Count(i => i.Status == DAL.Enums.InvoiceStatus.Posted && i.PaymentStatus == DAL.Enums.InvoicePaymentStatus.Paid);
    var partiallyPaid = supplyOrders.Count(i => i.Status == DAL.Enums.InvoiceStatus.Posted && i.PaymentStatus == DAL.Enums.InvoicePaymentStatus.PartiallyPaid);
    var unpaid = supplyOrders.Count(i => i.Status == DAL.Enums.InvoiceStatus.Posted && i.PaymentStatus == DAL.Enums.InvoicePaymentStatus.Unpaid);
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
    <h4 class="mb-0">
        <i class="bi bi-anchor text-info me-2"></i> الشركة البحرية: <span class="text-primary">@Model.Name</span>
        @if (!Model.IsActive)
        {
            <span class="badge bg-secondary-subtle text-secondary border ms-2">غير نشطة</span>
        }
    </h4>
    <div class="d-flex gap-2">
        <a asp-action="Statement" asp-route-id="@Model.Id" class="btn btn-outline-info">
            <i class="bi bi-receipt-cutoff me-1"></i> كشف الحساب
        </a>
        <a asp-controller="Invoice" asp-action="Create" asp-route-type="4" asp-route-customerId="@Model.Id"
           class="btn btn-success">
            <i class="bi bi-plus-lg me-1"></i> أمر توريد جديد
        </a>
        <a asp-controller="Payment" asp-action="CustomerPayment" asp-route-customerId="@Model.Id" class="btn btn-outline-primary">
            <i class="bi bi-cash-stack me-1"></i> سند قبض دفعة
        </a>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-right me-1"></i> رجوع
        </a>
    </div>
</div>

<!-- Financial Summary Cards -->
<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card shadow-sm border-0 text-center">
            <div class="card-body py-3">
                <small class="text-muted d-block">الرصيد المستحق المتبقي</small>
                <h4 class="fw-bold text-danger mb-0">@Model.OutstandingBalance.ToString("N2") <small class="fs-6 text-muted">ج.م</small></h4>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card shadow-sm border-0 text-center">
            <div class="card-body py-3">
                <small class="text-muted d-block">إجمالي قيمة التوريدات</small>
                <h4 class="fw-bold text-primary mb-0">@totalSupplied.ToString("N2") <small class="fs-6 text-muted">ج.م</small></h4>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card shadow-sm border-0 text-center">
            <div class="card-body py-3">
                <small class="text-muted d-block">إجمالي المدفوع المستلم</small>
                <h4 class="fw-bold text-success mb-0">@totalPaid.ToString("N2") <small class="fs-6 text-muted">ج.م</small></h4>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card shadow-sm border-0 text-center">
            <div class="card-body py-3">
                <small class="text-muted d-block">حالة أوامر التوريد</small>
                <div class="d-flex justify-content-center gap-2 mt-1 flex-wrap">
                    <span class="badge bg-success-subtle text-success border border-success-subtle">مدفوع: @fullyPaid</span>
                    <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle">جزئي: @partiallyPaid</span>
                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle">غير مدفوع: @unpaid</span>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Company info -->
<div class="card shadow-sm border-0 mb-4">
    <div class="card-header bg-white py-3">
        <h5 class="card-title mb-0 text-dark"><i class="bi bi-person-vcard me-1"></i> بيانات الشركة</h5>
    </div>
    <div class="card-body">
        <div class="row g-3">
            <div class="col-md-4">
                <small class="text-muted d-block">اسم الشركة</small>
                <span class="fw-bold text-dark">@Model.Name</span>
            </div>
            <div class="col-md-4">
                <small class="text-muted d-block">رقم الهاتف</small>
                <span class="fw-bold text-dark font-tabular" dir="ltr">@(string.IsNullOrWhiteSpace(Model.PhoneNumber) ? "-" : Model.PhoneNumber)</span>
            </div>
            <div class="col-md-4">
                <small class="text-muted d-block">العنوان</small>
                <span class="fw-bold text-dark">@(string.IsNullOrWhiteSpace(Model.Address) ? "-" : Model.Address)</span>
            </div>
            <div class="col-md-4">
                <small class="text-muted d-block">تاريخ التسجيل</small>
                <span class="font-tabular">@Model.CreatedAt.ToString("yyyy-MM-dd")</span>
            </div>
            <div class="col-md-4">
                <small class="text-muted d-block">آخر تعديل</small>
                <span class="font-tabular">@(Model.UpdatedAt?.ToString("yyyy-MM-dd") ?? "-")</span>
            </div>
            <div class="col-md-4">
                <small class="text-muted d-block">حالة الحساب</small>
                @if (Model.IsActive)
                {
                    <span class="badge bg-success-subtle text-success border border-success-subtle">نشطة</span>
                }
                else
                {
                    <span class="badge bg-secondary-subtle text-secondary border">غير نشطة</span>
                }
            </div>
        </div>
    </div>
</div>

<!-- Supply orders history -->
<div class="card shadow-sm border-0">
    <div class="card-header bg-white py-3 d-flex flex-wrap justify-content-between align-items-center gap-2">
        <h5 class="card-title mb-0 text-dark"><i class="bi bi-journal-text me-1"></i> أوامر التوريد البحرية للشركة</h5>
        <div class="d-flex gap-2">
            @if (supplyOrders.Count > 0)
            {
                <button type="button" class="btn btn-sm btn-outline-success" onclick="exportTableToCSV('companyOrdersTable', 'أوامر_توريد_@Model.Name')">
                    <i class="bi bi-file-earmark-excel me-1"></i> تصدير Excel
                </button>
            }
            <a asp-controller="Invoice" asp-action="Index" asp-route-type="4" class="btn btn-sm btn-outline-primary">
                <i class="bi bi-list me-1"></i> كل أوامر التوريد
            </a>
        </div>
    </div>
    @if (supplyOrders.Count > 0)
    {
        <div class="card-body p-3 border-bottom">
            <div class="row align-items-center g-2">
                <div class="col-md-5">
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                        <input type="text" class="form-control border-start-0" placeholder="بحث برقم الفاتورة أو أمر الشركة..." data-table-search="companyOrdersTable" data-counter-target="ordersCounter" />
                    </div>
                </div>
                <div class="col-md-7 text-md-start">
                    <span class="badge bg-light text-dark border p-2 font-tabular" id="ordersCounter">
                        عرض @supplyOrders.Count من إجمالي @supplyOrders.Count أمر توريد
                    </span>
                </div>
            </div>
        </div>
    }
    <div class="card-body p-0">
        @if (supplyOrders.Count == 0)
        {
            <div class="text-center text-muted py-5">
                <i class="bi bi-inbox fs-1 d-block mb-2 text-secondary"></i>
                لا توجد أوامر توريد مسجلة لهذه الشركة بعد.
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle text-center mb-0" id="companyOrdersTable">
                    <thead class="bg-light">
                        <tr>
                            <th>رقم فاتورتي</th>
                            <th>رقم أمر الشركة</th>
                            <th>تاريخ التوريد</th>
                            <th>بند السمك</th>
                            <th>الإجمالي</th>
                            <th>المدفوع</th>
                            <th>المتبقي</th>
                            <th>حالة الفاتورة</th>
                            <th>حالة السداد</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var order in supplyOrders)
                        {
                            <tr>
                                <td class="font-monospace fw-bold">@order.InvoiceNumber</td>
                                <td class="font-tabular">@(string.IsNullOrWhiteSpace(order.ExternalOrderNumber) ? "-" : order.ExternalOrderNumber)</td>
                                <td class="font-tabular">@order.TransactionDate.ToString("yyyy-MM-dd")</td>
                                <td class="text-muted small">
                                    @string.Join("، ", order.Items.Select(i => $"{i.ProductName} ({i.Quantity:N3} كجم)"))
                                </td>
                                <td class="fw-bold font-tabular">@order.TotalAmount.ToString("N2")</td>
                                <td class="text-success font-tabular">@order.PaidAmount.ToString("N2")</td>
                                <td class="text-danger fw-bold font-tabular">@order.RemainingBalance.ToString("N2")</td>
                                <td>
                                    @if (order.Status == DAL.Enums.InvoiceStatus.Posted)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle">مرحّلة</span>
                                    }
                                    else if (order.Status == DAL.Enums.InvoiceStatus.Draft)
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary border">مسودة</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle">ملغاة</span>
                                    }
                                </td>
                                <td>
                                    @if (order.Status != DAL.Enums.InvoiceStatus.Posted)
                                    {
                                        <span class="badge bg-light text-muted border">-</span>
                                    }
                                    else if (order.PaymentStatus == DAL.Enums.InvoicePaymentStatus.Paid)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle">مدفوع</span>
                                    }
                                    else if (order.PaymentStatus == DAL.Enums.InvoicePaymentStatus.PartiallyPaid)
                                    {
                                        <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle">مدفوع جزئياً</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle">غير مدفوع</span>
                                    }
                                </td>
                                <td class="d-flex gap-1 justify-content-center align-items-center">
                                    <a asp-controller="Invoice" asp-action="Details" asp-route-id="@order.Id"
                                       class="btn btn-sm btn-outline-primary" title="عرض أمر التوريد">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    @if (order.Status == DAL.Enums.InvoiceStatus.Posted)
                                    {
                                        <a asp-controller="Invoice" asp-action="Amend" asp-route-id="@order.Id"
                                           class="btn btn-sm btn-outline-warning" title="تصحيح أمر التوريد المرحّل">
                                            <i class="bi bi-pencil-square"></i>
                                        </a>
                                    }
                                    else if (order.Status == DAL.Enums.InvoiceStatus.Draft)
                                    {
                                        <form asp-controller="Invoice" asp-action="Delete" asp-route-id="@order.Id" method="post" class="d-inline">
                                            <button type="submit" class="btn btn-sm btn-outline-danger" title="حذف المسودة"
                                                    data-confirm="حذف المسودة بالكامل: ستُحذف هذه المسودة وكل بنودها ومصاريفها نهائياً من قاعدة البيانات، ولن يؤثر ذلك على المخزون أو الأرصدة المالية لأنها لم تُرحّل بعد. هل تريد المتابعة؟">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
