@model BLL.DTOs.OpeningBalance.InComingData.CreateOpeningBalanceDto
@using System.Linq
@{
    ViewData["Title"] = "رصيد افتتاحي لعميل";
}

<h4 class="mb-3"><i class="bi bi-person-plus me-2"></i> رصيد افتتاحي لعميل</h4>

<div class="card shadow-sm">
    <div class="card-body">
        <div asp-validation-summary="All" class="text-danger mb-3"></div>

        <div class="alert alert-info">
            <i class="bi bi-info-circle me-2"></i>
            الرصيد الافتتاحي للعميل يُسجّل كمديونية (مبلغ يستحقه لكم) ويُضاف إلى كشف حسابه. مسجل مرة واحدة فقط لكل عميل، ولا يمكن تعديله لاحقًا.
        </div>

        <form asp-action="CreateCustomerBalance" method="post">
            <div class="mb-3">
                <label class="form-label">العميل</label>
                @if (ViewBag.Customers != null && ((SelectList)ViewBag.Customers).Count() > 0)
                {
                    <select asp-for="CustomerId" asp-items="ViewBag.Customers" class="form-select">
                        <option value="">-- اختر العميل --</option>
                    </select>
                    <span asp-validation-for="CustomerId" class="text-danger small"></span>
                }
                else
                {
                    <div class="alert alert-warning mb-0">
                        <i class="bi bi-exclamation-triangle me-2"></i>
                        لا يوجد عملاء نشطون بدون رصيد افتتاحي. جميع العملاء النشطين تم تسجيل رصيدهم الافتتاحي بالفعل.
                    </div>
                }
            </div>

            <div class="mb-3">
                <label asp-for="Amount" class="form-label">المبلغ الافتتاحي</label>
                <div class="input-group">
                    <input asp-for="Amount" type="number" step="0.01" min="0.01" class="form-control" placeholder="أدخل المبلغ" />
                    <span class="input-group-text">ج.م</span>
                </div>
                <span asp-validation-for="Amount" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="EffectiveDate" class="form-label">التاريخ المفعول</label>
                <input asp-for="EffectiveDate" type="date" class="form-control" />
                <span asp-validation-for="EffectiveDate" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Notes" class="form-label">ملاحظات</label>
                <textarea asp-for="Notes" class="form-control" rows="2" placeholder="ملاحظات إضافية (اختياري)"></textarea>
                <span asp-validation-for="Notes" class="text-danger small"></span>
            </div>

            <button type="submit" class="btn btn-primary">
                <i class="bi bi-check-lg me-1"></i> حفظ
            </button>
            <a asp-action="Index" class="btn btn-outline-secondary">رجوع</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
