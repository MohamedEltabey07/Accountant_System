@model BLL.DTOs.CreditNote.OutGoingData.CreditNoteDto
@{
    ViewData["Title"] = "إشعار مرتجع " + Model.CreditNoteNumber;
    var isDraft = Model.Status == DAL.Enums.CreditNoteStatus.Draft;
    var isPosted = Model.Status == DAL.Enums.CreditNoteStatus.Posted;
    var isCustomerReturn = Model.Type == DAL.Enums.CreditNoteType.CustomerReturn;
}

@using BLL.Service

<style>
    /* ==========================================================================
       A4 Printable Credit Note Stylesheet
       ========================================================================== */
    @@page {
        size: A4 portrait;
        margin: 10mm 12mm 12mm 12mm;
    }

    .credit-note-container {
        max-width: 900px;
        margin: 0 auto;
        background: #ffffff;
        border-radius: 16px;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.06);
        border: 1px solid #e2e8f0;
        overflow: hidden;
    }

    @@media print {
        html, body {
            background: #ffffff !important;
            color: #000000 !important;
            margin: 0 !important;
            padding: 0 !important;
            font-size: 12px !important;
            -webkit-print-color-adjust: exact !important;
            print-color-adjust: exact !important;
        }

        .d-print-none,
        .no-print,
        .sidebar,
        .top-navbar,
        .btn,
        .alert,
        header {
            display: none !important;
        }

        .main-content,
        .content-area {
            margin: 0 !important;
            padding: 0 !important;
            background: #fff !important;
        }

        .credit-note-container {
            max-width: 100% !important;
            width: 100% !important;
            box-shadow: none !important;
            border: none !important;
            border-radius: 0 !important;
            padding: 0 !important;
            margin: 0 !important;
        }

        .credit-header,
        .credit-party-card,
        .credit-table,
        .credit-totals,
        .credit-signatures {
            page-break-inside: avoid !important;
            break-inside: avoid !important;
        }
    }
</style>

<!-- Action Toolbar (Hidden on Print) -->
<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2 d-print-none">
    <div class="d-flex align-items-center gap-2">
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-right me-1"></i> رجوع لقائمة المرتجعات
        </a>
        <h4 class="mb-0 fw-bold text-dark">
            <i class="bi bi-arrow-return-left text-danger me-1"></i>
            إشعار دائن رقم @Model.CreditNoteNumber
        </h4>
        @if (isDraft)
        {
            <span class="badge bg-warning text-dark fs-6">مسودة</span>
        }
        else if (isPosted)
        {
            <span class="badge bg-success fs-6">مرحّل ومعتمد</span>
        }
        else
        {
            <span class="badge bg-secondary fs-6">ملغى</span>
        }
    </div>

    <div class="d-flex gap-2">
        <button type="button" class="btn btn-primary shadow-sm fw-bold" onclick="window.print()">
            <i class="bi bi-printer-fill me-1"></i> طباعة الإشعار (A4)
        </button>
        <a asp-action="Create" class="btn btn-outline-primary">
            <i class="bi bi-plus-lg me-1"></i> مرتجع جديد
        </a>
    </div>
</div>

<!-- ==========================================================================
     OFFICIAL A4 CREDIT NOTE SHEET
     ========================================================================== -->
<div class="credit-note-container p-4 p-md-5">

    <!-- Commercial Header -->
    <div class="credit-header pb-3 mb-4 border-bottom">
        <div class="row align-items-center g-3">
            <div class="col-7">
                <h3 class="fw-bold text-dark mb-1">
                    <i class="bi bi-calculator-fill text-primary me-1"></i> مؤسسة التجارة والتوريدات
                </h3>
                <div class="text-muted small">نظام إدارة المبيعات، الجملة، ومخازن التوريد</div>
                <div class="text-muted small mt-1">
                    <span><strong>س.ت:</strong> 104928</span> | 
                    <span><strong>ب.ض:</strong> 482-901-332</span>
                </div>
                <div class="text-muted small">
                    <i class="bi bi-geo-alt me-1"></i> جمهورية مصر العربية | هاتف: 01000000000
                </div>
            </div>

            <div class="col-5 text-start">
                <div class="p-2 rounded bg-light border text-center d-inline-block px-3">
                    <div class="small text-muted">نوع المستند التجاري</div>
                    <h5 class="fw-bold text-danger mb-0">
                        <i class="bi bi-arrow-return-left me-1"></i>
                        @(isCustomerReturn ? "إشعار دائن / مرتجع مبيعات" : "إشعار مدين / مرتجع مشتريات")
                    </h5>
                    <div class="font-monospace fw-bold fs-6 mt-1 text-dark">
                        @Model.CreditNoteNumber
                    </div>
                </div>
                <div class="small text-muted mt-2 text-start">
                    <span>تاريخ المعاملة: <strong>@Model.TransactionDate.ToString("yyyy-MM-dd")</strong></span>
                </div>
            </div>
        </div>
    </div>

    <!-- Original Invoice & Party Card -->
    <div class="credit-party-card p-3 rounded-3 border bg-light mb-4">
        <div class="row g-3">
            <div class="col-md-7 border-start">
                <small class="text-muted fw-bold d-block mb-1">بيانات الفاتورة الأصلية المرتبطة:</small>
                <div class="fw-bold text-dark fs-5">
                    الفاتورة رقم: <span class="font-monospace text-primary">@Model.OriginalInvoiceNumber</span>
                </div>
                <div class="small text-muted mt-1">
                    تاريخ الترحيل: <strong>@(Model.PostedAt?.ToString("yyyy-MM-dd hh:mm tt") ?? "-")</strong>
                </div>
                @if (!string.IsNullOrWhiteSpace(Model.Reason))
                {
                    <div class="small text-danger mt-2">
                        <strong>سبب الارتجاع:</strong> @Model.Reason
                    </div>
                }
            </div>

            <div class="col-md-5">
                <small class="text-muted fw-bold d-block mb-1">الأثر المحاسبي للمستند:</small>
                <div class="fw-bold text-dark mb-1">
                    @(isCustomerReturn ? "تخفيض حساب العميل المدين وقيمة الفاتورة" : "تخفيض حساب المورد الدائن وقيمة الفاتورة")
                </div>
                <div class="small text-muted">
                    الحالة: <strong>@(isPosted ? "مرحّل ومخصوم نهائياً" : "مسودة عمل")</strong>
                </div>
            </div>
        </div>
    </div>

    <!-- Returned Items Table -->
    <div class="credit-table mb-4">
        <table class="table table-bordered align-middle text-center mb-0">
            <thead class="table-dark">
                <tr>
                    <th style="width: 50px;">#</th>
                    <th class="text-start">اسم الصنف المرتجع</th>
                    <th style="width: 110px;">الكمية المرتجعة</th>
                    <th style="width: 120px;">سعر الوحدة</th>
                    <th style="width: 140px;">إجمالي المرتجع</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Items.Count == 0)
                {
                    <tr>
                        <td colspan="5" class="text-muted py-4">لا توجد أصناف في هذا المرتجع.</td>
                    </tr>
                }
                else
                {
                    int itemIdx = 1;
                    foreach (var item in Model.Items)
                    {
                        <tr>
                            <td class="text-muted fw-bold">@(itemIdx++)</td>
                            <td class="text-start fw-bold text-dark">@item.ProductName</td>
                            <td class="font-tabular fw-bold text-danger">@item.Quantity.ToString("N2")</td>
                            <td class="font-tabular">@item.UnitPrice.ToString("N2") ج.م</td>
                            <td class="font-tabular fw-bold text-dark">@item.LineTotal.ToString("N2") ج.م</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <!-- Totals & Tafqeet Box -->
    <div class="credit-totals p-3 rounded-3 border bg-light mb-4">
        <div class="row align-items-center">
            <div class="col-md-7 border-start">
                <small class="text-muted fw-bold d-block mb-1">إجمالي المبلغ المخصوم كتابةً (فقط وقدره):</small>
                <div class="fw-bold text-dark fs-6">
                    @Tafqeet.ToArabicWords(Model.TotalAmount)
                </div>
            </div>
            <div class="col-md-5 text-start ps-md-4">
                <span class="text-muted small fw-bold d-block mb-1">صافي قيمة الإشعار الدائن:</span>
                <div class="fs-4 fw-bold font-tabular text-danger">
                    @Model.TotalAmount.ToString("N2") <small class="fs-6 text-dark">ج.م</small>
                </div>
            </div>
        </div>
    </div>

    <!-- Post Action (Screen Only in Draft) -->
    @if (isDraft)
    {
        <div class="card border-warning shadow-sm mb-4 d-print-none">
            <div class="card-body">
                <h6 class="fw-bold text-dark mb-1"><i class="bi bi-lightning-charge text-warning me-1"></i> ترحيل المرتجع:</h6>
                <p class="text-muted small mb-3">
                    عند ترحيل المرتجع يتم تخفيض قيمة الفاتورة الأصلية (المتبقي غير المسدد) في الدفاتر المحاسبية.
                </p>

                <form asp-action="Post" method="post" id="postCreditNoteForm">
                    <input type="hidden" name="CreditNoteId" value="@Model.Id" />
                    <div class="form-check form-switch fs-6 mb-3">
                        <input class="form-check-input" type="checkbox" role="switch" id="idIsCashRefund" name="IsCashRefund" value="true" />
                        <label class="form-check-label fw-bold" for="idIsCashRefund">صرف نقدية فورية من الخزينة (رد نقدي)؟</label>
                    </div>
                    <button type="submit" class="btn btn-warning fw-bold">
                        <i class="bi bi-check-square me-1"></i> ترحيل واعتماد المرتجع
                    </button>
                </form>
            </div>
        </div>
    }

    <!-- Dual Signature Blocks -->
    <div class="credit-signatures pt-4 border-top mt-5">
        <div class="row text-center">
            <div class="col-6">
                <div class="text-muted small mb-4">توقيع المستلم / مندوب الطرف الثاني</div>
                <div class="d-inline-block border-bottom border-dark pb-1 px-5">
                    ............................................................
                </div>
            </div>
            <div class="col-6">
                <div class="text-muted small mb-4">توقيع مسؤول المخزن / أمين الحسابات</div>
                <div class="d-inline-block border-bottom border-dark pb-1 px-5">
                    ............................................................
                </div>
            </div>
        </div>

        <div class="text-center text-muted small mt-4 pt-2 border-top">
            <p class="mb-0">
                • تم فحص الأصناف المرتجعة واستلامها بحالتها الأصلية بالمخازن وتعديل الأرصدة الدفترية.
            </p>
        </div>
    </div>
</div>

@section Scripts {
    @if (isDraft)
    {
        <script>
            document.getElementById('postCreditNoteForm').addEventListener('submit', function (e) {
                e.preventDefault();
                var cashRefund = document.getElementById('idIsCashRefund').checked;
                Swal.fire({
                    icon: 'warning',
                    title: 'ترحيل المرتجع نهائيًا؟',
                    text: cashRefund
                        ? 'سيتم تعديل رصيد الفاتورة الأصلية وإصدار حركة نقدية من الخزينة فوراً. لا يمكن التراجع.'
                        : 'سيتم تعديل رصيد الفاتورة الأصلية نهائياً. لا يمكن التراجع.',
                    showCancelButton: true,
                    confirmButtonText: 'نعم، ترحيل',
                    cancelButtonText: 'إلغاء',
                    confirmButtonColor: '#e11d48'
                }).then(function (result) {
                    if (result.isConfirmed) {
                        e.target.submit();
                    }
                });
            });
        </script>
    }
}