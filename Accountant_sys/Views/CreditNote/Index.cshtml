@model List<BLL.DTOs.CreditNote.OutGoingData.CreditNoteDto>
@{
    ViewData["Title"] = "إشعارات المرتجع";
}

<!-- Page Header -->
<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
    <div>
        <h3 class="fw-bold mb-1">
            <i class="bi bi-arrow-return-left text-info me-2"></i> إشعارات المرتجع والخصم (Credit Notes)
        </h3>
        <p class="text-muted mb-0">إثبات مرتجعات مبيعات العملاء ومرتجعات مشتريات الموردين وتعديل الأرصدة</p>
    </div>
    <div class="d-flex gap-2">
        <button type="button" class="btn btn-outline-success shadow-sm" onclick="exportTableToCSV('creditNoteTable', 'سجل_المرتجعات')">
            <i class="bi bi-file-earmark-excel me-1"></i> تصدير Excel
        </button>
        <a asp-action="Create" class="btn btn-primary shadow-sm fw-bold">
            <i class="bi bi-plus-lg me-1"></i> إنشاء إشعار مرتجع
        </a>
    </div>
</div>

<!-- Filters Card -->
<div class="card shadow-sm border-0 mb-3">
    <div class="card-body p-3">
        <form method="get" class="row g-2 align-items-end mb-2" asp-controller="CreditNote" asp-action="Index">
            <div class="col-sm-6 col-md-5">
                <label class="form-label small fw-bold text-muted">نوع الإشعار</label>
                <select name="type" class="form-select form-select-sm" asp-items="ViewBag.TypeOptions" onchange="this.form.submit()">
                </select>
            </div>
            <div class="col-sm-6 col-md-5">
                <label class="form-label small fw-bold text-muted">حالة الإشعار</label>
                <select name="status" class="form-select form-select-sm" asp-items="ViewBag.StatusOptions" onchange="this.form.submit()">
                </select>
            </div>
            <div class="col-md-2">
                <a asp-action="Index" class="btn btn-sm btn-outline-secondary w-100">
                    <i class="bi bi-arrow-clockwise me-1"></i> إعادة ضبط
                </a>
            </div>
        </form>

        <div class="row align-items-center pt-2 border-top g-2">
            <div class="col-md-6">
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                    <input type="text" class="form-control border-start-0" placeholder="بحث فوري برقم الإشعار أو الفاتورة..." data-table-search="creditNoteTable" data-counter-target="cnCounter" />
                </div>
            </div>
            <div class="col-md-6 text-md-start">
                <span class="badge bg-light text-dark border p-2 font-tabular" id="cnCounter">
                    عرض @Model.Count من إجمالي @Model.Count إشعار
                </span>
            </div>
        </div>
    </div>
</div>

<!-- Credit Notes Table Card -->
<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        @if (Model.Count == 0)
        {
            <div class="text-center text-muted py-5">
                <i class="bi bi-inbox fs-1 d-block mb-3 text-secondary"></i>
                <h5 class="fw-bold text-dark">لا توجد إشعارات مرتجع مسجلة</h5>
                <p class="text-muted small mb-3">يمكنك إصدار إشعار مرتجع مرتبط بأي فاتورة مبيعات أو مشتريات مرحلة.</p>
                <a asp-action="Create" class="btn btn-primary btn-sm">
                    <i class="bi bi-plus-lg me-1"></i> إنشاء إشعار مرتجع جديد
                </a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-modern align-middle text-center mb-0" id="creditNoteTable">
                    <thead>
                        <tr>
                            <th>رقم الإشعار</th>
                            <th>النوع</th>
                            <th>الفاتورة الأصلية</th>
                            <th>التاريخ</th>
                            <th>إجمالي المرتجع</th>
                            <th>الحالة</th>
                            <th class="no-export">الإجراءات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var note in Model)
                        {
                            <tr>
                                <td class="fw-bold font-monospace text-primary">
                                    @(note.CreditNoteNumber.StartsWith("CN-") ? note.CreditNoteNumber : "CN-" + note.CreditNoteNumber)
                                </td>
                                <td>
                                    @if (note.Type == DAL.Enums.CreditNoteType.CustomerReturn)
                                    {
                                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle">
                                            <i class="bi bi-person me-1"></i> مرتجع عميل
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle">
                                            <i class="bi bi-truck me-1"></i> مرتجع مورد
                                        </span>
                                    }
                                </td>
                                <td>
                                    <a asp-controller="Invoice" asp-action="Details" asp-route-id="@note.OriginalInvoiceId" class="text-decoration-none fw-bold font-monospace">
                                        @note.OriginalInvoiceNumber
                                    </a>
                                </td>
                                <td class="font-tabular">@note.TransactionDate.ToString("yyyy-MM-dd")</td>
                                <td class="fw-bold font-tabular text-danger">-@note.TotalAmount.ToString("N2") ج.م</td>
                                <td>
                                    @if (note.Status == DAL.Enums.CreditNoteStatus.Draft)
                                    {
                                        <span class="badge bg-warning text-dark">مسودة</span>
                                    }
                                    else if (note.Status == DAL.Enums.CreditNoteStatus.Posted)
                                    {
                                        <span class="badge bg-success">مرحّل</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">ملغى</span>
                                    }
                                </td>
                                <td class="no-export">
                                    <a asp-action="Details" asp-route-id="@note.Id" class="btn btn-sm btn-outline-info" title="عرض تفاصيل المرتجع">
                                        <i class="bi bi-eye"></i> تفاصيل
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
