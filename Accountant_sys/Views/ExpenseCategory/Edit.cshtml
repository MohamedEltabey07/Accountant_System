@model BLL.DTOs.ExpenseCategory.InComingData.UpdateExpenseCategoryDto
@{
    ViewData["Title"] = "تعديل بند المصروف";
}

<h4 class="mb-3"><i class="bi bi-pencil-square me-2"></i> تعديل بند المصروف</h4>

<div class="card shadow-sm">
    <div class="card-body">
        <div asp-validation-summary="All" class="text-danger mb-3"></div>

        <form asp-action="Edit" method="post">
            <input type="hidden" asp-for="Id" />

            <div class="mb-3">
                <label asp-for="Name" class="form-label">اسم البند</label>
                <input asp-for="Name" class="form-control" placeholder="أدخل اسم البند" />
                <span asp-validation-for="Name" class="text-danger small"></span>
            </div>

            <div class="mb-3 form-check form-switch">
                <input asp-for="IsActive" class="form-check-input" type="checkbox" role="switch" />
                <label asp-for="IsActive" class="form-check-label">بند نشط</label>
            </div>

            <button type="submit" class="btn btn-primary">
                <i class="bi bi-check-lg me-1"></i> حفظ
            </button>
            <a asp-action="Index" class="btn btn-outline-secondary">رجوع</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
