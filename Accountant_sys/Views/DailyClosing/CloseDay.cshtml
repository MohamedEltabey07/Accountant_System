@model Accountant_sys.Models.CloseDayViewModel
@{
    ViewData["Title"] = "إقفال اليومية (جرد الخزينة)";
}

<div class="row justify-content-center">
    <div class="col-lg-10">
        <!-- Header -->
        <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
            <div>
                <h3 class="fw-bold mb-1">
                    <i class="bi bi-calendar-check text-primary me-2"></i> إقفال الوردية وجرد الخزينة
                </h3>
                <p class="text-muted mb-0">مطابقة النقدية الفعلية مع السجلات الدفترية وإثبات العجز أو الزيادة</p>
            </div>
            <div class="d-flex gap-2">
                <a asp-action="Index" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-right me-1"></i> العودة للسجل
                </a>
            </div>
        </div>

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @if (Model.IsAlreadyClosed)
        {
            <div class="card shadow-sm border-0 border-start border-success border-4 mb-4 bg-success-subtle">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
                        <div class="d-flex align-items-center gap-3">
                            <i class="bi bi-shield-lock-fill fs-1 text-success"></i>
                            <div>
                                <h5 class="fw-bold text-success mb-1">تم إقفال وردية هذا اليوم مسبقاً!</h5>
                                <p class="mb-0 text-muted">
                                    يومية <strong>@Model.Form.BusinessDate.ToString("yyyy-MM-dd")</strong> مقفلة ومعتمدة.
                                    @if (Model.ExistingClosing?.ClosedAt != null)
                                    {
                                        <span>تاريخ الإقفال: @Model.ExistingClosing.ClosedAt.Value.ToLocalTime().ToString("yyyy-MM-dd hh:mm tt")</span>
                                    }
                                </p>
                            </div>
                        </div>
                        <div class="d-flex gap-2">
                            <a asp-action="Details" asp-route-date="@Model.Form.BusinessDate.ToString("yyyy-MM-dd")" class="btn btn-success fw-bold">
                                <i class="bi bi-file-earmark-text me-1"></i> عرض تقرير الإقفال
                            </a>
                            <a asp-action="Index" class="btn btn-outline-secondary">
                                <i class="bi bi-list-ul me-1"></i> سجل الإقفالات
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }

        <!-- Business Date Selector Bar -->
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-body p-3">
                <form method="get" asp-action="CloseDay" class="row g-2 align-items-center">
                    <div class="col-auto">
                        <label class="form-label mb-0 fw-bold text-dark"><i class="bi bi-calendar3 me-1"></i> تاريخ الوردية المراد جردها:</label>
                    </div>
                    <div class="col-sm-4 col-md-3">
                        <input type="date" name="date" value="@Model.Form.BusinessDate.ToString("yyyy-MM-dd")" class="form-control" onchange="this.form.submit()" />
                    </div>
                    <div class="col-auto">
                        <button type="submit" class="btn btn-outline-primary btn-sm">
                            <i class="bi bi-arrow-clockwise me-1"></i> تحديث الأرقام
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <!-- Ledger Financial Summary Cards -->
        <div class="row g-3 mb-4">
            <div class="col-md-4">
                <div class="card shadow-sm border-0 h-100 bg-white border-bottom border-success border-3">
                    <div class="card-body text-center p-3">
                        <span class="text-muted small fw-bold d-block mb-1">إجمالي الوارد اليوم (Cash In)</span>
                        <h4 class="fw-bold text-success mb-0" id="previewCashIn">
                            +@Model.Preview.TotalCashIn.ToString("N2") <small class="fs-6 text-muted">ج.م</small>
                        </h4>
                        <small class="text-muted">مقبوضات ومبيعات نقدية</small>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card shadow-sm border-0 h-100 bg-white border-bottom border-danger border-3">
                    <div class="card-body text-center p-3">
                        <span class="text-muted small fw-bold d-block mb-1">إجمالي المنصرف اليوم (Cash Out)</span>
                        <h4 class="fw-bold text-danger mb-0" id="previewCashOut">
                            -@Model.Preview.TotalCashOut.ToString("N2") <small class="fs-6 text-muted">ج.م</small>
                        </h4>
                        <small class="text-muted">مدفوعات ومصروفات نقدية</small>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card shadow-sm border-0 h-100 bg-white border-bottom border-primary border-3">
                    <div class="card-body text-center p-3">
                        <span class="text-muted small fw-bold d-block mb-1">المتوقع دفترياً بالدرج</span>
                        <h4 class="fw-bold text-dark mb-0" id="previewExpectedCash">
                            @Model.Preview.ExpectedClosingCashAmount.ToString("N2") <small class="fs-6 text-muted">ج.م</small>
                        </h4>
                        <small class="text-muted">الرصيد الافتتاحي + الوارد - المنصرف</small>
                    </div>
                </div>
            </div>
        </div>

        @if (!Model.IsAlreadyClosed)
        {
            <!-- Closing Form Card -->
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white py-3 border-bottom">
                    <h5 class="card-title mb-0 fw-bold text-dark">
                        <i class="bi bi-pencil-square text-primary me-2"></i> بيانات الجرد والإقفال الفعلي
                    </h5>
                </div>
                <div class="card-body p-4">
                    <form asp-action="CloseDay" method="post" id="closingForm">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="Form.BusinessDate" />

                        <div class="row g-4">
                            <!-- Opening Cash Amount Input -->
                            <div class="col-md-6">
                                <label asp-for="Form.OpeningCashAmount" class="form-label fw-bold">
                                    رصيد بداية اليوم (عهدة الافتتاح) <span class="text-danger">*</span>
                                </label>
                                <div class="input-group input-group-lg">
                                    <input asp-for="Form.OpeningCashAmount" type="number" step="0.01" min="0" class="form-control text-center fw-bold" id="inputOpeningCash" />
                                    <span class="input-group-text">ج.م</span>
                                </div>
                                <span asp-validation-for="Form.OpeningCashAmount" class="text-danger small"></span>
                                <small class="text-muted d-block mt-1">المبلغ النقدي الذي بدأ به الدرج في بداية الوردية.</small>
                            </div>

                            <!-- Counted Cash Amount Input -->
                            <div class="col-md-6">
                                <label asp-for="Form.CountedCashAmount" class="form-label fw-bold">
                                    المبلغ الفعلي بالجرد (الموجود بالدرج حالياً) <span class="text-danger">*</span>
                                </label>
                                <div class="input-group input-group-lg">
                                    <input asp-for="Form.CountedCashAmount" type="number" step="0.01" min="0" class="form-control text-center fw-bold text-primary" id="inputCountedCash" required />
                                    <span class="input-group-text">ج.م</span>
                                </div>
                                <span asp-validation-for="Form.CountedCashAmount" class="text-danger small"></span>
                                <small class="text-muted d-block mt-1">العدّ الفعلي للفلوس النقدية الموجودة في الخزينة الآن.</small>
                            </div>

                            <!-- Live Calculation Result Panel -->
                            <div class="col-12">
                                <div class="p-4 rounded-3 border bg-light text-center" id="calculationPanel">
                                    <div class="row align-items-center">
                                        <div class="col-md-4 text-md-start">
                                            <span class="text-muted small d-block">الرصيد الدفتري المحسوب:</span>
                                            <h5 class="fw-bold mb-0 text-dark" id="calcExpectedDisplay">0.00 ج.م</h5>
                                        </div>
                                        <div class="col-md-4 text-center my-2 my-md-0">
                                            <span class="text-muted small d-block">الفارق بين الفعلي والدفتري:</span>
                                            <h4 class="fw-bold mb-0" id="calcDiffDisplay">0.00 ج.م</h4>
                                        </div>
                                        <div class="col-md-4 text-md-end">
                                            <span class="badge p-2 fs-6" id="calcStatusBadge">
                                                <i class="bi bi-clock me-1"></i> بانتظار إدخال الجرد
                                            </span>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Notes -->
                            <div class="col-12">
                                <label asp-for="Form.Notes" class="form-label fw-bold">ملاحظات الإقفال (اختياري)</label>
                                <textarea asp-for="Form.Notes" class="form-control" rows="3" placeholder="أي ملاحظات حول الجرد أو أسباب العجز أو الزيادة إن وجدت..."></textarea>
                                <span asp-validation-for="Form.Notes" class="text-danger small"></span>
                            </div>

                            <!-- Submit Buttons -->
                            <div class="col-12 d-flex justify-content-end gap-2 border-top pt-3">
                                <a asp-action="Index" class="btn btn-outline-secondary px-4">إلغاء</a>
                                <button type="button" class="btn btn-primary px-5 fw-bold shadow-sm" id="btnConfirmSubmit">
                                    <i class="bi bi-check2-circle me-1"></i> اعتماد وإقفال اليومية
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const totalCashIn = @Model.Preview.TotalCashIn;
        const totalCashOut = @Model.Preview.TotalCashOut;

        const inputOpening = document.getElementById('inputOpeningCash');
        const inputCounted = document.getElementById('inputCountedCash');
        const calcExpectedDisplay = document.getElementById('calcExpectedDisplay');
        const calcDiffDisplay = document.getElementById('calcDiffDisplay');
        const calcStatusBadge = document.getElementById('calcStatusBadge');
        const btnConfirm = document.getElementById('btnConfirmSubmit');
        const closingForm = document.getElementById('closingForm');

        function updateCalculations() {
            if (!inputOpening || !inputCounted) return;

            const opening = parseFloat(inputOpening.value) || 0;
            const counted = parseFloat(inputCounted.value) || 0;

            const expected = (opening + totalCashIn) - totalCashOut;
            const diff = counted - expected;

            calcExpectedDisplay.textContent = expected.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' ج.م';

            if (inputCounted.value.trim() === '') {
                calcDiffDisplay.textContent = '-';
                calcDiffDisplay.className = 'fw-bold mb-0 text-muted';
                calcStatusBadge.className = 'badge bg-secondary p-2 fs-6';
                calcStatusBadge.innerHTML = '<i class="bi bi-pencil me-1"></i> يرجى إدخال المبلغ الفعلي';
                return;
            }

            if (Math.abs(diff) < 0.01) {
                calcDiffDisplay.textContent = '0.00 ج.م';
                calcDiffDisplay.className = 'fw-bold mb-0 text-success';
                calcStatusBadge.className = 'badge bg-success p-2 fs-6';
                calcStatusBadge.innerHTML = '<i class="bi bi-check-circle-fill me-1"></i> مطابق تماماً (لا عجز ولا زيادة)';
            } else if (diff < 0) {
                calcDiffDisplay.textContent = diff.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' ج.م';
                calcDiffDisplay.className = 'fw-bold mb-0 text-danger';
                calcStatusBadge.className = 'badge bg-danger p-2 fs-6';
                calcStatusBadge.innerHTML = `<i class="bi bi-arrow-down-circle-fill me-1"></i> عجز بالخزينة بقيمة ${Math.abs(diff).toFixed(2)} ج.م`;
            } else {
                calcDiffDisplay.textContent = '+' + diff.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' ج.م';
                calcDiffDisplay.className = 'fw-bold mb-0 text-info';
                calcStatusBadge.className = 'badge bg-info text-dark p-2 fs-6';
                calcStatusBadge.innerHTML = `<i class="bi bi-arrow-up-circle-fill me-1"></i> زيادة بالخزينة بقيمة ${diff.toFixed(2)} ج.م`;
            }
        }

        if (inputOpening) inputOpening.addEventListener('input', updateCalculations);
        if (inputCounted) inputCounted.addEventListener('input', updateCalculations);

        updateCalculations();

        if (btnConfirm) {
            btnConfirm.addEventListener('click', function () {
                const counted = parseFloat(inputCounted.value) || 0;
                const opening = parseFloat(inputOpening.value) || 0;
                const expected = (opening + totalCashIn) - totalCashOut;
                const diff = counted - expected;

                let message = `المبلغ المعدود بالجرد: ${counted.toFixed(2)} ج.م\nالمتوقع دفترياً: ${expected.toFixed(2)} ج.م\n`;
                if (Math.abs(diff) < 0.01) {
                    message += "الخزينة مطابقة تماماً.";
                } else if (diff < 0) {
                    message += `تحذير: يوجد عجز بقيمة ${Math.abs(diff).toFixed(2)} ج.م!`;
                } else {
                    message += `ملاحظة: توجد زيادة بقيمة ${diff.toFixed(2)} ج.م.`;
                }
                message += "\n\nهل أنت متأكد من اعتماد إقفال وردية هذا اليوم؟";

                if (confirm(message)) {
                    closingForm.submit();
                }
            });
        }
    </script>
}
