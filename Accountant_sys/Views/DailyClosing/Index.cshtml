@model List<BLL.DTOs.DailyClosing.OutGoingData.DailyClosingDto>
@{
    ViewData["Title"] = "سجل الإقفال اليومي";
}

<!-- Page Header -->
<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
    <div>
        <h3 class="fw-bold mb-1">
            <i class="bi bi-calendar-check text-primary me-2"></i> سجل الإقفال اليومي (الورديات)
        </h3>
        <p class="text-muted mb-0">متابعة إقفالات الصندوق، الفوارق والعجز والزيادة النقدية لكل يوم عمل</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="CloseDay" class="btn btn-primary shadow-sm fw-bold">
            <i class="bi bi-plus-lg me-1"></i> إقفال يومية جديد
        </a>
    </div>
</div>

<!-- Alerts -->
@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Filter Form -->
<div class="card shadow-sm border-0 mb-4">
    <div class="card-body p-3">
        <form method="get" asp-action="Index" class="row g-2 align-items-end">
            <div class="col-sm-6 col-md-4">
                <label class="form-label small fw-bold text-muted">من تاريخ</label>
                <input type="date" name="from" value="@ViewBag.From" class="form-control" />
            </div>
            <div class="col-sm-6 col-md-4">
                <label class="form-label small fw-bold text-muted">إلى تاريخ</label>
                <input type="date" name="to" value="@ViewBag.To" class="form-control" />
            </div>
            <div class="col-md-4 d-flex gap-2">
                <button type="submit" class="btn btn-outline-primary flex-grow-1">
                    <i class="bi bi-search me-1"></i> تصفية
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary">
                    <i class="bi bi-x-circle me-1"></i> إعادة ضبط
                </a>
            </div>
        </form>
    </div>
</div>

<!-- Closings Data Table -->
<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 text-center">
                <thead class="table-light">
                    <tr>
                        <th>#</th>
                        <th>تاريخ اليومية</th>
                        <th>الرصيد الافتتاحي</th>
                        <th>الوارد (Cash In)</th>
                        <th>المنصرف (Cash Out)</th>
                        <th>المتوقع دفترياً</th>
                        <th>الفعلي المعدود</th>
                        <th>الفارق (عجز / زيادة)</th>
                        <th>الحالة</th>
                        <th>وقت الإقفال</th>
                        <th>الإجراءات</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model == null || !Model.Any())
                    {
                        <tr>
                            <td colspan="11" class="text-center py-5 text-muted">
                                <i class="bi bi-inbox fs-1 d-block mb-2 text-secondary"></i>
                                لا توجد سجلات إقفال يومي مسجلة في هذه الفترة
                            </td>
                        </tr>
                    }
                    else
                    {
                        var index = 1;
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="text-muted fw-bold">@index</td>
                                <td class="fw-bold">
                                    @item.BusinessDate.ToString("yyyy-MM-dd")
                                    <small class="d-block text-muted">@item.BusinessDate.ToString("dddd", new System.Globalization.CultureInfo("ar-EG"))</small>
                                </td>
                                <td>@item.OpeningCashAmount.ToString("N2") ج.م</td>
                                <td class="text-success fw-bold">+@item.TotalCashIn.ToString("N2") ج.م</td>
                                <td class="text-danger fw-bold">-@item.TotalCashOut.ToString("N2") ج.م</td>
                                <td class="fw-bold text-dark">@item.ExpectedClosingCashAmount.ToString("N2") ج.م</td>
                                <td class="fw-bold text-primary">
                                    @(item.CountedClosingCashAmount.HasValue ? item.CountedClosingCashAmount.Value.ToString("N2") + " ج.م" : "-")
                                </td>
                                <td>
                                    @if (!item.DifferenceAmount.HasValue || item.DifferenceAmount.Value == 0)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success px-2 py-1">
                                            <i class="bi bi-check-circle me-1"></i> مطابق (0.00)
                                        </span>
                                    }
                                    else if (item.DifferenceAmount.Value < 0)
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger px-2 py-1" title="عجز بالخزينة">
                                            <i class="bi bi-arrow-down-circle me-1"></i> عجز (@Math.Abs(item.DifferenceAmount.Value).ToString("N2")-)
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-info-subtle text-info border border-info px-2 py-1" title="فائض / زيادة بالخزينة">
                                            <i class="bi bi-arrow-up-circle me-1"></i> زيادة (@item.DifferenceAmount.Value.ToString("N2")+)
                                        </span>
                                    }
                                </td>
                                <td>
                                    @if (item.IsClosed)
                                    {
                                        <span class="badge bg-success">
                                            <i class="bi bi-lock-fill me-1"></i> مقفلة
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark">
                                            <i class="bi bi-unlock-fill me-1"></i> مفتوحة
                                        </span>
                                    }
                                </td>
                                <td class="small text-muted">
                                    @(item.ClosedAt.HasValue ? item.ClosedAt.Value.ToLocalTime().ToString("yyyy-MM-dd hh:mm tt") : "-")
                                </td>
                                <td>
                                    <div class="btn-group btn-group-sm">
                                        <a asp-action="Details" asp-route-date="@item.BusinessDate.ToString("yyyy-MM-dd")" class="btn btn-outline-primary" title="عرض التفاصيل والطباعة">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        @if (item.IsClosed)
                                        {
                                            <button type="button" class="btn btn-outline-warning" 
                                                    data-bs-toggle="modal" 
                                                    data-bs-target="#reopenModal" 
                                                    data-id="@item.Id" 
                                                    data-date="@item.BusinessDate.ToString("yyyy-MM-dd")"
                                                    title="إعادة فتح اليومية">
                                                <i class="bi bi-unlock"></i>
                                            </button>
                                        }
                                        else
                                        {
                                            <a asp-action="CloseDay" asp-route-date="@item.BusinessDate.ToString("yyyy-MM-dd")" class="btn btn-warning" title="إتمام الإقفال">
                                                <i class="bi bi-check-lg"></i>
                                            </a>
                                        }
                                    </div>
                                </td>
                            </tr>
                            index++;
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Reopen Modal -->
<div class="modal fade" id="reopenModal" tabindex="-1" aria-labelledby="reopenModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="Reopen" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header bg-warning-subtle">
                    <h5 class="modal-title text-dark fw-bold" id="reopenModalLabel">
                        <i class="bi bi-unlock-fill text-warning me-2"></i> إعادة فتح اليومية
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="DailyClosingId" id="modalClosingId" />
                    
                    <p class="text-muted">
                        هل أنت متأكد من رغبتك في إعادة فتح يومية <span id="modalClosingDate" class="fw-bold text-dark"></span>؟
                        <br />
                        <span class="small text-danger">ملاحظة: إعادة الفتح ستتيح تسجيل وتعديل الحركات النقدية لهذا اليوم حتى يتم إقفاله مجدداً.</span>
                    </p>

                    <div class="mb-3">
                        <label class="form-label fw-bold small">سبب إعادة الفتح (مطلوب لأغراض التدقيق الرقابي) <span class="text-danger">*</span></label>
                        <textarea name="Reason" class="form-control" rows="3" required placeholder="مثال: إضافة سند قبض نقدي متأخر تم استلامه قبل نهاية الدوام..."></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">إلغاء</button>
                    <button type="submit" class="btn btn-warning fw-bold">تأكيد إعادة الفتح</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const reopenModal = document.getElementById('reopenModal');
        if (reopenModal) {
            reopenModal.addEventListener('show.bs.modal', function (event) {
                const button = event.relatedTarget;
                const id = button.getAttribute('data-id');
                const date = button.getAttribute('data-date');
                document.getElementById('modalClosingId').value = id;
                document.getElementById('modalClosingDate').textContent = date;
            });
        }
    </script>
}
