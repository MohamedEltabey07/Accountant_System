@{
    ViewData["Title"] = "الخزينة والمدفوعات";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
    <div>
        <h3 class="fw-bold mb-1">
            <i class="bi bi-credit-card-2-front text-primary me-2"></i> حركة الخزينة والمدفوعات
        </h3>
        <p class="text-muted mb-0">تسجيل وتوزيع دفعات وسندات القبض للعملاء وسندات الصرف للموردين</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-controller="DailyClosing" asp-action="CloseDay" class="btn btn-outline-warning">
            <i class="bi bi-calendar-check me-1"></i> إقفال الوردية
        </a>
    </div>
</div>

<div class="row g-4 justify-content-center">
    <!-- Customer Payment (Cash In) -->
    <div class="col-md-6 col-lg-5">
        <div class="card card-interactive h-100 border-0 border-top border-success border-4 shadow-sm">
            <div class="card-body p-4 text-center">
                <div class="p-3 bg-success-subtle text-success rounded-circle d-inline-flex mb-3">
                    <i class="bi bi-cash-stack fs-1"></i>
                </div>
                <h4 class="fw-bold text-dark mb-2">سند قبض عميل (وارد نقدية)</h4>
                <p class="text-muted small mb-4">
                    تسجيل دفعة نقدية مستلمة من عميل وإيداعها في الخزينة مع توزيعها تلقائياً أو يدوياً على الفواتير الآجلة المفتوحة وتحديث رصيد العميل.
                </p>
                <a asp-controller="Payment" asp-action="CustomerPayment" class="btn btn-success fw-bold px-4 shadow-sm w-100">
                    <i class="bi bi-plus-lg me-1"></i> تسجيل سند قبض جديد
                </a>
            </div>
        </div>
    </div>

    <!-- Vendor Payment (Cash Out) -->
    <div class="col-md-6 col-lg-5">
        <div class="card card-interactive h-100 border-0 border-top border-danger border-4 shadow-sm">
            <div class="card-body p-4 text-center">
                <div class="p-3 bg-danger-subtle text-danger rounded-circle d-inline-flex mb-3">
                    <i class="bi bi-wallet2 fs-1"></i>
                </div>
                <h4 class="fw-bold text-dark mb-2">سند صرف مورد (منصرف نقدية)</h4>
                <p class="text-muted small mb-4">
                    صرف دفعة نقدية من الخزينة لمورد بضاعة وتوزيعها على فواتير المشتريات المعلقة لسداد الالتزامات وتقليل رصيد المورد الدائن.
                </p>
                <a asp-controller="Payment" asp-action="VendorPayment" class="btn btn-danger fw-bold px-4 shadow-sm w-100">
                    <i class="bi bi-plus-lg me-1"></i> تسجيل سند صرف جديد
                </a>
            </div>
        </div>
    </div>
</div>
