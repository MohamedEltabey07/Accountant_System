@model BLL.DTOs.Payment.InComingData.CreateCustomerPaymentDto
@{
    ViewData["Title"] = "سند قبض - عميل";
}

<h4 class="mb-3"><i class="bi bi-cash-coin me-2 text-primary"></i> سند قبض - عميل وتوزيع الدفعات</h4>

<form asp-action="CustomerPayment" method="post" id="paymentForm">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <div class="row g-3">
        <div class="col-lg-4">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-light fw-bold"><i class="bi bi-1-square me-2"></i> اختيار العميل</div>
                <div class="card-body">
                    <div class="mb-3">
                        <label class="form-label">العميل</label>
                        <select asp-for="CustomerId" asp-items="ViewBag.Customers" class="form-select" id="idCustomerSelect">
                            <option value="">-- اختر العميل --</option>
                        </select>
                        <span asp-validation-for="CustomerId" class="text-danger small"></span>
                    </div>
                    <div class="mb-0">
                        <label asp-for="PaymentDate" class="form-label">تاريخ الاستلام</label>
                        <input asp-for="PaymentDate" type="date" class="form-control" id="idPaymentDate" />
                        <span asp-validation-for="PaymentDate" class="text-danger small"></span>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-light fw-bold"><i class="bi bi-2-square me-2"></i> مبلغ الدفعة</div>
                <div class="card-body">
                    <div class="mb-3">
                        <label asp-for="Amount" class="form-label">المبلغ المستلم</label>
                        <div class="input-group">
                            <input asp-for="Amount" type="number" step="0.01" min="0.01" class="form-control form-control-lg" id="idAmount" placeholder="0.00" />
                            <span class="input-group-text">ج.م</span>
                        </div>
                        <span asp-validation-for="Amount" class="text-danger small"></span>
                    </div>
                    <div class="mb-0">
                        <label asp-for="Notes" class="form-label">ملاحظات</label>
                        <textarea asp-for="Notes" class="form-control" rows="3" placeholder="ملاحظات (اختياري)"></textarea>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-light fw-bold"><i class="bi bi-calculator me-2"></i> ملخص التوزيع</div>
                <div class="card-body d-flex flex-column justify-content-center">
                    <div class="d-flex justify-content-between align-items-center py-2 border-bottom">
                        <span class="text-muted">مبلغ الدفعة</span>
                        <span class="fw-bold" id="idSummaryAmount">0.00</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center py-2 border-bottom">
                        <span class="text-muted">الموزَّع على المستحقات</span>
                        <span class="fw-bold" id="idSummaryAllocated">0.00</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center py-2 border-bottom">
                        <span class="text-muted">غير الموزَّع</span>
                        <span class="fw-bold" id="idSummaryRemaining">0.00</span>
                    </div>
                    <div class="text-center mt-3">
                        <span class="badge bg-secondary fs-6" id="idSummaryBadge">لم يدخل</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm mt-3" id="idOpenSection">
        <div class="card-header bg-light fw-bold">
            <i class="bi bi-collection me-2"></i> المستحقات غير المسددة على <span id="idPartyName" class="text-primary"></span> (فواتير / رصيد افتتاحي)
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover align-middle text-center mb-0">
                    <thead class="table-light">
                        <tr>
                            <th style="width:60px">تحديد</th>
                            <th>رقم الفاتورة / البيان</th>
                            <th>التاريخ</th>
                            <th>الإجمالي</th>
                            <th>المدفوع</th>
                            <th>المتبقي</th>
                            <th style="width:160px">مبلغ التوزيع</th>
                            <th style="width:180px"></th>
                        </tr>
                    </thead>
                    <tbody id="idTableBody"></tbody>
                </table>
            </div>

            <div class="text-center text-muted py-3 d-none" id="idLoadingState">
                <div class="spinner-border spinner-border-sm me-2" role="status"></div>
                جارِ تحميل مستحقات العميل...
            </div>

            <div class="text-center text-muted py-4 d-none" id="idEmptyState">
                <i class="bi bi-emoji-smile fs-2 d-block mb-2"></i>
                لا توجد مستحقات غير مسددة لهذا العميل — رصيده مسدد بالكامل حاليًا.
            </div>
        </div>
    </div>

    <div class="mt-3">
        <button type="submit" class="btn btn-primary btn-lg" id="idSubmitBtn" disabled>
            <i class="bi bi-save me-1"></i> حفظ سند القبض
        </button>
        <a asp-action="Index" class="btn btn-outline-secondary btn-lg">رجوع</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/payment-form.js"></script>
    <script>
        initPaymentForm({
            partySelectId: 'idCustomerSelect',
            openSectionId: 'idOpenSection',
            tableBodyId: 'idTableBody',
            emptyStateId: 'idEmptyState',
            loadingStateId: 'idLoadingState',
            partyNameId: 'idPartyName',
            amountInputId: 'idAmount',
            dateInputId: 'idPaymentDate',
            submitBtnId: 'idSubmitBtn',
            summaryAmountId: 'idSummaryAmount',
            summaryAllocatedId: 'idSummaryAllocated',
            summaryRemainingId: 'idSummaryRemaining',
            summaryBadgeId: 'idSummaryBadge',
            loadUrl: '@Url.Action("GetCustomerOpenInvoices", "Payment")',
            queryParam: 'customerId',
            confirmTitle: 'تأكيد سند القبض',
            confirmText: 'سيتم تسجيل الدفعة وإنشاء حركة نقدية بالخزينة وتوزيعها على الفواتير المحددة.',
            confirmButtonText: 'نعم، احفظ السند'
        });
    </script>
}
