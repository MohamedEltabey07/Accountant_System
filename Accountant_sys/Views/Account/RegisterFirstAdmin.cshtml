@model BLL.DTOs.Auth.RegisterAdminDto
@{
    ViewData["Title"] = "إنشاء حساب المسؤول";
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
}

<div class="logo-section">
    <i class="bi bi-shield-lock-fill"></i>
    <h2>إعداد النظام لأول مرة</h2>
    <p>قم بإنشاء حساب المسؤول الرئيسي للبدء باستخدام النظام</p>
</div>

<div asp-validation-summary="All" class="text-danger mb-3"></div>

<form asp-action="RegisterFirstAdmin" asp-controller="Account" method="post">
    <div class="row">
        <div class="col-6 mb-3">
            <label asp-for="FirstName" class="form-label">
                <i class="bi bi-person-fill me-1"></i> الاسم الأول
            </label>
            <input asp-for="FirstName" class="form-control" placeholder="الاسم الأول" autofocus />
            <span asp-validation-for="FirstName" class="text-danger small"></span>
        </div>
        <div class="col-6 mb-3">
            <label asp-for="LastName" class="form-label">
                اسم العائلة
            </label>
            <input asp-for="LastName" class="form-control" placeholder="اسم العائلة" />
            <span asp-validation-for="LastName" class="text-danger small"></span>
        </div>
    </div>

    <div class="mb-3">
        <label asp-for="UserName" class="form-label">
            <i class="bi bi-at me-1"></i> اسم المستخدم
        </label>
        <div class="input-group">
            <span class="input-group-text"><i class="bi bi-person"></i></span>
            <input asp-for="UserName" class="form-control" placeholder="اسم المستخدم (للدخول)" />
        </div>
        <span asp-validation-for="UserName" class="text-danger small"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Email" class="form-label">
            <i class="bi bi-envelope-fill me-1"></i> البريد الإلكتروني
        </label>
        <div class="input-group">
            <span class="input-group-text"><i class="bi bi-envelope"></i></span>
            <input asp-for="Email" class="form-control" type="email" placeholder="البريد الإلكتروني" />
        </div>
        <span asp-validation-for="Email" class="text-danger small"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Password" class="form-label">
            <i class="bi bi-lock-fill me-1"></i> كلمة المرور
        </label>
        <div class="input-group">
            <span class="input-group-text"><i class="bi bi-lock"></i></span>
            <input asp-for="Password" class="form-control" type="password" placeholder="كلمة المرور (6 أحرف على الأقل)" />
        </div>
        <span asp-validation-for="Password" class="text-danger small"></span>
    </div>

    <div class="mb-4">
        <label asp-for="ConfirmPassword" class="form-label">
            <i class="bi bi-lock-fill me-1"></i> تأكيد كلمة المرور
        </label>
        <div class="input-group">
            <span class="input-group-text"><i class="bi bi-shield-check"></i></span>
            <input asp-for="ConfirmPassword" class="form-control" type="password" placeholder="أعد كتابة كلمة المرور" />
        </div>
        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
    </div>

    <button type="submit" class="btn btn-primary w-100">
        <i class="bi bi-person-plus-fill me-1"></i> إنشاء الحساب والبدء
    </button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
