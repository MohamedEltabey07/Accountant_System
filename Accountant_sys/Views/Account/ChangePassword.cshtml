@model BLL.DTOs.Auth.ChangePasswordDto
@{
    ViewData["Title"] = "تغيير كلمة المرور";
}

<div class="container">
    <div class="row justify-content-center mt-4">
        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white text-center">
                    <h4 class="mb-0">
                        <i class="bi bi-key-fill me-2"></i> تغيير كلمة المرور
                    </h4>
                </div>
                <div class="card-body p-4">

                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            <i class="bi bi-check-circle-fill me-2"></i>
                            @TempData["SuccessMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    <div asp-validation-summary="All" class="text-danger mb-3"></div>

                    <form asp-action="ChangePassword" asp-controller="Account" method="post">
                        <div class="mb-3">
                            <label asp-for="OldPassword" class="form-label">
                                <i class="bi bi-lock me-1"></i> كلمة المرور الحالية
                            </label>
                            <input asp-for="OldPassword" class="form-control" type="password"
                                   placeholder="أدخل كلمة المرور الحالية" />
                            <span asp-validation-for="OldPassword" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="NewPassword" class="form-label">
                                <i class="bi bi-lock-fill me-1"></i> كلمة المرور الجديدة
                            </label>
                            <input asp-for="NewPassword" class="form-control" type="password"
                                   placeholder="أدخل كلمة المرور الجديدة" />
                            <span asp-validation-for="NewPassword" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="ConfirmPassword" class="form-label">
                                <i class="bi bi-shield-check me-1"></i> تأكيد كلمة المرور الجديدة
                            </label>
                            <input asp-for="ConfirmPassword" class="form-control" type="password"
                                   placeholder="أعد كتابة كلمة المرور الجديدة" />
                            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary flex-fill">
                                <i class="bi bi-check-lg me-1"></i> حفظ التغييرات
                            </button>
                            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary flex-fill">
                                <i class="bi bi-x-lg me-1"></i> إلغاء
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
